---
import Layout from "../layouts/Layout.astro";

const contactEmail = "tymurbogach@gmail.com";
const updatedAt = "November 3, 2026";
---

<Layout
  title="Privacy Policy"
  description="Privacy policy for the portfolio site operated by Tymur Bogach."
>
  <article class="mx-auto w-full max-w-4xl py-6 laptop:py-12 laptop-scaled:py-12">
    <header class="mb-10 border-b border-[var(--border)] pb-8">
      <p class="font-hud mb-3 text-xs font-bold tracking-[0.35em] text-[var(--foreground-faint)] uppercase">
        Portfolio
      </p>
      <h1 class="mb-4 text-4xl leading-tight font-bold text-[var(--foreground)] mobile:text-5xl">
        Privacy Policy
      </h1>
      <p class="m-0 text-sm text-[var(--foreground-faint)]">
        Last updated: {updatedAt}
      </p>
    </header>

    <div class="space-y-10 text-[0.95rem] leading-7 text-[var(--muted-foreground)] mobile:text-base">
      <section>
        <h2 class="mb-3 text-2xl font-semibold text-[var(--foreground)]">
          Who operates this site
        </h2>
        <p>
          Tymur Bogach operates this portfolio site. For privacy questions or
          data deletion requests, email
          <a
            class="font-medium text-[var(--accent)] underline underline-offset-4"
            href={`mailto:${contactEmail}`}
          >
            {contactEmail}
          </a>
          .
        </p>
      </section>

      <section>
        <h2 class="mb-3 text-2xl font-semibold text-[var(--foreground)]">
          Analytics
        </h2>
        <p>
          This site uses self-hosted Umami analytics to count page views and
          visitors. It does not use advertising cookies or cross-site tracking.
          Aggregated visit counts are shown on the home page. No Google user
          data is collected here.
        </p>
      </section>

      <section>
        <h2 class="mb-3 text-2xl font-semibold text-[var(--foreground)]">
          Preferences stored on your device
        </h2>
        <p>
          The color theme and light/dark mode choice are stored in your
          browser's local storage. They never leave your device.
        </p>
      </section>

      <section>
        <h2 class="mb-3 text-2xl font-semibold text-[var(--foreground)]">
          Contact form
        </h2>
        <p>
          Messages sent through the contact form include your name, email
          address, and message. They are delivered through Web3Forms so your
          message reaches the site operator. Do not include sensitive personal
          data in the form.
        </p>
      </section>

      <section>
        <h2 class="mb-3 text-2xl font-semibold text-[var(--foreground)]">
          Chat
        </h2>
        <p>
          Messages sent to the on-site chat are processed in memory to generate
          a reply and are not stored permanently. Chat history expires
          automatically after a short period.
        </p>
      </section>

      <section>
        <h2 class="mb-3 text-2xl font-semibold text-[var(--foreground)]">
          Other services
        </h2>
        <p>
          JobPilot and LazyTripZ are separate services with their own privacy
          policies on their own domains. This page does not cover them.
        </p>
        <ul class="mt-4 list-disc space-y-2 pl-6">
          <li>
            <a
              class="font-medium text-[var(--accent)] underline underline-offset-4"
              href="https://jobpilot.nastymur.com/privacy"
            >
              JobPilot privacy policy
            </a>
          </li>
          <li>
            <a
              class="font-medium text-[var(--accent)] underline underline-offset-4"
              href="https://jobpilot.nastymur.com/terms"
            >
              JobPilot terms
            </a>
          </li>
        </ul>
        <p class="mt-4">
          A LazyTripZ policy link will be added here once it is published on
          its own domain.
        </p>
      </section>

      <section>
        <h2 class="mb-3 text-2xl font-semibold text-[var(--foreground)]">
          Retention and deletion
        </h2>
        <p>
          Analytics data is kept in aggregate form. Contact messages are kept
          only to handle your request. You can request deletion of any message
          you sent by emailing
          <a
            class="font-medium text-[var(--accent)] underline underline-offset-4"
            href={`mailto:${contactEmail}`}
          >
            {contactEmail}
          </a>
          .
        </p>
      </section>

      <section>
        <h2 class="mb-3 text-2xl font-semibold text-[var(--foreground)]">
          Policy changes
        </h2>
        <p>
          This page will show material changes to this policy. The date at the
          top shows the latest revision.
        </p>
      </section>
    </div>
  </article>
</Layout>
