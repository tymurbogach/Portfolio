        <div class="field-line"></div>
      </div>
    </div>

    <!-- Message + send -->
    <div class="msg-wrap">
      <textarea id="f-message" name="message" rows="5" required
                placeholder="Your message *" class="msg-input"></textarea>
      <button id="submit-btn" type="submit" class="send-btn">
        <span class="send-label">Send</span>
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5"
             stroke-linecap="round" stroke-linejoin="round" class="send-arrow">
          <path d="M4 10h12M12 5l5 5-5 5"/>
        </svg>
      </button>
    </div>
  </form>

  <!-- ── Quick links ─────────────────────────────────────── -->
  <div class="flex flex-wrap gap-2">

    <a href="https://www.linkedin.com/in/tymur-bogach-51939324a/" target="_blank" rel="noopener noreferrer"
       class="flex items-center gap-2 px-4 py-2 text-xs tracking-[0.2em] uppercase font-bold
              border border-[var(--border-color)]
              hover:bg-[var(--hover-bg)] hover:text-[var(--hover-text)]
              transition-all duration-200">
      <svg viewBox="0 0 24 24" width="12" height="12" fill="currentColor" style="color:var(--accent-color);flex-shrink:0">
        <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
