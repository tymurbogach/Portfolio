    <a href="https://drive.google.com/uc?export=download&id=1hXaSMT9TW_HA2exh7ZKNCkrLm2IfQzDe" target="_blank" rel="noopener noreferrer"
       class="flex items-center gap-2 px-4 py-2 text-xs tracking-[0.2em] uppercase font-bold
              border border-[var(--border-color)]
              hover:bg-[var(--hover-bg)] hover:text-[var(--hover-text)]
              transition-all duration-200">
      <svg viewBox="0 0 16 16" width="12" height="12" fill="currentColor" style="color:var(--accent-color);flex-shrink:0">
        <path d="M10.5 8a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0z"/>
        <path d="M0 8s3-5.5 8-5.5S16 8 16 8s-3 5.5-8 5.5S0 8 0 8zm8 3.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7z"/>
