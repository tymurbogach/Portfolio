  </div>

</div>

<style>
  /* Info strip */
  .info-block {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--border-subtle);
    background: var(--surface-raised);
  }
  .info-key {
    font-size: 0.55rem;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    font-weight: 700;
    opacity: 0.4;
  }
  .info-val {
    font-size: clamp(0.75rem, 1.2vw, 0.9rem);
    font-weight: 700;
    color: var(--letter-color);
  }

  /* Form grid: 2 cols on mobile+, 1 col on tiny */
  .form-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
  }
  @media (min-width: 30rem) {
    .form-grid {
      grid-template-columns: 1fr 1fr;
      column-gap: 2rem;
    }
  }

  /* Floating-label field */
  .field {
    position: relative;
    padding-top: 1.4rem;
    padding-bottom: 0.2rem;
    margin-bottom: 1.4rem;
  }
  .field-input {
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--border-subtle);
    padding: 0.4rem 0 0.4rem;
    font-size: clamp(0.85rem, 1.3vw, 1rem);
    font-family: "Poiret One", cursive;
    color: var(--letter-color);
    width: 100%;
    outline: none;
    transition: border-color 0.25s;
  }
  .field-input::placeholder { opacity: 0; }
  .field-input:focus { border-color: var(--letter-color); }
  .field-input:focus + .field-label,
  .field-input:not(:placeholder-shown) + .field-label {
    transform: translateY(0);
    font-size: 0.5rem;
    letter-spacing: 0.35em;
    opacity: 0.45;
  }
  .field-label {
    position: absolute;
    top: 1.4rem;
    left: 0;
    font-size: clamp(0.85rem, 1.3vw, 1rem);
    font-family: "Poiret One", cursive;
    color: var(--letter-color);
    opacity: 0.4;
    transform: translateY(0.35rem);
    transition: all 0.2s ease;
    pointer-events: none;
    text-transform: uppercase;
    letter-spacing: 0.15em;
  }
  .field-line {
    position: absolute;
    bottom: 0.2rem;
    left: 0;
    height: 1px;
    width: 0;
    background: var(--accent-color);
    transition: width 0.3s ease;
  }
  .field:focus-within .field-line { width: 100%; }

  /* Message */
  .msg-wrap {
    position: relative;
    margin-bottom: 0.5rem;
  }
  .msg-input {
    background: transparent;
    border: 1px solid var(--border-subtle);
    padding: 1rem;
    padding-bottom: 3rem;
    font-size: clamp(0.85rem, 1.3vw, 1rem);
    font-family: "Poiret One", cursive;
    color: var(--letter-color);
    width: 100%;
    resize: none;
    outline: none;
    transition: border-color 0.25s;
  }
  .msg-input::placeholder {
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    opacity: 0.35;
    font-family: "Poiret One", cursive;
  }
  .msg-input:focus { border-color: var(--accent-color); }

  /* Send button */
  .send-btn {
    position: absolute;
    bottom: 0.8rem;
    right: 0.8rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 1rem;
    background: var(--letter-color);
    color: var(--page-background);
    border: none;
    cursor: pointer;
    transition: opacity 0.2s, transform 0.2s;
  }
  .send-btn:hover { opacity: 0.85; transform: translateX(2px); }
  .send-btn:disabled { opacity: 0.3; cursor: default; transform: none; }
  .send-label {
    font-family: "Poiret One", cursive;
    font-size: 0.6rem;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    font-weight: 700;
  }
  .send-arrow { width: 1rem; height: 1rem; }

  /* Status */
  #form-status {
    padding: 0.75rem 1rem;
    margin-bottom: 1rem;
    border: 1px solid var(--border-subtle);
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    text-align: center;
    color: var(--letter-color);
  }
  #form-status.hidden { display: none; }
</style>

<script>
  function initContactForm() {
    const form = document.getElementById("contact-form") as HTMLFormElement | null;
    const statusEl = document.getElementById("form-status") as HTMLElement | null;
    const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement | null;
    if (!form || !statusEl || !submitBtn) return;

    const ac = new AbortController();
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      submitBtn.disabled = true;
      statusEl.classList.remove("hidden");
      statusEl.textContent = "Sending...";
      try {
        const data = new FormData(form);
        const res = await fetch("https://api.web3forms.com/submit", { method: "POST", body: data });
        const result = await res.json();
        if (result.success) {
          statusEl.textContent = "Message sent! I'll get back to you soon.";
          form.reset();
        } else throw new Error(result.message || "Error");
      } catch {
        statusEl.textContent = "Something went wrong. Email me at Timurnator@gmail.com";
      } finally {
        submitBtn.disabled = false;
      }
    }, { signal: ac.signal });

    document.addEventListener('astro:before-preparation', () => ac.abort(), { once: true });
  }

  document.addEventListener('astro:page-load', initContactForm);
</script>
