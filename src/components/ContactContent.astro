<section class="flex flex-col w-full gap-8 laptop:gap-10">

  <div class="flex flex-wrap gap-x-10 gap-y-4">
    <div class="flex flex-col gap-1">
      <p class="text-[0.6rem] tracking-[0.3em] uppercase opacity-40">Email</p>
      <p class="text-sm mobile:text-base laptop:text-lg fhd:text-xl">Timurnator_@outlook.com</p>
    </div>
    <div class="flex flex-col gap-1">
      <p class="text-[0.6rem] tracking-[0.3em] uppercase opacity-40">Location</p>
      <p class="text-sm mobile:text-base laptop:text-lg fhd:text-xl">Orihuela, Alicante</p>
    </div>
    <div class="flex flex-col gap-1">
      <p class="text-[0.6rem] tracking-[0.3em] uppercase opacity-40">Status</p>
      <p class="text-sm mobile:text-base laptop:text-lg fhd:text-xl">Available for freelance</p>
    </div>
  </div>

  <form id="contact-form" class="w-full flex flex-col gap-5">
    <input type="hidden" name="access_key" value="6f16785c-509f-43aa-bd91-8c38b7d49f94" />
    <input type="hidden" name="subject" value="New message from nastymur.com" />

    <div id="form-status" class="hidden p-3 rounded text-center text-sm font-semibold"></div>

    <div class="grid grid-cols-1 mobile:grid-cols-2 gap-5">
      <div class="flex flex-col gap-1">
        <label class="text-[0.6rem] tracking-[0.3em] uppercase opacity-40">Name *</label>
        <input type="text" name="name" required placeholder="Your name"
          class="border-b border-[var(--border-color)] bg-transparent py-2 text-sm mobile:text-base laptop:text-lg fhd:text-xl text-[var(--letter-color)] focus:outline-none transition-all placeholder:opacity-30" />
      </div>
      <div class="flex flex-col gap-1">
        <label class="text-[0.6rem] tracking-[0.3em] uppercase opacity-40">Email *</label>
        <input type="email" name="email" required placeholder="your@email.com"
          class="border-b border-[var(--border-color)] bg-transparent py-2 text-sm mobile:text-base laptop:text-lg fhd:text-xl text-[var(--letter-color)] focus:outline-none transition-all placeholder:opacity-30" />
      </div>
    </div>

    <div class="grid grid-cols-1 mobile:grid-cols-2 gap-5">
      <div class="flex flex-col gap-1">
        <label class="text-[0.6rem] tracking-[0.3em] uppercase opacity-40">Project</label>
        <input type="text" name="project" placeholder="What's it about?"
          class="border-b border-[var(--border-color)] bg-transparent py-2 text-sm mobile:text-base laptop:text-lg fhd:text-xl text-[var(--letter-color)] focus:outline-none transition-all placeholder:opacity-30" />
      </div>
      <div class="flex flex-col gap-1">
        <label class="text-[0.6rem] tracking-[0.3em] uppercase opacity-40">Budget</label>
        <input type="text" name="budget" placeholder="Approx. budget"
          class="border-b border-[var(--border-color)] bg-transparent py-2 text-sm mobile:text-base laptop:text-lg fhd:text-xl text-[var(--letter-color)] focus:outline-none transition-all placeholder:opacity-30" />
      </div>
    </div>

    <div class="flex flex-col gap-1">
      <label class="text-[0.6rem] tracking-[0.3em] uppercase opacity-40">Message *</label>
      <div class="relative">
        <textarea name="message" rows="4" required placeholder="Tell me more..."
          class="border border-[var(--border-color)] bg-transparent rounded w-full py-3 px-4 text-sm mobile:text-base laptop:text-lg fhd:text-xl text-[var(--letter-color)] focus:outline-none transition-all resize-none placeholder:opacity-30"></textarea>
        <button id="submit-btn" type="submit" aria-label="Send"
          class="absolute bottom-3 right-3 opacity-60 hover:opacity-100 transition-opacity cursor-pointer">
          <img src="/img/send-mail.png" alt="Send" class="w-5 h-5 laptop:w-6 laptop:h-6 fhd:w-8 fhd:h-8" />
        </button>
      </div>
    </div>
  </form>

</section>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement;
  const statusEl = document.getElementById("form-status") as HTMLElement;
  const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    submitBtn.disabled = true;
    submitBtn.style.opacity = "0.3";
    statusEl.classList.remove("hidden");
    statusEl.textContent = "Sending...";
    try {
      const data = new FormData(form);
      const response = await fetch("https://api.web3forms.com/submit", { method: "POST", body: data });
      const result = await response.json();
      if (result.success) {
        statusEl.style.color = "green";
        statusEl.textContent = "Message sent! I'll get back to you soon.";
        form.reset();
      } else {
        throw new Error(result.message || "Error");
      }
    } catch {
      statusEl.style.color = "red";
      statusEl.textContent = "Something went wrong. Email me directly.";
    } finally {
      submitBtn.disabled = false;
      statusEl.style.opacity = "1";
    }
  });
</script>
