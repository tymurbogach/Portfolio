<!-- El DualMain ya añade el pageLabel y el max-w centrado -->
<div class="w-full flex flex-col gap-8 laptop:gap-10">

  <!-- ── Bloque de información — 3 columnas ───────────────── -->
  <div class="grid grid-cols-3 info-grid">
    <div class="info-col">
      <p class="info-heading">Email</p>
      <p class="info-value">Timurnator_@outlook.com</p>
    </div>
    <div class="info-col info-col--center">
      <p class="info-heading">Location</p>
      <p class="info-value">Orihuela, Alicante</p>
    </div>
    <div class="info-col info-col--right">
      <p class="info-heading">Status</p>
      <p class="info-value">Available for freelance</p>
    </div>
  </div>

  <!-- ── Formulario — cuestionario numerado ────────────────── -->
  <form id="contact-form" class="flex flex-col gap-0">
    <input type="hidden" name="access_key" value="6f16785c-509f-43aa-bd91-8c38b7d49f94" />
    <input type="hidden" name="subject" value="New message from nastymur.com" />

    <div id="form-status" class="hidden mb-6 p-3 text-sm font-semibold status-box"></div>

    <div class="q-field">
      <label class="q-label" for="f-name"><span class="q-num">01</span> Name <span class="q-req">*</span></label>
      <input id="f-name" type="text" name="name" required autocomplete="name" class="q-input" />
    </div>

    <div class="q-field">
      <label class="q-label" for="f-email"><span class="q-num">02</span> Email <span class="q-req">*</span></label>
      <input id="f-email" type="email" name="email" required autocomplete="email" class="q-input" />
    </div>

    <div class="q-field">
      <label class="q-label" for="f-project"><span class="q-num">03</span> Project</label>
      <input id="f-project" type="text" name="project" class="q-input" />
    </div>

    <div class="q-field">
      <label class="q-label" for="f-budget"><span class="q-num">04</span> Budget</label>
      <input id="f-budget" type="text" name="budget" class="q-input" />
    </div>

    <div class="q-field q-field--last">
      <label class="q-label" for="f-message"><span class="q-num">05</span> Message <span class="q-req">*</span></label>
      <div class="q-textarea-wrap">
        <textarea id="f-message" name="message" rows="4" required class="q-textarea"></textarea>
        <button id="submit-btn" type="submit" aria-label="Enviar mensaje" class="q-send-btn">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"
               class="q-send-icon" aria-hidden="true">
            <rect x="2" y="4" width="20" height="16" rx="2"/>
            <polyline points="2,4 12,13 22,4"/>
          </svg>
        </button>
      </div>
    </div>
  </form>

</div>

<style>
  /* ── Info block ───────────────────────────────── */
  .info-col {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 0.25rem 0 1rem 0;
    align-items: flex-start;
  }
  .info-col--center { align-items: center; text-align: center; }
  .info-col--right  { align-items: flex-end; text-align: right; }
  .info-heading {
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: var(--letter-color);
    opacity: 0.5;
  }
  .info-value {
    font-size: clamp(0.8rem, 1.4vw, 1.05rem);
    font-weight: 600;
    color: var(--letter-color);
    line-height: 1.3;
  }

  /* ── Questionnaire fields ─────────────────────── */
  .q-field {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding-top: 1.15rem;
    padding-bottom: 1.15rem;
    border-bottom: 1px solid var(--border-subtle);
    position: relative;
  }
  .q-field--last {
    border-bottom: none;
  }

  .q-label {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--letter-color);
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }
  .q-num {
    font-size: 0.6rem;
    opacity: 0.35;
    letter-spacing: 0.1em;
    font-weight: 400;
  }
  .q-req {
    opacity: 0.4;
    font-weight: 400;
  }

  /* Input line — limpio, sin borde inferior propio;
     el separador lo da .q-field border-bottom */
  .q-input {
    background: transparent;
    border: none;
    padding: 0.3rem 0;
    font-size: clamp(0.9rem, 1.5vw, 1.1rem);
    font-family: "Poiret One", cursive;
    color: var(--letter-color);
    width: 100%;
    outline: none;
    transition: opacity 0.2s ease;
  }
  .q-input::placeholder { color: transparent; }
  .q-input:focus { opacity: 1; }

  /* Línea de focus animada — crece desde la izquierda */
  .q-field::after {
    content: "";
    position: absolute;
    bottom: -1px;
    left: 0;
    height: 1px;
    width: 0;
    background: var(--letter-color);
    transition: width 0.3s ease;
  }
  .q-field:focus-within::after { width: 100%; }

  /* Textarea */
  .q-textarea-wrap { position: relative; }
  .q-textarea {
    background: transparent;
    border: 1px solid var(--border-subtle);
    padding: 0.85rem 1rem;
    padding-bottom: 2.8rem;
    font-size: clamp(0.9rem, 1.5vw, 1.1rem);
    font-family: "Poiret One", cursive;
    color: var(--letter-color);
    width: 100%;
    resize: none;
    outline: none;
    transition: border-color 0.25s ease;
    margin-top: 0.25rem;
  }
  .q-textarea::placeholder { color: transparent; }
  .q-textarea:focus {
    border-color: color-mix(in srgb, var(--border-color) 55%, transparent);
  }

  /* Send button */
  .q-send-btn {
    position: absolute;
    bottom: 0.7rem;
    right: 0.7rem;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.3rem;
    color: var(--letter-color);
    opacity: 0.35;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }
  .q-send-btn:hover   { opacity: 0.9; transform: translateY(-2px); }
  .q-send-btn:disabled { opacity: 0.15; cursor: default; transform: none; }
  .q-send-icon { width: 1.3rem; height: 1.3rem; }

  /* Status */
  .status-box {
    border: 1px solid var(--border-subtle);
    color: var(--letter-color);
    text-align: center;
  }

  /* Responsive collapse info-grid en móvil */
  @media (max-width: 480px) {
    .info-grid { grid-template-columns: 1fr; }
    .info-col--center,
    .info-col--right {
      align-items: flex-start;
      text-align: left;
      border-top: 1px solid var(--border-subtle);
    }
  }
</style>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement;
  const statusEl = document.getElementById("form-status") as HTMLElement;
  const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    submitBtn.disabled = true;
    statusEl.classList.remove("hidden");
    statusEl.textContent = "Sending...";
    try {
      const data = new FormData(form);
      const response = await fetch("https://api.web3forms.com/submit", { method: "POST", body: data });
      const result = await response.json();
      if (result.success) {
        statusEl.textContent = "Message sent! I'll get back to you soon.";
        form.reset();
      } else {
        throw new Error(result.message || "Error");
      }
    } catch {
      statusEl.textContent = "Something went wrong. Email me directly at Timurnator_@outlook.com";
    } finally {
      submitBtn.disabled = false;
    }
  });
</script>
