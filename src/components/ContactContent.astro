<div class="w-full flex flex-col gap-8 fhd:gap-10">

  <!-- ── Info strip ──────────────────────────────────────── -->
  <div class="grid grid-cols-1 mobile:grid-cols-3 gap-2">
    <div class="info-block">
      <span class="info-key">Email</span>
      <a href="mailto:Timurnator@gmail.com" class="info-val hover:opacity-70 transition-opacity"
         style="color: var(--accent-color)">Timurnator@gmail.com</a>
    </div>
    <div class="info-block">
      <span class="info-key">Location</span>
      <span class="info-val">Orihuela, Alicante</span>
    </div>
    <div class="info-block">
      <span class="info-key">Status</span>
      <span class="info-val" style="display:flex; align-items:center; gap:0.4rem;">
        <span style="width:6px;height:6px;border-radius:50%;background:var(--accent-color);flex-shrink:0;"></span>
        Available
      </span>
    </div>
  </div>

  <!-- ── Form ────────────────────────────────────────────── -->
  <form id="contact-form" autocomplete="off">
    <input type="hidden" name="access_key" value="6f16785c-509f-43aa-bd91-8c38b7d49f94" />
    <input type="hidden" name="subject" value="New message from nastymur.com" />

    <div id="form-status" class="hidden"></div>

    <div class="form-grid">
      <div class="field">
        <input id="f-name" type="text" name="name" required autocomplete="off"
               placeholder="Name *" class="field-input" />
        <label for="f-name" class="field-label">Name *</label>
        <div class="field-line"></div>
      </div>

      <div class="field">
        <input id="f-email" type="email" name="email" required autocomplete="off"
               placeholder="Email *" class="field-input" />
        <label for="f-email" class="field-label">Email *</label>
        <div class="field-line"></div>
      </div>

      <div class="field">
        <input id="f-project" type="text" name="project" autocomplete="off"
               placeholder="Project" class="field-input" />
        <label for="f-project" class="field-label">Project</label>
        <div class="field-line"></div>
      </div>

      <div class="field">
        <input id="f-budget" type="text" name="budget" autocomplete="off"
               placeholder="Budget" class="field-input" />
        <label for="f-budget" class="field-label">Budget</label>
        <div class="field-line"></div>
      </div>
    </div>

    <!-- Message + send -->
    <div class="msg-wrap">
      <textarea id="f-message" name="message" rows="5" required
                placeholder="Your message *" class="msg-input"></textarea>
      <button id="submit-btn" type="submit" class="send-btn">
        <span class="send-label">Send</span>
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5"
             stroke-linecap="round" stroke-linejoin="round" class="send-arrow">
          <path d="M4 10h12M12 5l5 5-5 5"/>
        </svg>
      </button>
    </div>
  </form>

  <!-- ── Quick links ─────────────────────────────────────── -->
  <div class="flex flex-wrap gap-2">
    {[
      { label: "LinkedIn", href: "https://www.linkedin.com/in/tymur-bogach-51939324a/", icon: "fab fa-linkedin" },
      { label: "GitHub",   href: "https://github.com/TimurTwerKing",                   icon: "fab fa-github"   },
      { label: "CV",       href: "https://drive.google.com/uc?export=download&id=1hXaSMT9TW_HA2exh7ZKNCkrLm2IfQzDe", icon: "fas fa-file-pdf" },
    ].map(({ label, href, icon }) => (
      <a href={href} target="_blank" rel="noopener noreferrer"
         class="flex items-center gap-2 px-4 py-2 text-xs tracking-[0.2em] uppercase font-bold
                border border-[var(--border-color)]
                hover:bg-[var(--hover-bg)] hover:text-[var(--hover-text)]
                transition-all duration-200">
        <i class={`${icon} text-xs`} style="color: var(--accent-color)"></i>
        {label}
      </a>
    ))}
  </div>

</div>

<style>
  /* Info strip */
  .info-block {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--border-subtle);
    background: var(--surface-raised);
  }
  .info-key {
    font-size: 0.55rem;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    font-weight: 700;
    opacity: 0.4;
  }
  .info-val {
    font-size: clamp(0.75rem, 1.2vw, 0.9rem);
    font-weight: 700;
    color: var(--letter-color);
  }

  /* Form grid: 2 cols on mobile+, 1 col on tiny */
  .form-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
  }
  @media (min-width: 30rem) {
    .form-grid {
      grid-template-columns: 1fr 1fr;
      column-gap: 2rem;
    }
  }

  /* Floating-label field */
  .field {
    position: relative;
    padding-top: 1.4rem;
    padding-bottom: 0.2rem;
    margin-bottom: 1.4rem;
  }
  .field-input {
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--border-subtle);
    padding: 0.4rem 0 0.4rem;
    font-size: clamp(0.85rem, 1.3vw, 1rem);
    font-family: "Poiret One", cursive;
    color: var(--letter-color);
    width: 100%;
    outline: none;
    transition: border-color 0.25s;
  }
  .field-input::placeholder { opacity: 0; }
  .field-input:focus { border-color: var(--letter-color); }
  .field-input:focus + .field-label,
  .field-input:not(:placeholder-shown) + .field-label {
    transform: translateY(0);
    font-size: 0.5rem;
    letter-spacing: 0.35em;
    opacity: 0.45;
  }
  .field-label {
    position: absolute;
    top: 1.4rem;
    left: 0;
    font-size: clamp(0.85rem, 1.3vw, 1rem);
    font-family: "Poiret One", cursive;
    color: var(--letter-color);
    opacity: 0.4;
    transform: translateY(0.35rem);
    transition: all 0.2s ease;
    pointer-events: none;
    text-transform: uppercase;
    letter-spacing: 0.15em;
  }
  .field-line {
    position: absolute;
    bottom: 0.2rem;
    left: 0;
    height: 1px;
    width: 0;
    background: var(--accent-color);
    transition: width 0.3s ease;
  }
  .field:focus-within .field-line { width: 100%; }

  /* Message */
  .msg-wrap {
    position: relative;
    margin-bottom: 0.5rem;
  }
  .msg-input {
    background: transparent;
    border: 1px solid var(--border-subtle);
    padding: 1rem;
    padding-bottom: 3rem;
    font-size: clamp(0.85rem, 1.3vw, 1rem);
    font-family: "Poiret One", cursive;
    color: var(--letter-color);
    width: 100%;
    resize: none;
    outline: none;
    transition: border-color 0.25s;
  }
  .msg-input::placeholder {
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    opacity: 0.35;
    font-family: "Poiret One", cursive;
  }
  .msg-input:focus { border-color: var(--accent-color); }

  /* Send button */
  .send-btn {
    position: absolute;
    bottom: 0.8rem;
    right: 0.8rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 1rem;
    background: var(--letter-color);
    color: var(--page-background);
    border: none;
    cursor: pointer;
    transition: opacity 0.2s, transform 0.2s;
  }
  .send-btn:hover { opacity: 0.85; transform: translateX(2px); }
  .send-btn:disabled { opacity: 0.3; cursor: default; transform: none; }
  .send-label {
    font-family: "Poiret One", cursive;
    font-size: 0.6rem;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    font-weight: 700;
  }
  .send-arrow { width: 1rem; height: 1rem; }

  /* Status */
  #form-status {
    padding: 0.75rem 1rem;
    margin-bottom: 1rem;
    border: 1px solid var(--border-subtle);
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    text-align: center;
    color: var(--letter-color);
  }
  #form-status.hidden { display: none; }
</style>

<script>
  function initContactForm() {
    const form = document.getElementById("contact-form") as HTMLFormElement | null;
    const statusEl = document.getElementById("form-status") as HTMLElement | null;
    const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement | null;
    if (!form || !statusEl || !submitBtn) return;

    const ac = new AbortController();
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      submitBtn.disabled = true;
      statusEl.classList.remove("hidden");
      statusEl.textContent = "Sending...";
      try {
        const data = new FormData(form);
        const res = await fetch("https://api.web3forms.com/submit", { method: "POST", body: data });
        const result = await res.json();
        if (result.success) {
          statusEl.textContent = "Message sent! I'll get back to you soon.";
          form.reset();
        } else throw new Error(result.message || "Error");
      } catch {
        statusEl.textContent = "Something went wrong. Email me at Timurnator@gmail.com";
      } finally {
        submitBtn.disabled = false;
      }
    }, { signal: ac.signal });

    document.addEventListener('astro:before-preparation', () => ac.abort(), { once: true });
  }

  document.addEventListener('astro:page-load', initContactForm);
</script>
