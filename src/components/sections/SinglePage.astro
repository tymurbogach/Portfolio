---
import HomeContent from "./HomeContent.astro";
import AboutContent from "./AboutContent.astro";
import ResumeContent from "./ResumeContent.astro";
import ProjectsContent from "./ProjectsContent.astro";
import ContactContent from "./ContactContent.astro";

// ==========================================
// 2. IMPORTACIONES DE DATOS
// ==========================================
import {
  getSite,
  getHomeData,
  getAboutData,
  getResumeData,
  getProjects,
  getContactData,
  getSocialLinks,
} from "../../lib/content";

// ==========================================
// 3. RESOLUCIÓN DE PROMESAS (Data Fetching)
// ==========================================
const site = await getSite();
const homeData = await getHomeData();
const aboutData = await getAboutData();
const resumeData = await getResumeData();
const projects = await getProjects();
const contactData = await getContactData();
const socialLinks = await getSocialLinks();

// ==========================================
// 4. LÓGICA DE SECCIONES (El arreglo del Scroll)
// ==========================================
// Filtramos explícitamente "home" del array dinámico.
// De esta forma evitamos generar dos etiquetas con id="home",
// lo cual es un error grave de HTML que rompe el autoscroll.
const labeledSections = site.pages.filter(
  (page) => page.path.replace(/^\//, "") !== "home",
);
---

<div class="flex flex-col w-full">
  <section id="home" class="flex items-center justify-center" aria-label="Home">
    <div class="w-full">
      <HomeContent home={homeData} />
    </div>
  </section>

  {
    labeledSections.map((page) => {
      const sectionId = page.path.replace(/^\//, "");

      return (
        <section
          id={sectionId}
          class="pt-[4rem] laptop:pt-[2rem] border-t border-[var(--border-subtle)]"
          aria-labelledby={`heading-${sectionId}`}
        >
          {/* --- Encabezado de la sección --- */}
          <div class="mb-4 laptop:mb-7">
            {/* Nota de mejora: Cambiado <p> a <h2> para correcta semántica y accesibilidad usando aria-labelledby */}
            <h2
              id={`heading-${sectionId}`}
              class="text-xs laptop:text-base fhd:text-lg
                     tracking-[0.45em] uppercase font-bold
                     text-[var(--letter-color)] text-glow"
            >
              {page.sectionLabel}
            </h2>
            <div class="text-gradient text-glow gradient-line mt-3 laptop:mt-4" />
          </div>

          {/* --- Contenido de la sección --- */}
          <div class="pb-[3rem] laptop:pb-[4rem]">
            {sectionId === "about" && <AboutContent about={aboutData} />}
            {sectionId === "resume" && <ResumeContent resume={resumeData} />}
            {sectionId === "projects" && (
              <ProjectsContent projects={projects} />
            )}
            {sectionId === "contact" && (
              <ContactContent contact={contactData} socialLinks={socialLinks} />
            )}
          </div>
        </section>
      );
    })
  }
</div>
