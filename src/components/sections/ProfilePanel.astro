---
import Modal from "../../components/ui/Modal.astro";
import { getProfile, getHomeData, getContactData } from "../../lib/content";

const profile = await getProfile();
const home    = await getHomeData();
const contact = await getContactData();

const { nameDisplay, role, bio }           = profile;
const { stats }                            = home;
const { cv_url, statusStr, statusActive }  = contact;
---

<section class="flex flex-col justify-between w-full h-full min-h-0 gap-4">

  <div class="flex flex-col flex-1 min-h-0 items-center justify-center gap-4 laptop:gap-3 fhd:gap-5">

    <!-- Name + role -->
    <div class="text-center">
      <p class="font-display text-base laptop:text-lg hidpi:text-lg fhd:text-2xl qhd:text-3xl tracking-[0.1em] m-0 leading-tight">
        {nameDisplay}
      </p>
      <p class="text-[0.45rem] fhd:text-[0.55rem] qhd:text-[0.65rem] tracking-[0.35em] uppercase m-0 mt-0.5"
         style="color: var(--accent-color); opacity: 0.7;">
        {role}
      </p>
    </div>

    <!-- Photo -->
    <div class="relative">
      <div
        class="absolute pointer-events-none"
        style="inset: -4px; border: 1px solid var(--accent-color); opacity: 0.25;"
        aria-hidden="true"
      />
      <img
        src="/img/gopnik.png"
        alt="Timur Bogach"
        class="w-full h-auto object-contain pointer-events-none
               max-w-[6rem] mobile:max-w-[7rem]
               laptop:max-w-[7rem] fhd:max-w-[11rem] qhd:max-w-[15rem]"
      />
    </div>

    <!-- Bio -->
    <p
      class="text-[0.52rem] laptop:text-[0.55rem] fhd:text-xs qhd:text-sm leading-[1.6] m-0 text-center"
      style="opacity: 0.45; max-width: 15rem;"
    >
      {bio}
    </p>

    <!-- Status -->
    <div class="flex items-center gap-2">
      <span
        class="rounded-full shrink-0"
        style={`width: 6px; height: 6px; background: ${statusActive ? "var(--accent-color)" : "var(--border-color)"}; ${statusActive ? "animation: pulse 2s infinite;" : ""}`}
        aria-hidden="true"
      />
      <span class="text-[0.48rem] fhd:text-[0.6rem] qhd:text-xs tracking-[0.2em] uppercase font-bold" style="opacity: 0.5;">
        {statusStr}
      </span>
    </div>

    <!-- Stats (horizontal row) -->
    <div class="flex gap-2 w-full max-w-[16rem] laptop:max-w-[14rem] fhd:max-w-[18rem]">
      {stats.map(({ n, label }: { n: string; label: string }) => (
        <div
          class="flex flex-col items-center flex-1 px-1.5 py-2"
          style="border-left: 2px solid var(--accent-color); background: var(--surface-glow);"
        >
          <span
            class="font-display text-base fhd:text-xl qhd:text-2xl leading-none"
            style="color: var(--accent-color);"
          >
            {n}
          </span>
          <span
            class="text-[0.36rem] fhd:text-[0.42rem] qhd:text-[0.55rem] tracking-[0.12em] uppercase mt-0.5 text-center"
            style="opacity: 0.4;"
          >
            {label}
          </span>
        </div>
      ))}
    </div>

  </div>

  <!-- CV button — always anchored at bottom -->
  <button
    id="cv-view-btn"
    data-cv-url={cv_url}
    class="flex items-center gap-2 px-4 py-2 w-full justify-center
           text-[0.5rem] fhd:text-xs qhd:text-sm tracking-[0.35em] uppercase font-bold
           border border-[var(--border-color)]
           hover:bg-[var(--accent-color)] hover:text-[var(--accent-text)] hover:border-[var(--accent-color)]
           transition-all duration-200 cursor-pointer shrink-0"
  >
    <svg viewBox="0 0 16 16" width="10" height="10" fill="currentColor" style="flex-shrink:0">
      <path d="M10.5 8a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0z" />
      <path d="M0 8s3-5.5 8-5.5S16 8 16 8s-3 5.5-8 5.5S0 8 0 8zm8 3.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7z" />
    </svg>
    <span>View CV</span>
  </button>

</section>

<Modal downloadHref={cv_url} />

<script>
  import "../../scripts/cvModal";
</script>
