---
import { Image } from "astro:assets";
import { getProfile, getHomeData, getContactData } from "../../lib/content";
import Modal from "../../components/ui/Modal.astro";
import CvDownloadButton from "../../components/ui/CvDownloadButton.astro";
import gopnik from "../../assets/gopnik.png";

const profile = await getProfile();
const home    = await getHomeData();
const contact = await getContactData();

const { bio }                                        = profile;
const { stats }                                      = home;
const { cv_url, cv_url_es, statusStr, statusActive } = contact;
---

<section class="flex flex-col w-full h-full min-h-0">

  <div class="flex flex-col items-center gap-4 laptop:gap-4 fhd:gap-6
              pt-[10%] laptop:pt-[15%] laptop-scaled:pt-[15%] fhd:pt-[18%] qhd:pt-[20%]">

    <!-- Photo -->
    <div class="relative neon-glow">
      <div
        class="absolute -inset-1 border border-[var(--primary)] opacity-30 pointer-events-none"
        aria-hidden="true"
      />
      <Image
        src={gopnik}
        alt="Tymur Bogach"
        width={352}
        densities={[1, 2]}
        class="w-full h-auto object-contain pointer-events-none
               max-w-[6rem] mobile:max-w-[7rem]
               laptop:max-w-[9rem] laptop-scaled:max-w-[9rem] fhd:max-w-[12rem] qhd:max-w-[16rem] uhd:max-w-[22rem]"
      />
    </div>

    <!-- Bio -->
    <p
      class="text-[0.62rem] laptop:text-[0.7rem] laptop-scaled:text-[0.7rem] fhd:text-xs qhd:text-sm uhd:text-base
             leading-[1.6] m-0 text-center text-[var(--muted-foreground)] max-w-[15rem]"
    >
      {bio}
    </p>

    <!-- Status -->
    <div class="flex items-center gap-2">
      <span
        class:list={[
          "rounded-full shrink-0 w-[6px] h-[6px]",
          statusActive ? "bg-[var(--accent)] [animation:pulse_2s_infinite]" : "bg-[var(--border)]",
        ]}
        aria-hidden="true"
      />
      <span class="text-[0.48rem] laptop:text-[0.56rem] laptop-scaled:text-[0.56rem] fhd:text-[0.66rem] qhd:text-xs uhd:text-sm tracking-[0.3em] uppercase font-bold opacity-55">
        {statusStr}
      </span>
    </div>

    <!-- Stats (horizontal row) -->
    <div class="flex gap-2 w-full max-w-[16rem] laptop:max-w-[14rem] fhd:max-w-[18rem] uhd:max-w-[28rem]">
      {stats.map(({ n, label }, i) => {
      const sc = (["var(--accent)", "var(--chart-5)", "var(--primary)", "var(--chart-2)"] as const)[i % 4];
      return (
        <div
          class="flex flex-col items-center flex-1 px-1.5 py-2 bg-[var(--surface-glow)] border-l-2"
          style={`border-left-color: ${sc};`}
        >
          <span
            class="font-display text-base laptop:text-xl laptop-scaled:text-xl fhd:text-2xl qhd:text-3xl uhd:text-4xl leading-none"
            style={`color: ${sc};`}
          >
            {n}
          </span>
          <span
            class="text-[0.42rem] laptop:text-[0.5rem] laptop-scaled:text-[0.5rem] fhd:text-[0.58rem] qhd:text-[0.68rem] uhd:text-xs
                   tracking-[0.2em] uppercase mt-0.5 text-center opacity-40"
          >
            {label}
          </span>
        </div>
      ); })}
    </div>

  </div>

  <!-- CV buttons — anchored at bottom -->
  <div class="mt-auto flex w-full shrink-0">
    <CvDownloadButton mode="modal" label="CV · EN" href={cv_url} />
    <CvDownloadButton mode="modal" label="CV · ES" href={cv_url_es} class="border-l-0" />
  </div>

</section>

<Modal titleLabel="CURRICULUM.PDF" />
