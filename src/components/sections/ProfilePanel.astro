---
import { Image } from "astro:assets";
import { getProfile, getContactData } from "../../lib/content";
import gopnik from "../../assets/gopnik.png";

const profile = await getProfile();
const contact = await getContactData();

const { focus, timezone } = profile;
const { statusStr, statusActive, location } = contact;

/* Operator card rows: label + value, rendered as a <dl> spec sheet.
   TIME gets its value injected live by localTime.ts. */
const specRows = [
  { label: "location", value: location },
  { label: "time", value: "" },
  { label: "status", value: statusStr },
  { label: "focus", value: focus },
];

/* Corner-bracket positions for the photo frame (signature element). */
const corners = [
  "top-0 left-0 border-t-2 border-l-2",
  "top-0 right-0 border-t-2 border-r-2",
  "bottom-0 left-0 border-b-2 border-l-2",
  "bottom-0 right-0 border-b-2 border-r-2",
];
---

<script>
  import "../../scripts/localTime";
</script>

<section class="flex flex-col w-full h-full min-h-0">
  <div class="flex flex-1 flex-col items-center justify-center gap-6">
    <!-- Photo with corner brackets -->
    <div class="relative p-[clamp(0.375rem,0.5vw,0.5rem)]">
      {corners.map((pos) => (
        <span
          class:list={[
            "absolute size-[clamp(0.75rem,0.8vw,1rem)] border-[var(--accent)] opacity-60 pointer-events-none",
            pos,
          ]}
          aria-hidden="true"
        />
      ))}
      <Image
        src={gopnik}
        alt="Tymur Bogach"
        width={448}
        densities={[1, 2]}
        class="w-full h-auto object-contain pointer-events-none
               max-w-[10rem] mobile:max-w-[11rem]
               laptop:max-w-[min(100%,22rem)] laptop-scaled:max-w-[12rem]"
      />
    </div>

    <!-- Operator spec sheet -->
    <div class="w-full max-w-[min(100%,22rem)] laptop:max-w-[min(100%,22rem)]">
      <p
        class="font-hud text-[0.65rem] laptop:text-[var(--type-meta)]
                tracking-[0.24em] uppercase font-bold m-0 mb-2 text-[var(--foreground-faint)]"
      >
        // operator
      </p>

      <dl class="m-0 border-y border-[var(--border-subtle)]">
        {specRows.map(({ label, value }) => (
          <div
            class="flex items-baseline gap-3 py-[clamp(0.375rem,0.5vw,0.5rem)]
                      border-b border-[var(--border-subtle)] last:border-b-0"
          >
            <dt
              class="w-[clamp(4.2rem,5vw,5rem)] shrink-0 font-hud
                       text-[0.65rem] laptop:text-[var(--type-meta)]
                       tracking-[0.18em] uppercase text-[var(--foreground-faint)]"
            >
              {label}
            </dt>
            <dd
              class="m-0 min-w-0 font-hud
                       text-[0.7rem] laptop:text-[var(--type-reading)]
                       leading-[1.5]"
            >
              {label === "time" ? (
                <span
                  id="local-time"
                  data-tz={timezone}
                  class="text-[var(--accent)]"
                />
              ) : label === "status" ? (
                <span class="flex items-center gap-1.5">
                  <span
                    class:list={[
                      "rounded-full shrink-0 w-[6px] h-[6px]",
                      statusActive
                        ? "bg-[var(--accent)] [animation:pulse_2s_infinite]"
                        : "bg-[var(--border)]",
                    ]}
                    aria-hidden="true"
                  />
                  <span class="uppercase tracking-[0.12em] font-bold">
                    {value}
                  </span>
                </span>
              ) : (
                value
              )}
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>
