---
import Button   from "../../components/ui/Button.astro";
import type { HeroData } from "../../lib/content";

interface Props {
  hero: HeroData;
}

const { hero: { title1, title2, subtitle1, subtitle2, cta } } = Astro.props;

const MARQUEE = "HTML5 · CSS · JavaScript · TypeScript · Tailwind · Angular · Astro · PHP · Laravel · Java · MySQL · MariaDB · Docker · Linux · Nginx · Git · Raspberry Pi · TrueNAS · Tailscale · Cloudflare · Ollama · Jellyfin · Immich · Sonarr · Radarr · Portainer · Pi-hole · Homarr · SearXNG · Watchtower · Windows · ";
---

<!--
  Layout desktop: título + cita + CTAs en un bloque compacto arriba.
  Spacer flex-1 empuja el marquee al fondo. Sin espacio estúpido entre título y botones.
  Móvil: flex-col normal apilado.
-->
<div class="flex flex-col w-full gap-5 relative
            flex-1 laptop:gap-0 laptop-scaled:gap-0">

  <!-- Decoración: cuadrícula de puntos -->
  <div
    class="absolute -inset-16 -z-10 pointer-events-none"
    style="background-image: radial-gradient(circle, var(--border-color) 1px, transparent 1px);
           background-size: 28px 28px; opacity: 0.10;"
    aria-hidden="true"
  />

  <!-- Decoración: slash diagonal de acento -->
  <div
    class="absolute -z-10 pointer-events-none opacity-[0.03]"
    style="right: -6rem; top: -10rem; width: 40rem; height: 40rem;
           border: 3px solid var(--accent-color); transform: rotate(15deg);"
    aria-hidden="true"
  />

  <!-- Espacio superior — solo desktop, escala con la pantalla -->
  <div
    class="hidden laptop:block laptop:shrink-0
           laptop:h-10 fhd:h-12 qhd:h-16 uhd:h-20"
    aria-hidden="true"
  />

  <!-- BLOQUE PRINCIPAL: título arriba, cita+CTAs centrados en espacio restante -->
  <div class="flex flex-col flex-1 min-h-0 gap-8
              laptop:flex-none laptop:shrink-0 laptop:gap-4">

    <!-- Título — triple clic activa cambio de tema
         Móvil: "Software" izquierda / "Solutions" derecha (stagger diagonal)
         Desktop: ambas izquierda, leading compacto -->
    <div id="theme-toggle">
      <h1
        class="font-display m-0 w-full leading-[1.0] laptop:leading-[0.88]"
        style="font-size: clamp(3.5rem, 9vw, 18rem); letter-spacing: -0.01em;"
      >
        <span class="block text-left">{title1}</span>
        <span class="block text-right" style="opacity: 0.28;">{title2}</span>
      </h1>
    </div>

    <!-- Cita + CTAs: flex-1 para ocupar espacio restante, justify-center los centra -->
    <div class="flex-1 flex flex-col justify-center gap-10
                laptop:flex-none laptop:justify-start">

      <!-- Cita — centrada en móvil para contrastar con el stagger del título -->
      <div class="flex flex-col gap-1.5 text-center ">
        <p
          class="italic leading-[1.7] text-sm laptop:text-base fhd:text-lg qhd:text-xl uhd:text-2xl m-0"
          style="opacity: 0.65;"
        >
          "{subtitle1}"
        </p>
        <p
          class="text-[0.6rem] laptop:text-[0.68rem] fhd:text-xs qhd:text-sm uhd:text-base not-italic tracking-[0.3em] m-0"
          style="opacity: 0.28;"
        >
          {subtitle2}
        </p>
      </div>

      <!-- CTAs — centrados en móvil -->
      <div class="flex flex-wrap gap-3 items-center justify-center laptop:justify-start">
        <Button variant="primary" href={cta.primaryHref}>{cta.primary}</Button>
        <Button variant="ghost"   href={cta.secondaryHref}>{cta.secondary}</Button>
      </div>

    </div>

  </div>

  <!-- Franja marquee — mt-auto la ancla al fondo siempre -->
  <div class="flex flex-col gap-2 mt-auto laptop:shrink-0 laptop:pb-8 fhd:pb-10 qhd:pb-12">
    <div class="h-px" style="background: var(--border-color);" />
    <div class="overflow-hidden" aria-hidden="true">
      <div
        class="marquee-track"
        style="font-size: clamp(0.55rem, 0.5vw, 1rem); letter-spacing: 0.45em;
               text-transform: uppercase; font-weight: bold;
               opacity: 0.28; font-family: 'JetBrains Mono', monospace;
               color: var(--letter-color);"
      >
        <span>{MARQUEE}</span>
        <span>{MARQUEE}</span>
      </div>
    </div>
    <div class="h-px" style="background: var(--border-color);" />
  </div>

</div>
