---
import Button from "../../components/ui/Button.astro";
import type { HeroData } from "../../lib/content";

interface Props {
  hero: HeroData;
}

const { hero: { title1, title2, subtitle1, subtitle2, comment, cta } } = Astro.props;
---

<div class="flex flex-col w-full gap-5 relative
            flex-1 laptop:gap-0 laptop-scaled:gap-0">

  <!-- Decoración: cuadrícula de puntos -->
  <div
    class="absolute -inset-16 -z-10 pointer-events-none"
    style="background-image: radial-gradient(circle, var(--border-color) 1px, transparent 1px);
           background-size: 28px 28px; opacity: 0.10;"
    aria-hidden="true"
  />

  <!-- Decoración: slash diagonal de acento -->
  <div
    class="absolute -z-10 pointer-events-none opacity-[0.06]"
    style="right: -6rem; top: -10rem; width: 40rem; height: 40rem;
           border: 3px solid var(--accent-color); transform: rotate(15deg);"
    aria-hidden="true"
  />

  <!-- BLOQUE PRINCIPAL -->
  <div class="flex flex-col flex-1 min-h-0 justify-center gap-8
              laptop:flex-none laptop:shrink-0 laptop:justify-center laptop:gap-4
              laptop:my-auto">

    <!-- Título -->
    <h1
      class="font-display m-0 w-full leading-[1.0] laptop:leading-[0.88]"
      style="font-size: clamp(3.5rem, 9vw, 18rem); letter-spacing: -0.01em;"
    >
      <span class="flex items-baseline justify-between w-full">
        <span>{title1}</span>
        <span id="stat-visitors"
              class="opacity-0 transition-opacity duration-500 font-sans font-normal
                     text-[0.45rem] laptop:text-[0.5rem] tracking-[0.25em] uppercase"
              style="color: var(--accent-color);">
        </span>
      </span>
      <span class="block text-right" style="opacity: 0.28;">{title2}</span>
    </h1>

    <!-- Theme toggle button — debajo del título, alineado derecha -->
    <div class="flex justify-end">
      <button
        id="theme-toggle"
        class="inline-flex flex-row items-center gap-2 cursor-pointer
               opacity-40 can-hover:hover:opacity-90 active:opacity-90
               transition-opacity duration-200 select-none bg-transparent border-none p-0"
        title="Click to change theme"
        aria-label="Change theme"
        type="button"
      >
        <span class="text-[0.38rem] laptop:text-[0.42rem] tracking-[0.3em] uppercase font-bold"
              style="color: var(--letter-color);">// theme</span>
        <span
          class="text-[0.48rem] laptop:text-[0.55rem] fhd:text-[0.6rem] tracking-[0.25em] uppercase font-bold
                 px-1.5 py-0.5 border border-[var(--accent-color)]"
          style="color: var(--accent-color);"
          data-theme-label
        >void</span>
      </button>
    </div>

    <!-- Bio + CTAs -->
    <div class="flex flex-col gap-5 laptop:gap-4">
      <p
        class="leading-[1.75] text-sm laptop:text-base fhd:text-lg qhd:text-xl uhd:text-2xl m-0"
        style="opacity: 0.6;"
      >
        {subtitle1}
      </p>

      {cta && (
        <div class="flex flex-wrap gap-3">
          <Button href={cta.primaryHref} variant="primary">
            {cta.primary}
          </Button>
          <Button href={cta.secondaryHref} variant="accent">
            {cta.secondary}
          </Button>
        </div>
      )}
    </div>

    <script>
      import "../../scripts/visitCounter";
    </script>

    <!-- Matrix typewriter -->
    <div
      id="matrix-wrap"
      class="text-center text-[0.55rem] laptop:text-[0.62rem] fhd:text-[0.7rem] qhd:text-xs
             tracking-[0.2em] leading-[1.8] italic"
      style="opacity:0.3; height:5.5em; overflow:hidden;"
      data-quote={subtitle2}
      data-comment={comment}
      aria-label={subtitle2}
    >
      <div>
        <span id="matrix-text"></span><span
          id="matrix-cursor"
          style="display:inline-block; width:1px; height:0.85em; vertical-align:middle;
                 background:var(--accent-color); margin-left:1px;"
        ></span>
      </div>
      <div
        id="matrix-comment"
        class="not-italic font-bold opacity-0 transition-opacity duration-500"
        style="margin-top:0.4em; color:var(--accent-color);"
      ></div>
    </div>

    <script>
      import "../../scripts/typewriter";
    </script>

  </div>


</div>
