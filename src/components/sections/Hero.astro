---
import Button from "../../components/ui/Button.astro";
import type { HeroData } from "../../lib/content";

interface Props {
  hero: HeroData;
}

const { hero: { title1, title2, subtitle1, subtitle2, comment, cta } } = Astro.props;
---

<div class="flex flex-col w-full gap-5 relative
            flex-1 laptop:gap-0 laptop-scaled:gap-0">

  <!-- Decoración: cuadrícula de puntos -->
  <div
    class="absolute -inset-16 -z-10 pointer-events-none"
    style="background-image: radial-gradient(circle, var(--primary) 1px, transparent 1px);
           background-size: 28px 28px; opacity: 0.06;"
    aria-hidden="true"
  />

  <!-- Decoración: slash diagonal de acento -->
  <div
    class="absolute -z-10 pointer-events-none opacity-[0.06]"
    style="right: -6rem; top: -10rem; width: 40rem; height: 40rem;
           border: 3px solid var(--primary); transform: rotate(15deg);"
    aria-hidden="true"
  />

  <!-- BLOQUE PRINCIPAL -->
  <div class="flex flex-col flex-1 min-h-0 justify-center gap-8
              laptop:flex-none laptop:shrink-0 laptop:justify-center laptop:gap-4
              laptop:my-auto">

    <!-- Título -->
    <h1
      class="font-display m-0 w-full leading-[1.0] laptop:leading-[0.88]"
      style="font-size: clamp(3.5rem, 9vw, 18rem); letter-spacing: -0.01em;"
    >
      <span class="flex items-baseline justify-between w-full">
        <span>{title1}</span>
        <span id="stat-visitors"
              class="opacity-0 transition-opacity duration-500 font-sans font-normal
                     text-[0.45rem] laptop:text-[0.5rem] fhd:text-[0.55rem] qhd:text-xs uhd:text-sm
                     tracking-[0.25em] uppercase"
              style="color: var(--accent);">
        </span>
      </span>
      <span class="block text-right" style="opacity: 0.25;">{title2}</span>
    </h1>

    <!-- Theme toggle — dark/light pill -->
    <div class="flex justify-end">
      <button
        id="theme-toggle"
        class="inline-flex items-center gap-1.5 cursor-pointer
               px-2.5 py-1.5 laptop:px-3 fhd:px-3.5
               rounded-full border border-[var(--border)]
               bg-[var(--card)] opacity-50 can-hover:hover:opacity-100 active:opacity-100
               transition-all duration-200 select-none"
        title="Toggle dark/light mode"
        aria-label="Toggle dark/light mode"
        type="button"
      >
        <!-- Sun: visible in dark mode -->
        <svg id="icon-sun"
             xmlns="http://www.w3.org/2000/svg"
             class="w-[0.7rem] h-[0.7rem] laptop:w-[0.8rem] laptop:h-[0.8rem] fhd:w-[0.9rem] fhd:h-[0.9rem]"
             viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
             stroke-linecap="round" stroke-linejoin="round"
             style="color: var(--accent);">
          <circle cx="12" cy="12" r="4"/>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
        </svg>
        <!-- Moon: visible in light mode -->
        <svg id="icon-moon"
             xmlns="http://www.w3.org/2000/svg"
             class="w-[0.7rem] h-[0.7rem] laptop:w-[0.8rem] laptop:h-[0.8rem] fhd:w-[0.9rem] fhd:h-[0.9rem] hidden"
             viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
             stroke-linecap="round" stroke-linejoin="round"
             style="color: var(--primary);">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>
    </div>

    <!-- Bio + CTAs -->
    <div class="flex flex-col gap-5 laptop:gap-4">
      <p
        class="leading-[1.75] text-sm laptop:text-base fhd:text-lg qhd:text-xl uhd:text-2xl m-0"
        style="opacity: 0.55;"
      >
        {subtitle1}
      </p>

      {cta && (
        <div class="flex flex-wrap gap-3">
          <Button href={cta.primaryHref} variant="primary">
            {cta.primary}
          </Button>
          <Button href={cta.secondaryHref} variant="accent">
            {cta.secondary}
          </Button>
        </div>
      )}
    </div>

    <script>
      import "../../scripts/visitCounter";
    </script>

    <!-- Matrix typewriter -->
    <div
      id="matrix-wrap"
      class="text-center text-[0.55rem] laptop:text-[0.62rem] fhd:text-[0.7rem] qhd:text-xs uhd:text-sm
             tracking-[0.2em] leading-[1.8] italic"
      style="opacity:0.25; height:5.5em; overflow:hidden;"
      data-quote={subtitle2}
      data-comment={comment}
      aria-label={subtitle2}
    >
      <div>
        <span id="matrix-text"></span><span
          id="matrix-cursor"
          style="display:inline-block; width:1px; height:0.85em; vertical-align:middle;
                 background:var(--accent); margin-left:1px;"
        ></span>
      </div>
      <div
        id="matrix-comment"
        class="not-italic font-bold opacity-0 transition-opacity duration-500"
        style="margin-top:0.4em; color:var(--accent);"
      ></div>
    </div>

    <script>
      import "../../scripts/typewriter";
    </script>

  </div>


</div>
