---
import Button       from "../../components/ui/Button.astro";
import type { HeroData } from "../../lib/content";

interface Props {
  hero: HeroData;
}

const { hero: { title1, title2, subtitle1, subtitle2, cta } } = Astro.props;

const MARQUEE = "TypeScript · Laravel · Angular · Astro · Docker · Linux · Raspberry Pi · Self-hosting · Ollama · NAS · Nginx · Tailwind · Cloudflare · PHP · Python · SCSS · Git · Claude API · n8n · AI Integration · ";
---

<div class="flex flex-col w-full gap-6 relative
            laptop:absolute laptop:inset-0 laptop:gap-0
            laptop:grid laptop:grid-cols-1 laptop:grid-rows-[1fr_auto]">

  <!-- Background dot grid -->
  <div
    class="absolute -inset-16 -z-10 pointer-events-none"
    style="background-image: radial-gradient(circle, var(--border-color) 1px, transparent 1px);
           background-size: 28px 28px; opacity: 0.10;"
    aria-hidden="true"
  />

  <!-- Accent slash -->
  <div
    class="absolute -z-10 pointer-events-none opacity-[0.03]"
    style="right: -6rem; top: -10rem; width: 40rem; height: 40rem;
           border: 3px solid var(--accent-color);
           transform: rotate(15deg);"
    aria-hidden="true"
  />

  <!-- CENTER: HUGE title — fills grid row 1 (1fr) -->
  <div
    class="flex flex-col justify-center items-center text-center min-w-0"
    id="theme-toggle"
  >
    <h1
      class="font-display m-0 w-full"
      style="font-size: clamp(3.5rem, 10vw, 16rem); line-height: 0.88; letter-spacing: -0.01em;"
    >
      {title1}<br />
      <span style="opacity: 0.28;">{title2}</span>
    </h1>
  </div>

  <!-- BOTTOM: Quote wide + CTAs + Marquee — grid row 2 (auto) -->
  <div class="flex flex-col gap-3 laptop:gap-4 laptop:pb-2 min-w-0">

    <!-- Quote — full width, stretched, no max-width -->
    <div class="flex flex-col gap-1.5">
      <p
        class="italic leading-[1.7] text-sm laptop:text-base fhd:text-lg qhd:text-xl m-0"
        style="opacity: 0.65;"
      >
        "{subtitle1}"
      </p>
      <p
        class="text-[0.6rem] laptop:text-[0.68rem] fhd:text-xs not-italic tracking-[0.3em] m-0"
        style="opacity: 0.28;"
      >
        — {subtitle2}
      </p>
    </div>

    <!-- CTAs -->
    <div class="flex flex-wrap gap-3 items-center">
      <Button variant="primary" href={cta.primaryHref}>{cta.primary}</Button>
      <Button variant="ghost"   href={cta.secondaryHref}>{cta.secondary}</Button>
    </div>

    <!-- Marquee strip -->
    <div class="flex flex-col gap-2">
      <div class="h-px" style="background: var(--border-color);" />
      <div class="overflow-hidden" aria-hidden="true">
        <div
          class="marquee-track"
          style="font-size: clamp(0.55rem, 0.45vw, 0.9rem); letter-spacing: 0.45em;
                 text-transform: uppercase; font-weight: bold;
                 opacity: 0.28; font-family: 'JetBrains Mono', monospace;
                 color: var(--letter-color);"
        >
          <span>{MARQUEE}</span>
          <span>{MARQUEE}</span>
        </div>
      </div>
      <div class="h-px" style="background: var(--border-color);" />
    </div>

  </div>

</div>
