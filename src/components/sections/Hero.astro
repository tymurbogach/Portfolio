---
import Button from "../../components/ui/Button.astro";
import MatrixSequence from "../../components/ui/MatrixSequence";
import TrueFocus from "../../components/ui/TrueFocus";
import type { HeroData } from "../../lib/content";

interface Props {
  hero: HeroData;
}

const { hero: { title1, title2, subtitle1, subtitle2, comment, cta } } = Astro.props;
---

<div class="flex flex-col w-full flex-1 min-h-0 justify-center">

  <!-- Decoración: cuadrícula de puntos -->
  <div
    class="absolute -inset-16 -z-10 pointer-events-none"
    style="background-image: radial-gradient(circle, var(--primary) 1px, transparent 1px);
           background-size: 28px 28px; opacity: 0.06;"
    aria-hidden="true"
  />

  <!-- Decoración: slash diagonal -->
  <div
    class="absolute -z-10 pointer-events-none opacity-[0.06]"
    style="right: -6rem; top: -10rem; width: 40rem; height: 40rem;
           border: 3px solid var(--chart-2); transform: rotate(15deg);"
    aria-hidden="true"
  />

  <!-- Título -->
  <div class="shrink-0 w-full mb-3 laptop:mb-5 fhd:mb-5 qhd:mb-6">
    <TrueFocus
      client:visible
      sentence={`${title1} ${title2}`}
      stacked={true}
      blurAmount={3}
      animationDuration={0.6}
      pauseBetweenAnimations={1.5}
    />
  </div>

  <!-- Bio + CTAs + matrix -->
  <div class="flex flex-col gap-3 laptop:gap-2.5 shrink-0 w-full">

    <p
      class="leading-[1.75] text-sm laptop:text-base fhd:text-lg qhd:text-xl uhd:text-2xl m-0"
      style="opacity: 0.55;"
    >
      {subtitle1}
    </p>

    {cta && (
      <div class="flex flex-wrap gap-3">
        <Button href={cta.primaryHref} variant="primary">
          {cta.primary}
        </Button>
        <Button href={cta.secondaryHref} variant="accent">
          {cta.secondary}
        </Button>
      </div>
    )}

    <div
      class="text-center
             text-[0.55rem] laptop:text-[0.62rem] fhd:text-[0.7rem] qhd:text-xs uhd:text-sm
             tracking-[0.2em] leading-[1.8] italic"
      style="opacity:0.25;"
      aria-label={subtitle2}
    >
      <MatrixSequence
        client:visible
        quote={subtitle2}
        comment={comment}
      />
    </div>

  </div>

  <script>
    import "../../scripts/visitCounter";
  </script>

</div>
