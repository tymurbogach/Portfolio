---
import ProjectCard  from "../../components/ui/ProjectCard.astro";
import type { Project } from "../../lib/content";

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---

<div class="flex flex-col gap-3 w-full">
  {projects.map((entry: Project, i: number) => {
    const { title, description, image, link, tags } = entry.data;
    const isDemo = link?.includes("github.io") || link?.includes("netlify") || link?.includes("vercel");

    return (
      <ProjectCard
        title={title}
        description={description}
        image={image}
        link={link}
        type={isDemo ? "demo" : "source"}
        tags={tags ?? []}
        index={i + 1}
      />
    );
  })}
</div>