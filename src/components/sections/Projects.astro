---
import ProjectCard  from "../../components/ui/ProjectCard.astro";
import type { Project } from "../../lib/content";

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---

<div class="grid grid-cols-1 laptop-scaled:grid-cols-2 laptop:grid-cols-2 fhd:grid-cols-3 qhd:grid-cols-4 uhd:grid-cols-5 gap-4 fhd:gap-5 qhd:gap-6 w-full">
  {projects.map((entry: Project, i: number) => {
    const { title, description, image, link, type, tags, year, role } = entry.data;

    return (
      <ProjectCard
        title={title}
        description={description}
        image={image}
        link={link}
        type={type ?? "source"}
        tags={tags ?? []}
        year={year}
        role={role}
        index={i + 1}
      />
    );
  })}
</div>