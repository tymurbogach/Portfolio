---
import ProjectCard from "../../components/ui/ProjectCard.astro";
import type { Project } from "../../lib/content";

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---

<div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,18rem),1fr))] laptop:grid-cols-3 gap-[clamp(1rem,1.5vw,1.5rem)] w-full">
  {projects.map((entry: Project, i: number) => {
    const {
      title,
      description,
      image,
      link,
      type,
      tags,
      year,
      role,
      githubStars,
    } = entry.data;

    return (
      <ProjectCard
        title={title}
        description={description}
        image={image}
        link={link}
        type={type ?? "source"}
        tags={tags ?? []}
        year={year}
        role={role}
        githubStars={githubStars}
        index={i + 1}
      />
    );
  })}
</div>
