---
import type { ContactData, SocialLink } from '../../lib/content';

interface Props {
  contact: ContactData;
  socialLinks: SocialLink[];
}
const { contact, socialLinks } = Astro.props;
const { email, location, statusStr, statusActive, cv_link, formSubject } = contact;
---

<div class="w-full flex flex-col gap-8 fhd:gap-10">
  <div class="grid grid-cols-1 mobile:grid-cols-3 gap-2">
    <div
      class="flex flex-col gap-[0.3rem] py-3 px-4 border border-[var(--border-subtle)] bg-[var(--surface-raised)]"
    >
      <span
        class="text-[0.55rem] tracking-[0.4em] uppercase font-bold opacity-40"
        >Email</span
      >
      <a
        href={`mailto:${email}`}
        class="text-[clamp(0.75rem,1.2vw,0.9rem)] font-bold text-[var(--accent-color)] hover:opacity-70 transition-opacity"
      >
        {email}
      </a>
    </div>
    <div
      class="flex flex-col gap-[0.3rem] py-3 px-4 border border-[var(--border-subtle)] bg-[var(--surface-raised)]"
    >
      <span
        class="text-[0.55rem] tracking-[0.4em] uppercase font-bold opacity-40"
        >Location</span
      >
      <span
        class="text-[clamp(0.75rem,1.2vw,0.9rem)] font-bold text-[var(--letter-color)]"
        >{location}</span
      >
    </div>
    <div
      class="flex flex-col gap-[0.3rem] py-3 px-4 border border-[var(--border-subtle)] bg-[var(--surface-raised)]"
    >
      <span
        class="text-[0.55rem] tracking-[0.4em] uppercase font-bold opacity-40"
        >Status</span
      >
      <span
        class="flex items-center gap-[0.4rem] text-[clamp(0.75rem,1.2vw,0.9rem)] font-bold text-[var(--letter-color)]"
      >
        <span
          class={`w-[6px] h-[6px] rounded-full shrink-0 ${statusActive ? 'bg-[var(--accent-color)]' : 'bg-gray-500'}`}
        ></span>
        {statusStr}
      </span>
    </div>
  </div>

  <form id="contact-form" autocomplete="off" data-email={email}>
    <input
      type="hidden"
      name="access_key"
      value="6f16785c-509f-43aa-bd91-8c38b7d49f94"
    />
    <input type="hidden" name="subject" value={formSubject} />

    <div
      id="form-status"
      class="hidden py-3 px-4 mb-4 border border-[var(--border-subtle)] text-xs tracking-[0.15em] text-center text-[var(--letter-color)]"
    >
    </div>

    <div
      class="grid grid-cols-1 min-[30rem]:grid-cols-2 gap-y-0 min-[30rem]:gap-x-8"
    >
      <div class="relative pt-[1.4rem] pb-[0.2rem] mb-[1.4rem] group">
        <input
          id="f-name"
          type="text"
          name="name"
          required
          autocomplete="off"
          placeholder="Name *"
          class="bg-transparent border-none border-b border-[var(--border-subtle)] py-[0.4rem] px-0 text-[clamp(0.85rem,1.3vw,1rem)] font-['Poiret_One',cursive] text-[var(--letter-color)] w-full outline-none transition-colors duration-[250ms] placeholder-transparent focus:border-[var(--letter-color)] peer"
        />
        <label
          for="f-name"
          class="absolute top-[1.4rem] left-0 text-[clamp(0.85rem,1.3vw,1rem)] font-['Poiret_One',cursive] text-[var(--letter-color)] opacity-40 translate-y-[0.35rem] transition-all duration-200 pointer-events-none uppercase tracking-[0.15em] peer-focus:translate-y-0 peer-focus:text-[0.5rem] peer-focus:tracking-[0.35em] peer-focus:opacity-45 peer-[:not(:placeholder-shown)]:translate-y-0 peer-[:not(:placeholder-shown)]:text-[0.5rem] peer-[:not(:placeholder-shown)]:tracking-[0.35em] peer-[:not(:placeholder-shown)]:opacity-45"
          >Name *</label
        >
        <div
          class="absolute bottom-[0.2rem] left-0 h-[1px] w-0 bg-[var(--accent-color)] transition-all duration-300 group-focus-within:w-full"
        >
        </div>
      </div>

      <div class="relative pt-[1.4rem] pb-[0.2rem] mb-[1.4rem] group">
        <input
          id="f-email"
          type="email"
          name="email"
          required
          autocomplete="off"
          placeholder="Email *"
          class="bg-transparent border-none border-b border-[var(--border-subtle)] py-[0.4rem] px-0 text-[clamp(0.85rem,1.3vw,1rem)] font-['Poiret_One',cursive] text-[var(--letter-color)] w-full outline-none transition-colors duration-[250ms] placeholder-transparent focus:border-[var(--letter-color)] peer"
        />
        <label
          for="f-email"
          class="absolute top-[1.4rem] left-0 text-[clamp(0.85rem,1.3vw,1rem)] font-['Poiret_One',cursive] text-[var(--letter-color)] opacity-40 translate-y-[0.35rem] transition-all duration-200 pointer-events-none uppercase tracking-[0.15em] peer-focus:translate-y-0 peer-focus:text-[0.5rem] peer-focus:tracking-[0.35em] peer-focus:opacity-45 peer-[:not(:placeholder-shown)]:translate-y-0 peer-[:not(:placeholder-shown)]:text-[0.5rem] peer-[:not(:placeholder-shown)]:tracking-[0.35em] peer-[:not(:placeholder-shown)]:opacity-45"
          >Email *</label
        >
        <div
          class="absolute bottom-[0.2rem] left-0 h-[1px] w-0 bg-[var(--accent-color)] transition-all duration-300 group-focus-within:w-full"
        >
        </div>
      </div>

      <div class="relative pt-[1.4rem] pb-[0.2rem] mb-[1.4rem] group">
        <input
          id="f-project"
          type="text"
          name="project"
          autocomplete="off"
          placeholder="Project"
          class="bg-transparent border-none border-b border-[var(--border-subtle)] py-[0.4rem] px-0 text-[clamp(0.85rem,1.3vw,1rem)] font-['Poiret_One',cursive] text-[var(--letter-color)] w-full outline-none transition-colors duration-[250ms] placeholder-transparent focus:border-[var(--letter-color)] peer"
        />
        <label
          for="f-project"
          class="absolute top-[1.4rem] left-0 text-[clamp(0.85rem,1.3vw,1rem)] font-['Poiret_One',cursive] text-[var(--letter-color)] opacity-40 translate-y-[0.35rem] transition-all duration-200 pointer-events-none uppercase tracking-[0.15em] peer-focus:translate-y-0 peer-focus:text-[0.5rem] peer-focus:tracking-[0.35em] peer-focus:opacity-45 peer-[:not(:placeholder-shown)]:translate-y-0 peer-[:not(:placeholder-shown)]:text-[0.5rem] peer-[:not(:placeholder-shown)]:tracking-[0.35em] peer-[:not(:placeholder-shown)]:opacity-45"
          >Project</label
        >
        <div
          class="absolute bottom-[0.2rem] left-0 h-[1px] w-0 bg-[var(--accent-color)] transition-all duration-300 group-focus-within:w-full"
        >
        </div>
      </div>

      <div class="relative pt-[1.4rem] pb-[0.2rem] mb-[1.4rem] group">
        <input
          id="f-budget"
          type="text"
          name="budget"
          autocomplete="off"
          placeholder="Budget"
          class="bg-transparent border-none border-b border-[var(--border-subtle)] py-[0.4rem] px-0 text-[clamp(0.85rem,1.3vw,1rem)] font-['Poiret_One',cursive] text-[var(--letter-color)] w-full outline-none transition-colors duration-[250ms] placeholder-transparent focus:border-[var(--letter-color)] peer"
        />
        <label
          for="f-budget"
          class="absolute top-[1.4rem] left-0 text-[clamp(0.85rem,1.3vw,1rem)] font-['Poiret_One',cursive] text-[var(--letter-color)] opacity-40 translate-y-[0.35rem] transition-all duration-200 pointer-events-none uppercase tracking-[0.15em] peer-focus:translate-y-0 peer-focus:text-[0.5rem] peer-focus:tracking-[0.35em] peer-focus:opacity-45 peer-[:not(:placeholder-shown)]:translate-y-0 peer-[:not(:placeholder-shown)]:text-[0.5rem] peer-[:not(:placeholder-shown)]:tracking-[0.35em] peer-[:not(:placeholder-shown)]:opacity-45"
          >Budget</label
        >
        <div
          class="absolute bottom-[0.2rem] left-0 h-[1px] w-0 bg-[var(--accent-color)] transition-all duration-300 group-focus-within:w-full"
        >
        </div>
      </div>
    </div>

    <div class="relative mb-2">
      <textarea
        id="f-message"
        name="message"
        rows="5"
        required
        placeholder="Your message *"
        class="bg-transparent border border-[var(--border-subtle)] p-4 pb-12 text-[clamp(0.85rem,1.3vw,1rem)] font-['Poiret_One',cursive] text-[var(--letter-color)] w-full resize-none outline-none transition-colors duration-[250ms] focus:border-[var(--accent-color)] placeholder:text-[0.7rem] placeholder:tracking-[0.2em] placeholder:uppercase placeholder:opacity-35 placeholder:font-['Poiret_One',cursive]"
      ></textarea>

      <button
        id="submit-btn"
        type="submit"
        class="absolute bottom-[0.8rem] right-[0.8rem] flex items-center gap-2 py-[0.4rem] px-4 bg-[var(--letter-color)] text-[var(--page-background)] border-none cursor-pointer transition-all duration-200 hover:opacity-85 hover:translate-x-[2px] disabled:opacity-30 disabled:cursor-default disabled:transform-none"
      >
        <span
          class="font-['Poiret_One',cursive] text-[0.6rem] tracking-[0.35em] uppercase font-bold"
          >Send</span
        >
        <svg
          viewBox="0 0 20 20"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="w-4 h-4"
        >
          <path d="M4 10h12M12 5l5 5-5 5"></path>
        </svg>
      </button>
    </div>
  </form>
</div>

<div class="flex flex-wrap gap-2">
  {socialLinks.filter((s) => s.name === 'LinkedIn' || s.name === 'GitHub').map((link) => (
    <a
      href={link.url}
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center gap-2 px-4 py-2 text-xs tracking-[0.2em] uppercase font-bold border border-[var(--border-color)] hover:bg-[var(--hover-bg)] hover:text-[var(--hover-text)] transition-all duration-200"
    >
      <img src={link.icon} class="w-3 h-3 opacity-60" style="filter: brightness(0) saturate(100%) blur(0px);" alt={link.name} />
      {link.name}
    </a>
  ))}

  <a
    href={cv_link}
    target="_blank"
    rel="noopener noreferrer"
    class="flex items-center gap-2 px-4 py-2 text-xs tracking-[0.2em] uppercase font-bold border border-[var(--border-color)] hover:bg-[var(--hover-bg)] hover:text-[var(--hover-text)] transition-all duration-200"
  >
    <svg
      viewBox="0 0 16 16"
      width="12"
      height="12"
      fill="currentColor"
      class="text-[var(--accent-color)] shrink-0"
    >
      <path d="M10.5 8a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0z"></path>
      <path
        d="M0 8s3-5.5 8-5.5S16 8 16 8s-3 5.5-8 5.5S0 8 0 8zm8 3.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7z"
      ></path>
    </svg>
    CV
  </a>
</div>
