---
import Button from "../../components/ui/Button.astro";
import type { ContactData, SocialLink } from "../../lib/content";

interface Props {
  contact:     ContactData;
  socialLinks: SocialLink[];
}

const { contact }                                                           = Astro.props;
const { intro, email, location, statusStr, statusActive, formSubject, cv_url } = contact;

---

<script>
  import "../../scripts/contactForm";
</script>

<div class="w-full flex flex-col gap-7 laptop:gap-9 fhd:gap-11">

  {intro && (
    <p class="text-[0.65rem] laptop:text-[0.7rem] fhd:text-xs qhd:text-sm uhd:text-base
              leading-[1.8] opacity-60 tracking-[0.04em] m-0 pl-3
              border-l-2 border-[var(--accent)]">
      {intro}
    </p>
  )}

  <!-- Info block -->
  <div>
    <div class="grid grid-cols-1 mobile:grid-cols-2 gap-5">

      <!-- Left: Email + Location -->
      <div class="flex flex-col gap-4">
        <div class="flex flex-col gap-1">
          <span class="text-[0.5rem] laptop:text-[0.55rem] fhd:text-[0.62rem] qhd:text-xs uhd:text-sm tracking-[0.3em] uppercase font-bold opacity-40">Email</span>
          <a
            href={`mailto:${email}`}
            class="text-[clamp(0.82rem,1.4vw,1.1rem)] fhd:text-[clamp(0.95rem,1.4vw,1.35rem)] font-bold text-[var(--accent)]
                   opacity-70 can-hover:hover:opacity-100 active:opacity-100 transition-opacity break-all leading-snug self-start"
          >
            {email}
          </a>
        </div>

        <div class="flex flex-col gap-1">
          <span class="text-[0.5rem] laptop:text-[0.55rem] fhd:text-[0.62rem] qhd:text-xs uhd:text-sm tracking-[0.3em] uppercase font-bold opacity-40">Location</span>
          <span class="text-[0.6rem] laptop:text-[0.65rem] fhd:text-[0.75rem] qhd:text-sm uhd:text-base tracking-[0.18em] uppercase font-bold" style="color: var(--chart-2); opacity: 0.65;">{location}</span>
        </div>
      </div>

      <!-- Right: Curriculum -->
      <div class="flex flex-col gap-2">
        <span class="text-[0.5rem] laptop:text-[0.55rem] fhd:text-[0.62rem] qhd:text-xs uhd:text-sm tracking-[0.3em] uppercase font-bold opacity-40">Curriculum</span>
        <div class="flex flex-row flex-wrap gap-2 mobile:flex-col mobile:items-start">
          <a
            href={cv_url}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-base btn-primary gap-2 px-4 py-2
                   text-[0.55rem] laptop:text-[0.62rem] fhd:text-xs qhd:text-sm uhd:text-base tracking-[0.25em] uppercase font-bold"
          >
            <svg viewBox="0 0 16 16" width="10" height="10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;">
              <path d="M8 1v8M5 6l3 3 3-3M2 11v2a1 1 0 001 1h10a1 1 0 001-1v-2"/>
            </svg>
            CV · EN
          </a>
          <a
            href="/TymurBogach_CV_ES.pdf"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-base btn-primary gap-2 px-4 py-2
                   text-[0.55rem] laptop:text-[0.62rem] fhd:text-xs qhd:text-sm uhd:text-base tracking-[0.25em] uppercase font-bold"
          >
            <svg viewBox="0 0 16 16" width="10" height="10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;">
              <path d="M8 1v8M5 6l3 3 3-3M2 11v2a1 1 0 001 1h10a1 1 0 001-1v-2"/>
            </svg>
            CV · ES
          </a>
        </div>
      </div>

    </div>

  </div>

  <!-- Form -->
  <form id="contact-form" autocomplete="off" data-email={email} class="flex flex-col gap-4">
    <p class="text-[0.55rem] laptop:text-[0.6rem] fhd:text-[0.68rem] tracking-[0.25em] font-bold m-0" style="color: var(--chart-2); opacity: 0.4;">// send a message</p>
    <input type="hidden" name="access_key" value={import.meta.env.PUBLIC_WEB3FORMS_KEY} />
    <input type="hidden" name="subject"    value={formSubject} />

    <div
      id="form-status"
      class="hidden py-2 px-3 border border-[var(--border-subtle)]
             text-[0.65rem] laptop:text-[0.7rem] fhd:text-xs qhd:text-sm tracking-[0.2em] text-center text-[var(--foreground)]"
    />

    <div class="grid grid-cols-1 min-[30rem]:grid-cols-2 gap-4">
      <input
        id="f-name" name="name" type="text" required autocomplete="off"
        placeholder="Name"
        class="bg-transparent w-full outline-none px-3 py-2.5
               text-xs laptop:text-sm fhd:text-base qhd:text-lg uhd:text-xl
               font-['Poiret_One',cursive] text-[var(--foreground)]
               border border-[var(--border)] focus:border-[var(--accent)]
               focus:bg-[color-mix(in_srgb,var(--accent)_3%,transparent)]
               transition-colors duration-200
               placeholder:opacity-35 placeholder:tracking-[0.1em] placeholder:uppercase
               placeholder:text-[0.6rem] laptop:placeholder:text-[0.65rem] fhd:placeholder:text-xs"
      />
      <input
        id="f-email" name="email" type="email" required autocomplete="off"
        placeholder="Email"
        class="bg-transparent w-full outline-none px-3 py-2.5
               text-xs laptop:text-sm fhd:text-base qhd:text-lg uhd:text-xl
               font-['Poiret_One',cursive] text-[var(--foreground)]
               border border-[var(--border)] focus:border-[var(--accent)]
               focus:bg-[color-mix(in_srgb,var(--accent)_3%,transparent)]
               transition-colors duration-200
               placeholder:opacity-35 placeholder:tracking-[0.1em] placeholder:uppercase
               placeholder:text-[0.6rem] laptop:placeholder:text-[0.65rem] fhd:placeholder:text-xs"
      />
    </div>

    <textarea
      id="f-message" name="message" rows="5" required
      placeholder="Message"
      class="bg-transparent w-full outline-none p-3
             text-xs laptop:text-sm fhd:text-base qhd:text-lg uhd:text-xl
             font-['Poiret_One',cursive] text-[var(--foreground)]
             resize-none border border-[var(--border)] focus:border-[var(--accent)]
             focus:bg-[color-mix(in_srgb,var(--accent)_3%,transparent)]
             transition-colors duration-200 focus-visible:outline-none
             placeholder:opacity-35 placeholder:tracking-[0.1em] placeholder:uppercase
             placeholder:text-[0.6rem] laptop:placeholder:text-[0.65rem] fhd:placeholder:text-xs"
    />

    <div class="flex items-center justify-between gap-4">
      <span class="text-[0.5rem] laptop:text-[0.55rem] fhd:text-[0.62rem] tracking-[0.22em] uppercase font-bold" style="color: var(--chart-2); opacity: 0.4;">
        // responds within 24h
      </span>
      <Button id="submit-btn" type="submit" variant="primary">
        Send
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5"
             stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5">
          <path d="M4 10h12M12 5l5 5-5 5" />
        </svg>
      </Button>
    </div>
  </form>

  <!-- Bot hint -->
  <p class="text-center text-[0.5rem] laptop:text-[0.55rem] fhd:text-[0.62rem] qhd:text-xs
            tracking-[0.22em] leading-[2] opacity-25 m-0 uppercase">
    Or ask the bot running locally on my cluster &nbsp;<span class="font-mono text-[var(--accent)]">↘</span>
  </p>

</div>
