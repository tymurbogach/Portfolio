---
import type { HomeData } from "../../lib/content";

interface Props {
  home: HomeData;
}

const { home } = Astro.props;
const { hero, techStrip, cta } = home;
---

<div class="home-hero">
  <!-- Background dot grid -->
  <div class="home-grid-bg" aria-hidden="true"></div>

  <!-- Hero text -->
  <div class="hero-block">
    <h1 class="home-h1">
      {hero.title1}<br />
      <span class="home-h1-dim">{hero.title2}</span>
    </h1>
    <p class="home-sub">
      {hero.subtitle1}<br />
      {hero.subtitle2}
    </p>
  </div>

  <!-- CTAs -->
  <div class="cta-row">
    <a href={cta.primaryHref} class="cta-primary">{cta.primary}</a>
    <a href={cta.secondaryHref} class="cta-ghost">{cta.secondary}</a>
  </div>

  <!-- Tech strip -->
  <div class="tech-strip">
    <div class="tech-line"></div>
    <p class="tech-text">{techStrip}</p>
    <div class="tech-line"></div>
  </div>
</div>
