---
import Icon from "../../components/ui/Icon.astro";
import type { ResumeData } from "../../lib/content";

interface Props { resume: ResumeData; }

const { resume } = Astro.props;
const { frontend, backend, homelab, ai, languages } = resume;

const categories = [
  { label: "Frontend",   skills: frontend },
  { label: "Backend",    skills: backend  },
  { label: "Homelab",    skills: homelab  },
  ...(ai?.length ? [{ label: "AI Tooling", skills: ai }] : []),
];
---

<section class="grid grid-cols-1 laptop:grid-cols-2 laptop-scaled:grid-cols-2 w-full
                gap-8 laptop:gap-x-10 laptop:gap-y-10 fhd:gap-x-14 fhd:gap-y-14">

  {categories.map(({ label, skills }) => (
    <div class="resume-section flex flex-col gap-2.5">

      <span class="cat-label">{label}</span>

      <div class="resume-grid
                  grid grid-cols-2 gap-1.5 overflow-hidden
                  laptop:grid-cols-3 fhd:gap-2.5
                  max-h-[8.5rem] laptop:max-h-[9rem] fhd:max-h-[11rem] qhd:max-h-[13rem]">
        {skills.map(({ slug, color: c, label: l }: { slug: string; color: string; label: string }) => (
          <span class="skill-chip">
            <Icon slug={slug} color={c} size={15} label={l}
                  class="shrink-0 fhd:!w-4 fhd:!h-4 qhd:!w-5 qhd:!h-5 uhd:!w-6 uhd:!h-6" />
            <span class="chip-label">{l}</span>
          </span>
        ))}
      </div>

      <button
        class="resume-toggle hidden self-start items-center gap-1 mt-0.5 cursor-pointer
               opacity-40 text-[0.5rem] laptop:text-[0.55rem] tracking-[0.15em] uppercase
               transition-opacity duration-200 can-hover:hover:opacity-100 active:opacity-100"
        aria-expanded="false"
      >
        <span class="resume-toggle-label font-bold" style="color: var(--accent-color);"></span>
        <span class="resume-toggle-word">more</span>
      </button>

    </div>
  ))}

  <!-- Languages -->
  <div class="flex flex-col gap-2.5 laptop:col-span-2 laptop-scaled:col-span-2">

    <span class="cat-label">Languages</span>

    <div class="grid grid-cols-2 gap-1.5 overflow-hidden laptop:grid-cols-4 fhd:gap-2.5">
      {languages.map(({ flag, lang, level }: { flag: string; lang: string; level: string }) => (
        <span class="skill-chip">
          <span class="text-[0.9rem] laptop:text-base fhd:text-lg qhd:text-xl uhd:text-2xl leading-none shrink-0" aria-hidden="true">{flag}</span>
          <span class="chip-label">{lang}</span>
          <span class="text-[0.45rem] laptop:text-[0.5rem] fhd:text-[0.55rem] qhd:text-xs
                       tracking-[0.15em] uppercase leading-none opacity-40">{level}</span>
        </span>
      ))}
    </div>

  </div>

</section>

<script>
  import "../../scripts/resumeToggles";
</script>
