---
import Chip           from "../../components/ui/Chip.astro";
import SectionHeading from "../../components/ui/SectionHeading.astro";
import type { ResumeData } from "../../lib/content";

interface Props {
  resume: ResumeData;
}

const { resume }                               = Astro.props;
const { frontend, backend, homelab, languages } = resume;
---

<section class="flex flex-col w-full gap-6 laptop:gap-8">

  <!-- Frontend + Backend en dos columnas -->
  <div class="grid grid-cols-1 mobile:grid-cols-2 gap-6 laptop:gap-8">

    <div class="flex flex-col gap-3">
      <SectionHeading label="Frontend" />
      <div class="grid grid-cols-[repeat(auto-fill,minmax(100px,1fr))] gap-2">
         {frontend.map(({ slug, color, label }: { slug: string; color: string; label: string }) => (
          <Chip slug={slug} color={color} label={label} />
        ))}
      </div>
    </div>

    <div class="flex flex-col gap-3">
      <SectionHeading label="Backend" />
      <div class="grid grid-cols-[repeat(auto-fill,minmax(100px,1fr))] gap-2">
        {backend.map(({ slug, color, label }: { slug: string; color: string; label: string }) => (
          <Chip slug={slug} color={color} label={label} />
        ))}
      </div>
    </div>

  </div>

  <!-- Homelab -->
  <div class="flex flex-col gap-3">
    <SectionHeading label="Homelab & DevOps" />
    <div class="grid grid-cols-[repeat(auto-fill,minmax(100px,1fr))] gap-2">
      {homelab.map(({ slug, color, label }: { slug: string; color: string; label: string }) => (
        <Chip slug={slug} color={color} label={label} />
      ))}
    </div>
  </div>

  <!-- Languages -->
  <div class="flex flex-col gap-3">
    <SectionHeading label="Languages" />
    <div class="flex flex-wrap gap-2">
      {languages.map(({ flag, lang, level }: { flag: string; lang: string; level: string }) => (
        <div class="flex items-center gap-2 px-3 py-1.5
                    border border-[var(--border-subtle)] bg-[var(--surface-raised)]">
          <span class="text-sm fhd:text-base qhd:text-lg">{flag}</span>
          <span class="text-xs fhd:text-sm qhd:text-base font-bold">{lang}</span>
          <span class="text-[0.5rem] fhd:text-[0.6rem] qhd:text-xs tracking-[0.25em] uppercase opacity-40">{level}</span>
        </div>
      ))}
    </div>
  </div>

</section>