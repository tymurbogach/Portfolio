---
import Icon          from "../../components/ui/Icon.astro";
import type { ResumeData } from "../../lib/content";

interface Props {
  resume: ResumeData;
}

const { resume } = Astro.props;
const { frontend, backend, homelab, ai, languages } = resume;

const categories = [
  { label: "Frontend",   skills: frontend, color: "var(--accent-color)"     },
  { label: "Backend",    skills: backend,  color: "var(--accent-secondary)" },
  { label: "Homelab",    skills: homelab,  color: "var(--accent-tertiary)"  },
  ...(ai?.length ? [{ label: "AI Tooling", skills: ai, color: "var(--accent-color)" }] : []),
];
---

<section class="grid grid-cols-1 laptop:grid-cols-2 laptop-scaled:grid-cols-2 w-full gap-8 laptop:gap-x-10 laptop:gap-y-12 fhd:gap-x-14 fhd:gap-y-16 qhd:gap-y-20 uhd:gap-y-24">

  {categories.map(({ label, skills, color }) => (
    <div class="resume-section flex flex-col gap-2 laptop:gap-2.5 fhd:gap-3">

      <span
        class="text-[0.6rem] laptop:text-[0.68rem] laptop-scaled:text-[0.68rem] fhd:text-[0.78rem] qhd:text-xs uhd:text-sm
               tracking-[0.5em] uppercase font-bold"
        style={`color: ${color};`}
      >
        {label}
      </span>

      <div
        class="resume-grid overflow-hidden flex flex-wrap
               gap-1.5 laptop:gap-2 fhd:gap-2.5
               max-h-[8rem] laptop:max-h-[6rem] fhd:max-h-[7.5rem] qhd:max-h-[9rem] uhd:max-h-[12rem]"
        style={`--cat: ${color};`}
      >
        {skills.map(({ slug, color: iconColor, label: skillLabel }: { slug: string; color: string; label: string }) => (
          <span class="skill-chip flex items-center gap-1.5
                       px-2 py-[0.3rem] laptop:px-2.5 laptop:py-[0.35rem] fhd:px-3 fhd:py-1.5
                       rounded transition-colors duration-150">
            <Icon slug={slug} color={iconColor} size={15} label={skillLabel} class="shrink-0" />
            <span
              class="text-[0.6rem] laptop:text-[0.65rem] fhd:text-[0.75rem] qhd:text-sm uhd:text-base
                     tracking-[0.05em] leading-none whitespace-nowrap"
              style="opacity: 0.8;"
            >
              {skillLabel}
            </span>
          </span>
        ))}
      </div>

      <button
        class="resume-toggle hidden self-start flex items-center gap-1 mt-0.5 cursor-pointer
               transition-opacity duration-200 can-hover:hover:opacity-100 active:opacity-100"
        style="opacity: 0.4;"
        aria-expanded="false"
      >
        <span
          class="resume-toggle-label
                 text-[0.5rem] laptop:text-[0.55rem] fhd:text-[0.62rem]
                 tracking-[0.15em] uppercase"
          style="color: var(--accent-color); font-weight: bold;"
        ></span>
        <span
          class="resume-toggle-word
                 text-[0.5rem] laptop:text-[0.55rem] fhd:text-[0.62rem]
                 tracking-[0.15em] uppercase"
        >
          more
        </span>
      </button>

    </div>
  ))}

  <!-- Languages -->
  <div class="flex flex-col gap-2 laptop:gap-2.5 fhd:gap-3 laptop:col-span-2 laptop-scaled:col-span-2">

    <span
      class="text-[0.6rem] laptop:text-[0.68rem] laptop-scaled:text-[0.68rem] fhd:text-[0.78rem] qhd:text-xs uhd:text-sm
             tracking-[0.5em] uppercase font-bold opacity-40"
    >
      Languages
    </span>

    <div class="grid grid-cols-2 gap-x-3 gap-y-3
                laptop:flex laptop:justify-around laptop:gap-0
                pl-3 laptop:pl-4 fhd:pl-5">
      {languages.map(({ flag, lang, level }: { flag: string; lang: string; level: string }) => (
        <span class="flex items-start laptop:items-center gap-1.5 laptop:gap-2">
          <span class="text-sm laptop:text-base fhd:text-lg shrink-0" aria-hidden="true">{flag}</span>
          <span class="flex flex-col laptop:flex-row laptop:items-center laptop:gap-1.5">
            <span
              class="text-[0.62rem] laptop:text-[0.7rem] fhd:text-xs qhd:text-sm uhd:text-base
                     tracking-[0.06em]"
              style="opacity: 0.75;"
            >
              {lang}
            </span>
            <span
              class="text-[0.5rem] laptop:text-[0.55rem] fhd:text-[0.62rem] qhd:text-xs
                     tracking-[0.15em] uppercase"
              style="opacity: 0.3;"
            >
              {level}
            </span>
          </span>
        </span>
      ))}
    </div>

  </div>

</section>

<style>
  .skill-chip {
    border: 1px solid color-mix(in srgb, var(--cat) 22%, transparent);
    background: color-mix(in srgb, var(--cat) 5%, transparent);
  }
  .skill-chip:hover {
    background: color-mix(in srgb, var(--cat) 13%, transparent);
  }
</style>

<script>
  import "../../scripts/resumeToggles";
</script>
