---
import Chip           from "../../components/ui/Chip.astro";
import SectionHeading from "../../components/ui/SectionHeading.astro";
import type { ResumeData } from "../../lib/content";

interface Props {
  resume: ResumeData;
}

const { resume }                                          = Astro.props;
const { frontend, backend, homelab, homelabExtra, languages } = resume;
---

<section class="flex flex-col w-full gap-6 laptop:gap-8 fhd:gap-10">

  <!-- Frontend + Backend en dos columnas -->
  <div class="grid grid-cols-1 mobile:grid-cols-2 gap-6 laptop:gap-8">

    <div class="flex flex-col gap-3 laptop:gap-4">
      <SectionHeading label="Frontend" />
      <div class="grid grid-cols-[repeat(auto-fill,minmax(115px,1fr))] laptop:grid-cols-[repeat(auto-fill,minmax(130px,1fr))] fhd:grid-cols-[repeat(auto-fill,minmax(155px,1fr))] qhd:grid-cols-[repeat(auto-fill,minmax(190px,1fr))] uhd:grid-cols-[repeat(auto-fill,minmax(250px,1fr))] gap-2 laptop:gap-3 fhd:gap-4 qhd:gap-5">
         {frontend.map(({ slug, color, label }: { slug: string; color: string; label: string }) => (
          <Chip slug={slug} color={color} label={label} />
        ))}
      </div>
    </div>

    <div class="flex flex-col gap-3 laptop:gap-4">
      <SectionHeading label="Backend" />
      <div class="grid grid-cols-[repeat(auto-fill,minmax(115px,1fr))] laptop:grid-cols-[repeat(auto-fill,minmax(130px,1fr))] fhd:grid-cols-[repeat(auto-fill,minmax(155px,1fr))] qhd:grid-cols-[repeat(auto-fill,minmax(190px,1fr))] uhd:grid-cols-[repeat(auto-fill,minmax(250px,1fr))] gap-2 laptop:gap-3 fhd:gap-4 qhd:gap-5">
        {backend.map(({ slug, color, label }: { slug: string; color: string; label: string }) => (
          <Chip slug={slug} color={color} label={label} />
        ))}
      </div>
    </div>

  </div>

  <!-- Homelab -->
  <div class="flex flex-col gap-3 laptop:gap-4">
    <SectionHeading label="Homelab & DevOps" />
    <div class="grid grid-cols-[repeat(auto-fill,minmax(115px,1fr))] laptop:grid-cols-[repeat(auto-fill,minmax(130px,1fr))] fhd:grid-cols-[repeat(auto-fill,minmax(155px,1fr))] qhd:grid-cols-[repeat(auto-fill,minmax(190px,1fr))] uhd:grid-cols-[repeat(auto-fill,minmax(250px,1fr))] gap-2 laptop:gap-3 fhd:gap-4 qhd:gap-5">
      {homelab.map(({ slug, color, label }: { slug: string; color: string; label: string }) => (
        <Chip slug={slug} color={color} label={label} />
      ))}
      {homelabExtra && homelabExtra > 0 && (
        <span
          class="flex items-center justify-center gap-1.5
                 h-11 laptop:h-14 laptop-scaled:h-14 fhd:h-16 qhd:h-20 uhd:h-24
                 px-3.5 laptop:px-4
                 border border-dashed border-[var(--border-subtle)]
                 cursor-default"
          style="opacity: 0.45;"
          title={`${homelabExtra} more tools without icons`}
        >
          <span
            class="text-[0.7rem] laptop:text-[0.78rem] fhd:text-xs font-bold"
            style="color: var(--accent-color);"
          >+{homelabExtra}</span>
          <span
            class="text-[0.55rem] laptop:text-[0.62rem] tracking-[0.12em] uppercase font-bold"
            style="color: var(--letter-color);"
          >more</span>
        </span>
      )}
    </div>
  </div>

  <!-- Languages -->
  <div class="flex flex-col gap-3 laptop:gap-4">
    <SectionHeading label="Languages" />
    <div class="grid grid-cols-2 mobile:grid-cols-4 gap-2 laptop:gap-3">
      {languages.map(({ flag, lang, level }: { flag: string; lang: string; level: string }) => (
        <div class="flex flex-col items-center justify-center gap-1 py-3 laptop:py-4
                    border border-[var(--border-subtle)] bg-[var(--surface-raised)]">
          <span class="text-xl laptop:text-2xl fhd:text-3xl qhd:text-4xl uhd:text-5xl">{flag}</span>
          <span class="text-xs laptop:text-sm fhd:text-base qhd:text-lg uhd:text-xl font-bold tracking-[0.05em]">{lang}</span>
          <span class="text-[0.5rem] laptop:text-[0.58rem] fhd:text-[0.65rem] qhd:text-xs uhd:text-sm tracking-[0.25em] uppercase opacity-40">{level}</span>
        </div>
      ))}
    </div>
  </div>

</section>