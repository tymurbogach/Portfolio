---
import Icon          from "../../components/ui/Icon.astro";
import type { ResumeData } from "../../lib/content";

interface Props {
  resume: ResumeData;
}

const { resume } = Astro.props;
const { frontend, backend, homelab, ai, languages } = resume;

const categories = [
  { label: "Frontend",   skills: frontend },
  { label: "Backend",    skills: backend  },
  { label: "Homelab",    skills: homelab  },
  ...(ai && ai.length ? [{ label: "AI Tooling", skills: ai }] : []),
];
---

<section class="grid grid-cols-1 laptop:grid-cols-2 laptop-scaled:grid-cols-2 w-full gap-6 laptop:gap-x-10 laptop:gap-y-7 fhd:gap-x-14 fhd:gap-y-9">

  {categories.map(({ label, skills }) => (
    <div class="resume-section flex flex-col gap-2 laptop:gap-2.5 fhd:gap-3">

      <span
        class="text-[0.6rem] laptop:text-[0.68rem] laptop-scaled:text-[0.68rem] fhd:text-[0.78rem] qhd:text-xs uhd:text-sm
               tracking-[0.5em] uppercase font-bold opacity-40"
      >
        {label}
      </span>

      <div
        class="resume-grid overflow-hidden
               max-h-[6rem] laptop:max-h-[6.75rem] fhd:max-h-[8.5rem]
               grid grid-cols-2 gap-x-3 gap-y-3
               laptop:gap-x-4 laptop:gap-y-3.5 fhd:gap-5
               pl-3 laptop:pl-4 fhd:pl-5"
      >
        {skills.map(({ slug, color, label: skillLabel }: { slug: string; color: string; label: string }) => (
          <span class="flex items-start gap-1.5 laptop:gap-2">
            <Icon slug={slug} color={color} size={13} label={skillLabel} class="mt-[1px] shrink-0" />
            <span
              class="text-[0.62rem] laptop:text-[0.7rem] fhd:text-xs qhd:text-sm uhd:text-base
                     tracking-[0.06em] leading-snug"
              style="opacity: 0.75;"
            >
              {skillLabel}
            </span>
          </span>
        ))}
      </div>

      <button
        class="resume-toggle hidden self-start flex items-center gap-1 mt-0.5 cursor-pointer
               transition-opacity duration-200 can-hover:hover:opacity-100 active:opacity-100"
        style="opacity: 0.4;"
        aria-expanded="false"
      >
        <span
          class="resume-toggle-label
                 text-[0.5rem] laptop:text-[0.55rem] fhd:text-[0.62rem]
                 tracking-[0.15em] uppercase"
          style="color: var(--accent-color); font-weight: bold;"
        ></span>
        <span
          class="resume-toggle-word
                 text-[0.5rem] laptop:text-[0.55rem] fhd:text-[0.62rem]
                 tracking-[0.15em] uppercase"
        >
          more
        </span>
      </button>

    </div>
  ))}

  <!-- Languages -->
  <div class="flex flex-col gap-2 laptop:gap-2.5 fhd:gap-3 laptop:col-span-2 laptop-scaled:col-span-2">

    <span
      class="text-[0.6rem] laptop:text-[0.68rem] laptop-scaled:text-[0.68rem] fhd:text-[0.78rem] qhd:text-xs uhd:text-sm
             tracking-[0.5em] uppercase font-bold opacity-40"
    >
      Languages
    </span>

    <div class="grid grid-cols-2 gap-x-3 gap-y-3
                laptop:flex laptop:justify-around laptop:gap-0
                pl-3 laptop:pl-4 fhd:pl-5">
      {languages.map(({ flag, lang, level }: { flag: string; lang: string; level: string }) => (
        <span class="flex items-start laptop:items-center gap-1.5 laptop:gap-2">
          <span class="text-sm laptop:text-base fhd:text-lg shrink-0" aria-hidden="true">{flag}</span>
          <span class="flex flex-col laptop:flex-row laptop:items-center laptop:gap-1.5">
            <span
              class="text-[0.62rem] laptop:text-[0.7rem] fhd:text-xs qhd:text-sm uhd:text-base
                     tracking-[0.06em]"
              style="opacity: 0.75;"
            >
              {lang}
            </span>
            <span
              class="text-[0.5rem] laptop:text-[0.55rem] fhd:text-[0.62rem] qhd:text-xs
                     tracking-[0.15em] uppercase"
              style="opacity: 0.3;"
            >
              {level}
            </span>
          </span>
        </span>
      ))}
    </div>

  </div>

</section>

<script>
  import "../../scripts/resumeToggles";
</script>
