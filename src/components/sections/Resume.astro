---
import Chip           from "../../components/ui/Chip.astro";
import SectionHeading from "../../components/ui/SectionHeading.astro";
import type { ResumeData } from "../../lib/content";

interface Props {
  resume: ResumeData;
}

const { resume }                               = Astro.props;
const { frontend, backend, homelab, languages } = resume;
---

<section class="flex flex-col w-full gap-6 laptop:gap-8 fhd:gap-10">

  <!-- Frontend + Backend en dos columnas -->
  <div class="grid grid-cols-1 mobile:grid-cols-2 gap-6 laptop:gap-8">

    <div class="flex flex-col gap-3 laptop:gap-4">
      <SectionHeading label="Frontend" />
      <div class="grid grid-cols-[repeat(auto-fill,minmax(115px,1fr))] laptop:grid-cols-[repeat(auto-fill,minmax(130px,1fr))] gap-2 laptop:gap-3">
         {frontend.map(({ slug, color, label }: { slug: string; color: string; label: string }) => (
          <Chip slug={slug} color={color} label={label} />
        ))}
      </div>
    </div>

    <div class="flex flex-col gap-3 laptop:gap-4">
      <SectionHeading label="Backend" />
      <div class="grid grid-cols-[repeat(auto-fill,minmax(115px,1fr))] laptop:grid-cols-[repeat(auto-fill,minmax(130px,1fr))] gap-2 laptop:gap-3">
        {backend.map(({ slug, color, label }: { slug: string; color: string; label: string }) => (
          <Chip slug={slug} color={color} label={label} />
        ))}
      </div>
    </div>

  </div>

  <!-- Homelab -->
  <div class="flex flex-col gap-3 laptop:gap-4">
    <SectionHeading label="Homelab & DevOps" />
    <div class="grid grid-cols-[repeat(auto-fill,minmax(115px,1fr))] laptop:grid-cols-[repeat(auto-fill,minmax(130px,1fr))] gap-2 laptop:gap-3">
      {homelab.map(({ slug, color, label }: { slug: string; color: string; label: string }) => (
        <Chip slug={slug} color={color} label={label} />
      ))}
    </div>
  </div>

  <!-- Languages -->
  <div class="flex flex-col gap-3 laptop:gap-4">
    <SectionHeading label="Languages" />
    <div class="grid grid-cols-2 mobile:grid-cols-4 gap-2 laptop:gap-3">
      {languages.map(({ flag, lang, level }: { flag: string; lang: string; level: string }) => (
        <div class="flex flex-col items-center justify-center gap-1 py-3 laptop:py-4
                    border border-[var(--border-subtle)] bg-[var(--surface-raised)]">
          <span class="text-xl laptop:text-2xl fhd:text-3xl">{flag}</span>
          <span class="text-xs laptop:text-sm fhd:text-base font-bold tracking-[0.05em]">{lang}</span>
          <span class="text-[0.5rem] laptop:text-[0.58rem] fhd:text-[0.65rem] tracking-[0.25em] uppercase opacity-40">{level}</span>
        </div>
      ))}
    </div>
  </div>

</section>