---
import Icon          from "../../components/ui/Icon.astro";
import type { ResumeData } from "../../lib/content";

interface Props {
  resume: ResumeData;
}

const { resume } = Astro.props;
const { frontend, backend, homelab, ai, languages } = resume;

const SHOW_MAX = 12;

const categories = [
  { label: "Frontend",   skills: frontend },
  { label: "Backend",    skills: backend  },
  { label: "Homelab",    skills: homelab  },
  ...(ai && ai.length ? [{ label: "AI Tooling", skills: ai }] : []),
];
---

<section class="flex flex-col w-full gap-6 laptop:gap-7 fhd:gap-9">

  {categories.map(({ label, skills }) => {
    const hasMore = skills.length > SHOW_MAX;
    const extraCount = skills.length - SHOW_MAX;
    return (
      <div class="resume-section flex flex-col gap-2 laptop:gap-2.5 fhd:gap-3">

        <span
          class="text-[0.6rem] laptop:text-[0.68rem] laptop-scaled:text-[0.68rem] fhd:text-[0.78rem] qhd:text-xs uhd:text-sm
                 tracking-[0.5em] uppercase font-bold opacity-40"
        >
          {label}
        </span>

        <div class="grid grid-cols-[repeat(auto-fill,minmax(10rem,1fr))] gap-x-3 gap-y-3 laptop:gap-x-4 laptop:gap-y-3.5 fhd:gap-5">
          {skills.map(({ slug, color, label: skillLabel }: { slug: string; color: string; label: string }, i: number) => (
            <span
              class:list={[
                "flex items-start gap-1.5 laptop:gap-2",
                i >= SHOW_MAX && "resume-extra hidden",
              ]}
            >
              <Icon slug={slug} color={color} size={13} label={skillLabel} class="mt-[1px] shrink-0" />
              <span
                class="text-[0.62rem] laptop:text-[0.7rem] fhd:text-xs qhd:text-sm uhd:text-base
                       tracking-[0.06em] leading-snug"
                style="opacity: 0.75;"
              >
                {skillLabel}
              </span>
            </span>
          ))}
        </div>

        {hasMore && (
          <button
            class="resume-toggle self-start flex items-center gap-1 mt-0.5 cursor-pointer"
            style="opacity: 0.4;"
            aria-expanded="false"
          >
            <span
              class="resume-toggle-label
                     text-[0.5rem] laptop:text-[0.55rem] fhd:text-[0.62rem]
                     tracking-[0.15em] uppercase"
              style="color: var(--accent-color); font-weight: bold;"
            >
              +{extraCount}
            </span>
            <span
              class="resume-toggle-word
                     text-[0.5rem] laptop:text-[0.55rem] fhd:text-[0.62rem]
                     tracking-[0.15em] uppercase"
            >
              more
            </span>
          </button>
        )}

      </div>
    );
  })}

  <!-- Languages -->
  <div class="flex flex-col gap-2 laptop:gap-2.5 fhd:gap-3">

    <span
      class="text-[0.6rem] laptop:text-[0.68rem] laptop-scaled:text-[0.68rem] fhd:text-[0.78rem] qhd:text-xs uhd:text-sm
             tracking-[0.5em] uppercase font-bold opacity-40"
    >
      Languages
    </span>

    <div class="flex flex-wrap gap-x-5 gap-y-2.5 laptop:gap-x-6 fhd:gap-x-8 fhd:gap-y-3">
      {languages.map(({ flag, lang, level }: { flag: string; lang: string; level: string }) => (
        <span class="flex items-center gap-1.5 laptop:gap-2">
          <span class="text-sm laptop:text-base fhd:text-lg" aria-hidden="true">{flag}</span>
          <span
            class="text-[0.62rem] laptop:text-[0.7rem] fhd:text-xs qhd:text-sm uhd:text-base
                   tracking-[0.06em] whitespace-nowrap"
            style="opacity: 0.75;"
          >
            {lang}
          </span>
          <span
            class="text-[0.5rem] laptop:text-[0.55rem] fhd:text-[0.62rem] qhd:text-xs
                   tracking-[0.15em] uppercase"
            style="opacity: 0.3;"
          >
            · {level}
          </span>
        </span>
      ))}
    </div>

  </div>

</section>

<script>
  function initResumeToggles() {
    document.querySelectorAll<HTMLButtonElement>(".resume-toggle").forEach((btn) => {
      btn.addEventListener("click", () => {
        const section = btn.closest<HTMLElement>(".resume-section");
        if (!section) return;

        const extras = section.querySelectorAll<HTMLElement>(".resume-extra");
        const labelEl = btn.querySelector<HTMLElement>(".resume-toggle-label");
        const wordEl  = btn.querySelector<HTMLElement>(".resume-toggle-word");
        if (!extras.length) return;

        const expanded = btn.getAttribute("aria-expanded") === "true";

        extras.forEach((el) => el.classList.toggle("hidden", expanded));
        btn.setAttribute("aria-expanded", String(!expanded));

        if (labelEl) labelEl.textContent = expanded ? `+${extras.length}` : "−";
        if (wordEl)  wordEl.textContent  = expanded ? "more" : "less";
      });
    });
  }

  document.addEventListener("astro:page-load", initResumeToggles);
</script>
