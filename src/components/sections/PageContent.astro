---
import Hero from "./Hero.astro";
import About from "./About.astro";
import Resume from "./Resume.astro";
import Projects from "./Projects.astro";
import Contact from "./Contact.astro";
import {
  getSite,
  getHeroData,
  getAboutData,
  getResumeData,
  getProjects,
  getContactData,
  getSocialLinks,
  getLabeledSections,
} from "../../lib/content";
import type { LabeledSection } from "../../lib/content";

const site = await getSite();
const heroData = await getHeroData();
const aboutData = await getAboutData();
const resumeData = await getResumeData();
const projects = await getProjects();
const contactData = await getContactData();
const socialLinks = await getSocialLinks();

const sections: LabeledSection[] = getLabeledSections(site);
---

<div class="flex flex-col w-full">
  <!-- HOME -->
  <section
    id="home"
    class="min-h-[calc(100dvh-5.5rem)] mobile:min-h-[calc(100dvh-9rem)]
           pt-[4rem] laptop:pt-0 laptop-scaled:pt-0
           laptop:min-h-0 laptop-scaled:min-h-0
           flex flex-col
           laptop:h-[min(calc(100vh-12rem),52rem)] laptop-scaled:h-[min(calc(100vh-9rem),52rem)]"
    aria-label="Home"
  >
    <div
      class="flex shrink-0 flex-col gap-3 laptop:flex-row laptop:items-center laptop:justify-between laptop:gap-6
             laptop:pt-[2rem] laptop-scaled:flex-row laptop-scaled:items-center laptop-scaled:justify-between
             laptop-scaled:gap-6 laptop-scaled:pt-[var(--section-gap)]"
    >
      <!-- Label al top — igual que todas las secciones -->
      <div>
        <div class="flex items-center gap-3">
          <h2
            class="font-chrome text-[var(--type-meta)] tracking-[0.22em] uppercase font-bold m-0 text-glow"
            style="color: var(--accent);"
          >
            &gt; PORTFOLIO.SYS
          </h2>
          <span
            id="visitors-meter"
            class="flex items-center gap-1.5 opacity-0 transition-opacity duration-500 font-chrome
                   text-[0.65rem] laptop:text-[var(--type-meta)]
                   tracking-[0.12em] text-[var(--accent)]"
            aria-label="Unique visitors"
            aria-live="polite"
          >
            <svg
              class="w-[0.9em] h-[0.9em] shrink-0"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
              <circle cx="9" cy="7" r="4" />
              <path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" />
            </svg>
            <span id="stat-visitors"></span>
          </span>
        </div>
        <div class="text-gradient text-glow gradient-line mt-2 laptop:mt-3 laptop-scaled:mt-3" />
      </div>
    </div>

    <!-- Hero fills all remaining space -->
    <div class="pb-10 laptop:pb-[var(--section-gap)] laptop-scaled:pb-[var(--section-gap)] flex-1 min-h-0 flex flex-col">
      <Hero hero={heroData} />
    </div>
  </section>

  <!-- SECCIONES DINÁMICAS -->
  {sections.map((section: LabeledSection) => (
    <section
      id={section.sectionId}
      class="pt-[4rem] laptop:pt-[3rem] laptop-scaled:pt-[3rem]"
      aria-labelledby={`heading-${section.sectionId}`}
    >
      <div class="mb-3 laptop:mb-5 laptop-scaled:mb-5">
        <h2
          id={`heading-${section.sectionId}`}
          class="font-hud text-[var(--type-meta)] tracking-[0.22em] uppercase font-bold m-0 text-glow"
          style="color: var(--accent);"
        >
          &gt; {section.sectionLabel.toUpperCase()}
        </h2>
        <div class="text-gradient text-glow gradient-line mt-2 laptop:mt-3 laptop-scaled:mt-3" />
      </div>

      <div class="pb-[3rem] laptop:pb-[4rem] laptop-scaled:pb-[4rem]">
        {section.sectionId === "about" && <About about={aboutData} />}
        {section.sectionId === "resume" && <Resume resume={resumeData} />}
        {section.sectionId === "projects" && <Projects projects={projects} />}
        {section.sectionId === "contact" && (
          <Contact contact={contactData} socialLinks={socialLinks} />
        )}
      </div>
    </section>
  ))}
</div>
