---
import Hero     from "./Hero.astro";
import About    from "./About.astro";
import Resume   from "./Resume.astro";
import Projects from "./Projects.astro";
import Contact  from "./Contact.astro";
import {
  getSite,
  getHomeData,
  getHeroData,
  getAboutData,
  getResumeData,
  getProjects,
  getContactData,
  getSocialLinks,
  getLabeledSections,
} from "../../lib/content";
import type { LabeledSection } from "../../lib/content";

// ==========================================
// FETCH DE DATOS
// ==========================================
const site        = await getSite();
const homeData    = await getHomeData();
const heroData    = await getHeroData();
const aboutData   = await getAboutData();
const resumeData  = await getResumeData();
const projects    = await getProjects();
const contactData = await getContactData();
const socialLinks = await getSocialLinks();

// Secciones navegables (excluye home)
const sections: LabeledSection[] = getLabeledSections(site);
---

<div class="flex flex-col w-full">

  <!-- HOME -->
  <section
    id="home"
    class="flex items-center justify-center"
    aria-label="Home"
  >
    <div class="w-full">
      <Hero hero={heroData} />
    </div>
  </section>

  <!-- SECCIONES DINÁMICAS -->
  {sections.map((section: LabeledSection) => (
    <section
      id={section.sectionId}
      class="pt-[4rem] laptop:pt-[2rem] border-t border-[var(--border-subtle)]"
      aria-labelledby={`heading-${section.sectionId}`}
    >
      <!-- Header de sección -->
      <div class="mb-4 laptop:mb-7">
        <h2
          id={`heading-${section.sectionId}`}
          class="text-xs laptop:text-base fhd:text-lg tracking-[0.45em] uppercase font-bold text-[var(--letter-color)] text-glow"
        >
          {section.sectionLabel}
        </h2>
        <div class="text-gradient text-glow gradient-line mt-3 laptop:mt-4" />
      </div>

      <!-- Contenido de sección -->
      <div class="pb-[3rem] laptop:pb-[4rem]">
        {section.sectionId === "about"    && <About    about={aboutData} />}
        {section.sectionId === "resume"   && <Resume   resume={resumeData} />}
        {section.sectionId === "projects" && <Projects projects={projects} />}
        {section.sectionId === "contact"  && <Contact  contact={contactData} socialLinks={socialLinks} />}
      </div>
    </section>
  ))}

</div>