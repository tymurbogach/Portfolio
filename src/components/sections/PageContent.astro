---
import Hero from "./Hero.astro";
import About from "./About.astro";
import Resume from "./Resume.astro";
import Projects from "./Projects.astro";
import Contact from "./Contact.astro";

import {
  getSite,
  getHomeData,
  getAboutData,
  getResumeData,
  getProjects,
  getContactData,
  getSocialLinks,
  getLabeledSections,
  getSectionId,
} from "../../lib/content";

import type { SiteData, NavPage } from "../../lib/content";

// ==========================================
// FETCH (tipado explícito para evitar fallos)
// ==========================================

const site: SiteData = await getSite();
const homeData = await getHomeData();
const aboutData = await getAboutData();
const resumeData = await getResumeData();
const projects = await getProjects();
const contactData = await getContactData();
const socialLinks = await getSocialLinks();

// ==========================================
// SECCIONES
// ==========================================

const labeledSections: NavPage[] = getLabeledSections(site);
---

<div class="flex flex-col w-full">
  <!-- HOME -->
  <section id="home" class="flex items-center justify-center" aria-label="Home">
    <div class="w-full">
      <Hero home={homeData} />
    </div>
  </section>

  {
    labeledSections.map((page) => {
      const sectionId = getSectionId(page.path);

      return (
        <section
          id={sectionId}
          class="pt-[4rem] laptop:pt-[2rem] border-t border-[var(--border-subtle)]"
          aria-labelledby={`heading-${sectionId}`}
        >
          {/* HEADER */}
          <div class="mb-4 laptop:mb-7">
            <h2
              id={`heading-${sectionId}`}
              class="text-xs laptop:text-base fhd:text-lg
                     tracking-[0.45em] uppercase font-bold
                     text-[var(--letter-color)] text-glow"
            >
              {page.sectionLabel}
            </h2>

            <div class="text-gradient text-glow gradient-line mt-3 laptop:mt-4" />
          </div>

          {/* CONTENT */}
          <div class="pb-[3rem] laptop:pb-[4rem]">
            {sectionId === "about" && <About about={aboutData} />}
            {sectionId === "resume" && <Resume resume={resumeData} />}
            {sectionId === "projects" && <Projects projects={projects} />}
            {sectionId === "contact" && (
              <Contact contact={contactData} socialLinks={socialLinks} />
            )}
          </div>
        </section>
      );
    })
  }
</div>
