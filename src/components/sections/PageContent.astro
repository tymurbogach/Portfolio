---
import Hero     from "./Hero.astro";
import About    from "./About.astro";
import Resume   from "./Resume.astro";
import Projects from "./Projects.astro";
import Contact  from "./Contact.astro";
import {
  getSite,
  getHeroData,
  getAboutData,
  getResumeData,
  getProjects,
  getContactData,
  getSocialLinks,
  getLabeledSections,
} from "../../lib/content";
import type { LabeledSection } from "../../lib/content";

const site        = await getSite();
const heroData    = await getHeroData();
const aboutData   = await getAboutData();
const resumeData  = await getResumeData();
const projects    = await getProjects();
const contactData = await getContactData();
const socialLinks = await getSocialLinks();

const sections: LabeledSection[] = getLabeledSections(site);
---

<div class="flex flex-col w-full">

  <!-- HOME -->
  <section
    id="home"
    class="min-h-[calc(100dvh-5.5rem)] mobile:min-h-[calc(100dvh-9rem)]
           pt-[4rem] laptop:pt-0 laptop-scaled:pt-0
           laptop:min-h-0 laptop-scaled:min-h-0
           flex flex-col
           laptop:h-[calc(100vh-12rem)] laptop:max-h-[46rem]
           laptop-scaled:h-[calc(100vh-9rem)] laptop-scaled:max-h-[44rem]
           fhd:h-[calc(100vh-14rem)] fhd:max-h-[44rem]
           qhd:h-[calc(100vh-16rem)] qhd:max-h-[48rem]
           uhd:h-[calc(100vh-18rem)] uhd:max-h-[60rem]"
    aria-label="Home"
  >
    <!-- Label al top — igual que todas las secciones -->
    <div class="mb-3 laptop:mb-4 laptop-scaled:mb-4 shrink-0
                laptop:pt-[2rem] laptop-scaled:pt-[2rem] fhd:pt-[2.5rem]">
      <h2
        class="text-[0.85rem] fhd:text-[0.95rem] qhd:text-base tracking-[0.35em] uppercase font-bold m-0 text-glow"
        style="color: var(--accent);"
      >
        &gt; PORTFOLIO.SYS
      </h2>
      <div class="text-gradient text-glow gradient-line mt-2 laptop:mt-3 laptop-scaled:mt-3" />
    </div>

    <!-- Controls: theme selector + dark/light toggle + visitors -->
    <div class="flex justify-end items-center gap-2 shrink-0 w-full mb-3 laptop:mb-4 laptop-scaled:mb-4">

      <button
        id="color-theme-btn"
        class="inline-flex items-center cursor-pointer
               px-2.5 py-1.5 laptop:px-3 fhd:px-3.5
               rounded-full border border-[var(--border)]
               bg-[var(--card)] opacity-50 can-hover:hover:opacity-100 active:opacity-100
               transition-all duration-200 select-none"
        title="Switch color theme"
        aria-label="Switch color theme"
        type="button"
      >
        <span
          id="theme-name-label"
          class="text-[0.48rem] laptop:text-[0.52rem] fhd:text-[0.6rem]
                 tracking-[0.3em] uppercase font-bold"
          style="color: var(--accent);"
        >CYBER</span>
      </button>

      <button
        id="theme-toggle"
        class="inline-flex items-center justify-center cursor-pointer
               p-[0.35rem] laptop:p-[0.45rem] fhd:p-[0.5rem]
               rounded-full border border-[var(--border)]
               bg-[var(--card)] opacity-50 can-hover:hover:opacity-100 active:opacity-100
               transition-opacity duration-200 select-none"
        title="Toggle dark/light mode"
        aria-label="Toggle dark/light mode"
        type="button"
      >
        <svg id="icon-dark"
             class="w-[0.75rem] h-[0.75rem] laptop:w-[0.85rem] laptop:h-[0.85rem] fhd:w-[0.95rem] fhd:h-[0.95rem]"
             xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
             style="color: var(--accent);">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
        <svg id="icon-light"
             class="w-[0.75rem] h-[0.75rem] laptop:w-[0.85rem] laptop:h-[0.85rem] fhd:w-[0.95rem] fhd:h-[0.95rem]"
             xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
             style="display:none; color: var(--accent);">
          <circle cx="12" cy="12" r="4"/>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
        </svg>
      </button>

      <span id="stat-visitors"
            class="opacity-0 transition-opacity duration-500 font-sans font-normal
                   text-[0.45rem] laptop:text-[0.5rem] fhd:text-[0.55rem] qhd:text-xs uhd:text-sm
                   tracking-[0.25em] uppercase"
            style="color: var(--accent);">
      </span>

    </div>

    <!-- Hero fills all remaining space -->
    <div class="pb-[3rem] laptop:pb-0 laptop-scaled:pb-0 flex-1 min-h-0 flex flex-col">
      <Hero hero={heroData} />
    </div>
  </section>

  <!-- SECCIONES DINÁMICAS -->
  {sections.map((section: LabeledSection) => (
    <section
      id={section.sectionId}
      class="pt-[4rem] laptop:pt-[3rem] laptop-scaled:pt-[3rem]"
      aria-labelledby={`heading-${section.sectionId}`}
    >
      <div class="mb-3 laptop:mb-5 laptop-scaled:mb-5">
        <h2
          id={`heading-${section.sectionId}`}
          class="text-[0.85rem] fhd:text-[0.95rem] qhd:text-base tracking-[0.35em] uppercase font-bold m-0 text-glow"
          style="color: var(--accent);"
        >
          &gt; {section.sectionLabel.toUpperCase()}
        </h2>
        <div class="text-gradient text-glow gradient-line mt-2 laptop:mt-3 laptop-scaled:mt-3" />
      </div>

      <div class="pb-[3rem] laptop:pb-[4rem] laptop-scaled:pb-[4rem]">
        {section.sectionId === "about"    && <About    about={aboutData} />}
        {section.sectionId === "resume"   && <Resume   resume={resumeData} />}
        {section.sectionId === "projects" && <Projects projects={projects} />}
        {section.sectionId === "contact"  && <Contact  contact={contactData} socialLinks={socialLinks} />}
      </div>
    </section>
  ))}

</div>
