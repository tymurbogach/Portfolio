<section class="flex flex-col gap-10 laptop:gap-12 w-full">

  <!-- Journey -->
  <div class="flex flex-col gap-5">
    <h3 class="text-[0.6rem] tracking-[0.5em] uppercase font-bold opacity-40">Journey</h3>
    <div class="flex flex-col">
      {[
        {
          year: "2012 — 17",
          event: "Mechanic & Paint Tech",
          detail: "Renault Trucks and others. Multi-brand repair, painting and diagnostics across commercial vehicles.",
          active: false,
        },
        {
          year: "2017 — 24",
          event: "Body & Paint — Grupo Marcos",
          detail: "High-precision automotive body repair and refinishing. Built precision and team coordination over 7 years.",
          active: false,
        },
        {
          year: "2022",
          event: "Switched to code",
          detail: "Started web development from zero. HTML first, then deeper into JS, TypeScript, and frameworks.",
          active: false,
        },
        {
          year: "2023",
          event: "Homelab phase begins",
          detail: "Self-hosted everything: Docker stacks, TrueNAS, Nginx, Raspberry Pi, Tailscale VPN mesh.",
          active: false,
        },
        {
          year: "2025",
          event: "GesinFlot — Dev Team",
          detail: "Mobile app development with Android Studio, UI/UX design, API integration and APK deployment.",
          active: false,
        },
        {
          year: "Now",
          event: "Full Stack Developer",
          detail: "Building, learning, shipping. Looking for the right team.",
          active: true,
        },
      ].map(({ year, event, detail, active }, i, arr) => (
        <div class="flex gap-4 laptop:gap-6">
          <div class="flex flex-col items-center shrink-0 pt-[3px]">
            <div class="w-[7px] h-[7px] rounded-full border-2 shrink-0 z-10"
                 style={active
                   ? "border-color: var(--accent-color); background: var(--accent-color);"
                   : "border-color: var(--border-color); background: var(--page-background);"}>
            </div>
            {i < arr.length - 1 && (
              <div class="w-px flex-1 my-1" style="background: var(--border-subtle);"></div>
            )}
          </div>
          <div class={`pb-5 ${i === arr.length - 1 ? 'pb-0' : ''}`}>
            <div class="flex items-baseline flex-wrap gap-x-3 mb-1">
              <span class="text-[0.55rem] tracking-[0.2em] uppercase opacity-35 font-bold whitespace-nowrap">{year}</span>
              <span class="text-sm laptop:text-base font-bold"
                    style={active ? 'color: var(--accent-color)' : ''}>{event}</span>
            </div>
            <p class="text-xs laptop:text-sm opacity-55 leading-relaxed">{detail}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Education -->
  <div class="flex flex-col gap-4">
    <h3 class="text-[0.6rem] tracking-[0.5em] uppercase font-bold opacity-40">Education</h3>
    <div class="flex flex-col gap-2">
      {[
        {
          years: "2023 — 2025",
          title: "Advanced Technical Certificate",
          sub: "Web Application Development · EFA El Campico",
        },
        {
          years: "2008 — 2011",
          title: "Technical Qualification",
          sub: "Automotive Bodywork & Refinishing · IES El Palmeral",
        },
      ].map(({ years, title, sub }) => (
        <div class="flex gap-4 items-start px-4 py-3
                    border border-[var(--border-subtle)] bg-[var(--surface-raised)]">
          <span class="text-[0.5rem] tracking-[0.15em] uppercase opacity-35 font-bold whitespace-nowrap mt-0.5 shrink-0">{years}</span>
          <div>
            <p class="text-sm font-bold leading-snug">{title}</p>
            <p class="text-[0.58rem] tracking-[0.1em] uppercase opacity-45 mt-0.5">{sub}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- When not coding -->
  <div class="flex flex-col gap-4">
    <h3 class="text-[0.6rem] tracking-[0.5em] uppercase font-bold opacity-40">When not coding</h3>
    <div class="grid grid-cols-2 mobile:grid-cols-4 gap-2 laptop:gap-3">
      {[
        { icon: "🎵", label: "Music" },
        { icon: "🖥",  label: "Self-hosting" },
        { icon: "🎸", label: "Guitar" },
        { icon: "🌙", label: "Late nights" },
      ].map(({ icon, label }) => (
        <div class="flex items-center gap-3 px-4 py-3 border border-[var(--border-subtle)]
                    text-sm laptop:text-base opacity-65 bg-[var(--surface-raised)]">
          <span class="text-base">{icon}</span>
          <span class="tracking-[0.1em]">{label}</span>
        </div>
      ))}
    </div>
  </div>

  <!-- Location + Quote -->
  <div class="flex flex-col gap-6">
    <div class="flex items-center gap-3 text-xs laptop:text-sm opacity-50 tracking-[0.2em] uppercase">
      <span>📍</span>
      <span>Orihuela, Alicante — Spain</span>
    </div>

    <blockquote class="border-l-2 pl-5 laptop:pl-7"
                style="border-color: var(--accent-color)">
      <p class="italic leading-relaxed text-sm mobile:text-base laptop:text-lg fhd:text-xl opacity-75">
        "Following the white rabbit, choosing the right Morpheus pill, and eating the Oracle cookie."
      </p>
      <p class="mt-2 text-[0.65rem] not-italic opacity-35 tracking-widest">— Hope you get the reference.</p>
    </blockquote>
  </div>

</section>
