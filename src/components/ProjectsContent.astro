---
import { getEntry } from "astro:content";
import ProjectCard from "../components/ProjectCard.astro";

const projectsEntry = await getEntry("projects", "data");

if (!projectsEntry) {
  throw new Error("No se encontró src/content/projects/data.json");
}

const projects = projectsEntry.data.projects;
---

<div class="flex flex-col gap-3 w-full">
  {
    projects.map((project) => {
      const isDemo =
        project.link?.includes("github.io") ||
        project.link?.includes("netlify") ||
        project.link?.includes("vercel");

      const tags = project.tags || [];

      return (
        <ProjectCard
          title={project.title}
          description={project.description}
          link={project.link}
          image={project.image}
          type={isDemo ? "demo" : "source"}
          tags={tags}
        />
      );
    })
  }
</div>
