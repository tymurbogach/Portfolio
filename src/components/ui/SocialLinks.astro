---
import { getSocialLinks } from "../../lib/content";
import type { SocialLink } from "../../lib/content";
const socialLinks = await getSocialLinks();
---

<div
  class="w-full h-[2.5rem]
  mobile:w-[20rem] mobile:h-[4.5rem]
  tablet:w-[20rem] tablet:h-[4.5rem]
  laptop:w-[25rem] laptop:h-[5rem]
  fhd:w-[30rem] fhd:h-[5.5rem]
  qhd:w-[35rem] qhd:h-[6rem]
  uhd:w-[40rem] uhd:h-[6.5rem]"
>
  <div class="nav-panel flex flex-row items-center justify-center text-center w-full h-full">
    {
      socialLinks.map(({ url, icon, name }: SocialLink) => (
        <a
          href={url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={name}
          class="group flex flex-col items-center justify-center h-full flex-1
               text-[var(--foreground)] px-[0.75rem]
               transition-all duration-250 ease-in-out
               can-hover:hover:bg-[var(--secondary)] can-hover:hover:text-[var(--secondary-foreground)]"
        >
          <!-- CSS mask like NavBar: color comes from bg-, not the img src -->
        <span
          class="mask-icon inline-block shrink-0
                 bg-[var(--foreground)] can-hover:group-hover:bg-[var(--secondary-foreground)]
                 opacity-70 can-hover:group-hover:opacity-100
                 transition-all duration-200
                 can-hover:group-hover:scale-125 can-hover:group-hover:drop-shadow-sm"
          style={`--icon-url: url('${icon}'); width: var(--nav-icon-size); height: var(--nav-icon-size);`}
          aria-hidden="true"
        />
      </a>
    ))}
  </div>
</div>