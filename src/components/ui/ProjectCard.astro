---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Icon from "./Icon.astro";

/** Project card: renders as an external link when `link` is set, otherwise as a static card. */
interface Props {
  title:       string;
  description: string;
  link?:       string;
  /** Local image (optimized via astro:assets) or remote URL (rendered as-is). */
  image?:      ImageMetadata | string;
  type?:       "source" | "demo";
  tags?:       string[];
  year?:       string;
  role?:       string;
  index?:      number;
}

const {
  title,
  description,
  link,
  image,
  type = "source",
  tags = [],
  year,
  role,
  index = 0,
} = Astro.props;

const isDemo   = type === "demo";
const indexStr = String(index).padStart(2, "0");
const visibleTags = tags.filter((t) => t !== "Self-hosted");

/* "2025 · full stack" — el contexto que la ficha no daba. */
const context = [year, role].filter(Boolean).join(" · ");
/* Dominio limpio como pie de la tarjeta: dice a dónde lleva antes de pulsar. */
const host = link ? new URL(link).hostname.replace(/^www\./, "") : "";

/* Linked cards get hover affordances; static cards stay inert. */
const Tag = link ? "a" : "div";
const linkAttrs = link ? { href: link, target: "_blank", rel: "noopener noreferrer" } : {};

/** Maps project tags to simple-icons slugs; unmapped tags render as plain text badges. */
const TAG_SLUGS: Record<string, { slug: string; color?: string }> = {
  "Angular":     { slug: "angular",      color: "#DD0031" },
  "Laravel":     { slug: "laravel" },
  "TypeScript":  { slug: "typescript" },
  "JavaScript":  { slug: "javascript" },
  "Docker":      { slug: "docker" },
  "HTML":        { slug: "html5" },
  "CSS":         { slug: "css" },
  "PHP":         { slug: "php" },
  "MySQL":       { slug: "mysql" },
  "PostgreSQL":  { slug: "postgresql" },
  "Vue":         { slug: "vuedotjs" },
  "React":       { slug: "react" },
  "Node":        { slug: "nodedotjs" },
  "Python":      { slug: "python" },
  "Astro":       { slug: "astro" },
  "Tailwind":    { slug: "tailwindcss" },
  "TailwindCSS": { slug: "tailwindcss" },
  "API":         { slug: "postman" },
};

const badgeBase =
  "font-hud absolute z-20 text-[0.62rem] fhd:text-[0.7rem] qhd:text-[0.78rem] uhd:text-xs " +
  "tracking-[0.18em] px-2.5 py-1 font-bold uppercase rounded-[var(--radius)]";
---

<Tag
  {...linkAttrs}
  class:list={[
    "relative group flex flex-col overflow-hidden rounded-lg bg-[var(--card)]",
    "border border-[var(--border)] transition-all duration-300",
    link && "can-hover:hover:border-[var(--accent)] hover-glow",
  ]}
>
  <!-- Image — top -->
  <div class="relative w-full aspect-video overflow-hidden shrink-0 bg-[var(--muted)]">

    <span class:list={[badgeBase, "top-3 left-3 bg-[var(--primary)] text-[var(--primary-foreground)]"]}>
      {isDemo ? "● live" : "⌥ src"}
    </span>

    {tags.includes("Self-hosted") && (
      <span
        class:list={[
          badgeBase,
          "top-3 right-3 border border-[var(--accent)] text-[var(--accent)] bg-[var(--overlay)]",
        ]}
      >self-hosted</span>
    )}

    {image ? (
      <>
        {typeof image === "string" ? (
          <img
            src={image}
            alt={`${title} — interfaz`}
            loading="lazy"
            class:list={[
              "w-full h-full object-cover object-top saturate-50 brightness-75",
              "transition-[filter] duration-500",
              link && "can-hover:group-hover:saturate-100 can-hover:group-hover:brightness-100",
            ]}
          />
        ) : (
          <Image
            src={image}
            alt={`${title} — interfaz`}
            width={768}
            loading="lazy"
            class:list={[
              "w-full h-full object-cover object-top saturate-50 brightness-75",
              "transition-[filter] duration-500",
              link && "can-hover:group-hover:saturate-100 can-hover:group-hover:brightness-100",
            ]}
          />
        )}
        <!-- Tinte del tema: se desvanece en hover para revelar el color real -->
        <div
          class:list={[
            "image-tint absolute inset-0 z-10 pointer-events-none transition-opacity duration-500",
            link && "can-hover:group-hover:opacity-0",
          ]}
          aria-hidden="true"
        />
      </>
    ) : (
      <div
        class:list={[
          "image-tint w-full h-full flex flex-col items-center justify-center gap-2",
          link && "transition-opacity duration-300 can-hover:group-hover:opacity-80",
        ]}
      >
        <span class="font-display text-5xl fhd:text-6xl text-[var(--accent)] opacity-30 leading-none">{indexStr}</span>
        <span class="font-hud text-[0.62rem] fhd:text-[0.7rem] tracking-[0.2em] uppercase font-bold text-center px-3 text-[var(--foreground-faint)]">
          {title}
        </span>
      </div>
    )}
  </div>

  <!-- Content — bottom -->
  <div class="relative z-[1] flex flex-col flex-1 gap-3 p-4 fhd:p-5 bg-[var(--card)]">

    <div class="flex flex-col gap-1.5">
      <div class="flex items-baseline justify-between gap-3">
        <h3
          class:list={[
            "font-display text-lg mobile:text-xl laptop:text-[1.35rem] fhd:text-2xl qhd:text-3xl uhd:text-4xl",
            "tracking-[0.02em] leading-none m-0",
            link && "transition-colors duration-200 can-hover:group-hover:text-[var(--accent)]",
          ]}
        >
          {title}
        </h3>
        {context && (
          <span class="font-hud text-[0.65rem] fhd:text-[0.72rem] qhd:text-[0.8rem] uhd:text-sm
                       tracking-[0.16em] whitespace-nowrap shrink-0 text-[var(--foreground-faint)]">
            {context}
          </span>
        )}
      </div>
      <p class="text-[0.8rem] fhd:text-[0.9rem] qhd:text-base uhd:text-lg leading-relaxed m-0
                line-clamp-3 text-[var(--muted-foreground)]">
        {description}
      </p>
    </div>

    {visibleTags.length > 0 && (
      <div class="flex flex-col gap-2 pt-3 border-t border-[var(--border-subtle)]">
        <span class="cat-label text-[var(--foreground-faint)]">Built with</span>
        <div class="flex flex-wrap gap-1.5">
          {visibleTags.map((tag) => {
            const entry = TAG_SLUGS[tag];
            return (
              <span class="skill-chip">
                {entry && (
                  <Icon slug={entry.slug} color={entry.color} size={13} label={tag} tone="mono"
                        class="fhd:!w-4 fhd:!h-4 qhd:!w-5 qhd:!h-5" />
                )}
                <span class="chip-label">{tag}</span>
              </span>
            );
          })}
        </div>
      </div>
    )}

    {link && (
      <div class="flex items-center justify-between gap-3 mt-auto pt-1">
        <span class="font-hud text-[0.65rem] fhd:text-[0.72rem] qhd:text-[0.8rem] uhd:text-sm
                     tracking-[0.06em] truncate text-[var(--foreground-faint)]">
          {host}
        </span>
        <span
          class="font-hud flex items-center gap-1.5 shrink-0
                 text-[0.68rem] fhd:text-[0.78rem] qhd:text-[0.85rem] uhd:text-base
                 tracking-[0.2em] uppercase font-bold text-[var(--accent)]"
        >
          {isDemo ? "demo" : "code"}
          <span class="transition-transform duration-300 can-hover:group-hover:translate-x-1">→</span>
        </span>
      </div>
    )}
  </div>
</Tag>
