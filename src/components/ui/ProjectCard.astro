---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Icon from "./Icon.astro";

/** Project card: renders as an external link when `link` is set, otherwise as a static card. */
interface Props {
  title: string;
  description: string;
  link?: string;
  /** Local image (optimized via astro:assets) or remote URL (rendered as-is). */
  image?: ImageMetadata | string;
  type?: "source" | "demo";
  tags?: string[];
  year?: string;
  role?: string;
  githubStars?: number;
  index?: number;
}

const {
  title,
  description,
  link,
  image,
  type = "source",
  tags = [],
  year,
  role,
  githubStars,
  index = 0,
} = Astro.props;

const isDemo = type === "demo";
const indexStr = String(index).padStart(2, "0");
const visibleTags = tags.filter((t) => t !== "Self-hosted");

/* Dominio limpio como pie de la tarjeta: dice a dónde lleva antes de pulsar. */
const host = link ? new URL(link).hostname.replace(/^www\./, "") : "";

/* Linked cards get hover affordances; static cards stay inert. */
const Tag = link ? "a" : "div";
const linkAttrs = link
  ? { href: link, target: "_blank", rel: "noopener noreferrer" }
  : {};

/** Maps project tags to simple-icons slugs; unmapped tags render as plain text badges. */
const TAG_SLUGS: Record<string, { slug: string; color?: string }> = {
  Angular: { slug: "angular", color: "#DD0031" },
  Laravel: { slug: "laravel" },
  TypeScript: { slug: "typescript" },
  JavaScript: { slug: "javascript" },
  Docker: { slug: "docker" },
  HTML: { slug: "html5" },
  CSS: { slug: "css" },
  PHP: { slug: "php" },
  MySQL: { slug: "mysql" },
  PostgreSQL: { slug: "postgresql" },
  Vue: { slug: "vuedotjs" },
  React: { slug: "react" },
  Node: { slug: "nodedotjs" },
  Python: { slug: "python" },
  Bash: { slug: "gnubash" },
  "Qt/QML": { slug: "qt" },
  SQLite: { slug: "sqlite" },
  Hyprland: { slug: "hyprland" },
  Astro: { slug: "astro" },
  Tailwind: { slug: "tailwindcss" },
  TailwindCSS: { slug: "tailwindcss" },
  API: { slug: "postman" },
};

const badgeBase =
  "project-badge font-hud absolute z-20 uppercase rounded-[var(--radius)]";
---

<Tag
  {...linkAttrs}
  class:list={[
    "project-card relative group flex h-full flex-col overflow-hidden rounded-lg bg-[var(--card)]",
    "border border-[var(--border)] transition-[border-color,box-shadow,transform] duration-300",
    link &&
      "can-hover:hover:border-[var(--accent)] can-hover:hover:-translate-y-1 hover-glow",
  ]}
>
  <!-- Image — top -->
  <div class="relative w-full aspect-video overflow-hidden shrink-0 bg-[var(--muted)]">
    <span
      class:list={[
        badgeBase,
        "top-1.5 left-1.5 border border-[color-mix(in_srgb,var(--primary)_65%,transparent)] bg-[color-mix(in_srgb,var(--background)_72%,transparent)] text-[var(--primary)]",
      ]}
    >
      {isDemo ? "live" : "src"}
    </span>

    {githubStars !== undefined ? (
      <span
        class:list={[
          badgeBase,
          "top-1.5 right-1.5 flex items-center gap-0.5 border border-[var(--border-subtle)] bg-[color-mix(in_srgb,var(--background)_72%,transparent)] text-[var(--accent)]",
        ]}
        aria-label={`${githubStars} GitHub stars`}
      >
        <Icon slug="github" size={13} label="GitHub" tone="mono" />
        {githubStars}
      </span>
    ) : (
      tags.includes("Self-hosted") && (
        <span
          class:list={[
            badgeBase,
            "top-1.5 right-1.5 border border-[color-mix(in_srgb,var(--accent)_55%,transparent)] text-[var(--accent)] bg-[color-mix(in_srgb,var(--background)_72%,transparent)]",
          ]}
        >
          self-hosted
        </span>
      )
    )}

    {image ? (
      <>
        {typeof image === "string" ? (
          <img
            src={image}
            alt={`${title} — interfaz`}
            loading="lazy"
            class:list={[
              "w-full h-full object-cover object-top saturate-50 brightness-75",
              "transition-[filter] duration-500",
              link &&
                "can-hover:group-hover:saturate-100 can-hover:group-hover:brightness-100",
            ]}
          />
        ) : (
          <Image
            src={image}
            alt={`${title} — interfaz`}
            width={768}
            loading="lazy"
            class:list={[
              "w-full h-full object-cover object-top saturate-50 brightness-75",
              "transition-[filter] duration-500",
              link &&
                "can-hover:group-hover:saturate-100 can-hover:group-hover:brightness-100",
            ]}
          />
        )}
        <!-- Tinte del tema: se desvanece en hover para revelar el color real -->
        <div
          class:list={[
            "image-tint absolute inset-0 z-10 pointer-events-none transition-opacity duration-500",
            link && "can-hover:group-hover:opacity-0",
          ]}
          aria-hidden="true"
        />
      </>
    ) : (
      <div
        class:list={[
          "image-tint w-full h-full flex flex-col items-center justify-center gap-2",
          link &&
            "transition-opacity duration-300 can-hover:group-hover:opacity-80",
        ]}
      >
        <span class="font-display text-[clamp(3rem,4vw,4rem)] text-[var(--accent)] opacity-30 leading-none">
          {indexStr}
        </span>
        <span class="font-hud text-[var(--type-meta)] tracking-[0.2em] uppercase font-bold text-center px-3 text-[var(--foreground-faint)]">
          {title}
        </span>
      </div>
    )}
  </div>

  <!-- Content — bottom -->
  <div class="project-card__body relative z-[1] flex-1 bg-[var(--card)]">
    <div class="project-card__header">
      <div class="project-card__title-slot">
        <h3
          class:list={[
            "project-card__title font-display font-semibold text-[1.35rem] mobile:text-[1.6rem] laptop:text-[calc(var(--type-heading)*1.05)]",
            "tracking-[0.01em] leading-[1.05] text-balance m-0",
            link &&
              "transition-colors duration-200 can-hover:group-hover:text-[var(--accent)]",
          ]}
          title={title}
        >
          {title}
        </h3>
      </div>

      <div class="project-card__meta" aria-label="Project metadata">
        {year && <span>{year}</span>}
        {year && role && <span aria-hidden="true">·</span>}
        {role && <span>{role}</span>}
      </div>
    </div>

    <p class="project-card__description text-[var(--muted-foreground)]">
      {description}
    </p>

    {visibleTags.length > 0 && (
      <div class="project-card__tech">
        <span class="cat-label text-[var(--foreground-faint)]">Built with</span>
        <div class="project-card__tags">
          {visibleTags.map((tag) => {
            const entry = TAG_SLUGS[tag];
            return (
              <span class="skill-chip">
                {entry && (
                  <Icon
                    slug={entry.slug}
                    color={entry.color}
                    size={13}
                    label={tag}
                    tone="mono"
                  />
                )}
                <span class="chip-label">{tag}</span>
              </span>
            );
          })}
        </div>
      </div>
    )}

    {link && (
      <div class="project-card__footer">
        <span
          class="font-hud min-w-0 font-normal text-[var(--type-meta)]
                     tracking-[0.06em] truncate text-[var(--muted-foreground)]"
        >
          {host}
        </span>
        <span
          class="font-hud flex items-center gap-1.5 shrink-0
                 text-[var(--type-meta)]
                 tracking-[0.2em] uppercase font-bold text-[var(--accent)]"
        >
          {isDemo ? "demo" : "code"}
          <span class="transition-transform duration-300 can-hover:group-hover:translate-x-1">
            →
          </span>
        </span>
      </div>
    )}
  </div>
</Tag>
