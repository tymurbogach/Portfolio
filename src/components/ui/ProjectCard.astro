---
import Icon from "./Icon.astro";

interface Props {
  title:       string;
  description: string;
  link?:       string;
  image?:      string;
  type?:       "source" | "demo";
  tags?:       string[];
  index?:      number;
}

const {
  title,
  description,
  link,
  image,
  type = "source",
  tags = [],
  index = 0,
} = Astro.props;

const isDemo   = type === "demo";
const indexStr = String(index).padStart(2, "0");
const hoverBorder = link ? "can-hover:hover:border-[var(--accent-color)]" : "";
const cardClass = `group flex flex-col overflow-hidden border border-[var(--border-color)] ${hoverBorder} transition-all duration-300`;

const TAG_SLUGS: Record<string, { slug: string; color?: string }> = {
  "Angular":     { slug: "angular",      color: "#DD0031" },
  "Laravel":     { slug: "laravel" },
  "TypeScript":  { slug: "typescript" },
  "JavaScript":  { slug: "javascript" },
  "Docker":      { slug: "docker" },
  "HTML":        { slug: "html5" },
  "CSS":         { slug: "css"},
  "PHP":         { slug: "php" },
  "MySQL":       { slug: "mysql" },
  "PostgreSQL":  { slug: "postgresql" },
  "Vue":         { slug: "vuedotjs" },
  "React":       { slug: "react" },
  "Node":        { slug: "nodedotjs" },
  "Python":      { slug: "python" },
  "Astro":       { slug: "astro" },
  "Tailwind":    { slug: "tailwindcss" },
  "TailwindCSS": { slug: "tailwindcss" },
  "API":         { slug: "postman"},
};
---

{link ? (
<a
  href={link}
  target="_blank"
  rel="noopener noreferrer"
  class={cardClass}
  style="position: relative;"
>
  <!-- Large muted index — background element -->
  <span
    class="font-display absolute pointer-events-none select-none"
    style="right: 0.5rem; bottom: -0.25rem;
           font-size: clamp(3rem, 5vw, 4rem);
           line-height: 1;
           color: var(--letter-color);
           opacity: 0.04;
           z-index: 0;"
    aria-hidden="true"
  >{indexStr}</span>

  <!-- Image — top -->
  <div class="relative w-full overflow-hidden shrink-0 bg-[var(--component-background)]" style="aspect-ratio: 16/9;">

    <!-- Badge -->
    <span
      class="absolute top-2 left-3 z-20
             text-[0.42rem] fhd:text-[0.55rem] qhd:text-[0.65rem] uhd:text-xs tracking-[0.2em] px-2 py-0.5 font-bold uppercase
             border border-[var(--border-subtle)] bg-[var(--page-background)]"
      style={`opacity: 0.85; color: ${isDemo ? "var(--accent-color)" : "var(--accent-secondary)"};`}
    >
      {isDemo ? "● live" : "⌥ src"}
    </span>

    {image ? (
      <img
        src={image}
        alt={title}
        loading="lazy"
        class="w-full h-full object-cover
               transition-opacity duration-300
               can-hover:group-hover:opacity-80"
      />
    ) : (
      <div
        class="w-full h-full flex flex-col items-center justify-center gap-2
               bg-[var(--component-background)] can-hover:group-hover:bg-[var(--surface-raised)]
               transition-colors duration-300"
      >
        <span
          class="font-display text-4xl"
          style="color: var(--accent-color); opacity: 0.25;"
        >{indexStr}</span>
        <span class="text-[0.42rem] fhd:text-[0.55rem] qhd:text-[0.65rem] tracking-[0.15em] uppercase font-bold text-center px-3 leading-relaxed"
              style="opacity: 0.25;">
          {title}
        </span>
      </div>
    )}
  </div>

  <!-- Content — bottom -->
  <div
    class="flex flex-col flex-1 px-3 py-3 gap-2
           bg-[var(--page-background)] can-hover:group-hover:bg-[var(--surface-raised)]
           transition-colors duration-200 overflow-hidden"
    style="position: relative; z-index: 1;"
  >
    <!-- Title + description -->
    <div class="flex flex-col gap-1">
      <div class="flex items-center gap-2">
        <h3 class="font-display text-sm mobile:text-base laptop:text-lg fhd:text-xl qhd:text-2xl uhd:text-3xl tracking-[0.05em] leading-none m-0">
          {title}
        </h3>
        {tags.includes("Self-hosted") && (
          <span
            class="text-[0.32rem] fhd:text-[0.38rem] tracking-[0.15em] px-1.5 py-0.5 uppercase font-bold shrink-0"
            style="border: 1px solid var(--accent-color); color: var(--accent-color); opacity: 0.55;"
          >self-hosted</span>
        )}
      </div>
      <p
        class="text-[0.65rem] fhd:text-xs qhd:text-sm uhd:text-base leading-relaxed overflow-hidden m-0"
        style="opacity: 0.55; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical;"
      >
        {description}
      </p>
    </div>

    <!-- Stack + link -->
    <div class="flex items-end justify-between gap-2 mt-auto">
      {tags.length > 0 && (
        <div class="flex flex-col gap-1">
          <span
            class="text-[0.38rem] fhd:text-[0.45rem] tracking-[0.2em] uppercase font-bold"
            style="color: var(--accent-color); opacity: 0.55;"
          >built with</span>
          <div class="flex flex-wrap gap-x-2 gap-y-1 items-end">
            {tags.filter((t: string) => t !== "Self-hosted").map((tag: string) => {
              const entry = TAG_SLUGS[tag];
              return entry ? (
                <div class="flex flex-col items-center gap-[2px]">
                  <Icon
                    slug={entry.slug}
                    color={entry.color}
                    size={12}
                    label={tag}
                    class="fhd:!w-4 fhd:!h-4 qhd:!w-5 qhd:!h-5 uhd:!w-6 uhd:!h-6"
                  />
                  <span
                    class="text-[0.32rem] fhd:text-[0.38rem] tracking-[0.08em] uppercase font-bold leading-none"
                    style="opacity: 0.40;"
                  >{tag}</span>
                </div>
              ) : (
                <span
                  class="text-[0.38rem] fhd:text-[0.48rem] tracking-[0.1em] px-1.5 py-0.5 uppercase font-bold self-end"
                  style="border: 1px solid var(--border-color); opacity: 0.4;"
                >{tag}</span>
              );
            })}
          </div>
        </div>
      )}
      <span
        class="flex items-center gap-1 text-[0.48rem] fhd:text-xs qhd:text-sm uhd:text-base tracking-[0.25em] uppercase font-bold
               transition-opacity duration-300 ml-auto shrink-0 self-end pb-0.5"
        style="color: var(--accent-color); opacity: 0.4;"
      >
        {isDemo ? "demo" : "code"}
        <span class="transition-transform duration-300 can-hover:group-hover:translate-x-1">→</span>
      </span>
    </div>
  </div>
</a>
) : (
<div
  class={cardClass}
  style="position: relative;"
>
  <!-- Large muted index — background element -->
  <span
    class="font-display absolute pointer-events-none select-none"
    style="right: 0.5rem; bottom: -0.25rem;
           font-size: clamp(3rem, 5vw, 4rem);
           line-height: 1;
           color: var(--letter-color);
           opacity: 0.04;
           z-index: 0;"
    aria-hidden="true"
  >{indexStr}</span>

  <!-- Image — top -->
  <div class="relative w-full overflow-hidden shrink-0 bg-[var(--component-background)]" style="aspect-ratio: 16/9;">

    <!-- Badge -->
    <span
      class="absolute top-2 left-3 z-20
             text-[0.42rem] fhd:text-[0.55rem] qhd:text-[0.65rem] uhd:text-xs tracking-[0.2em] px-2 py-0.5 font-bold uppercase
             border border-[var(--border-subtle)] bg-[var(--page-background)]"
      style={`opacity: 0.85; color: ${isDemo ? "var(--accent-color)" : "var(--accent-secondary)"};`}
    >
      {isDemo ? "● live" : "⌥ src"}
    </span>

    {image ? (
      <img
        src={image}
        alt={title}
        loading="lazy"
        class="w-full h-full object-cover"
      />
    ) : (
      <div
        class="w-full h-full flex flex-col items-center justify-center gap-2
               bg-[var(--component-background)]"
      >
        <span
          class="font-display text-4xl"
          style="color: var(--accent-color); opacity: 0.25;"
        >{indexStr}</span>
        <span class="text-[0.42rem] fhd:text-[0.55rem] qhd:text-[0.65rem] tracking-[0.15em] uppercase font-bold text-center px-3 leading-relaxed"
              style="opacity: 0.25;">
          {title}
        </span>
      </div>
    )}
  </div>

  <!-- Content — bottom -->
  <div
    class="flex flex-col flex-1 px-3 py-3 gap-2
           bg-[var(--page-background)]
           transition-colors duration-200 overflow-hidden"
    style="position: relative; z-index: 1;"
  >
    <!-- Title + description -->
    <div class="flex flex-col gap-1">
      <div class="flex items-center gap-2">
        <h3 class="font-display text-sm mobile:text-base laptop:text-lg fhd:text-xl qhd:text-2xl uhd:text-3xl tracking-[0.05em] leading-none m-0">
          {title}
        </h3>
        {tags.includes("Self-hosted") && (
          <span
            class="text-[0.32rem] fhd:text-[0.38rem] tracking-[0.15em] px-1.5 py-0.5 uppercase font-bold shrink-0"
            style="border: 1px solid var(--accent-color); color: var(--accent-color); opacity: 0.55;"
          >self-hosted</span>
        )}
      </div>
      <p
        class="text-[0.65rem] fhd:text-xs qhd:text-sm uhd:text-base leading-relaxed overflow-hidden m-0"
        style="opacity: 0.55; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical;"
      >
        {description}
      </p>
    </div>

    <!-- Stack -->
    {tags.length > 0 && (
      <div class="flex flex-col gap-1 mt-auto">
        <span
          class="text-[0.38rem] fhd:text-[0.45rem] tracking-[0.2em] uppercase font-bold"
          style="color: var(--accent-color); opacity: 0.5;"
        >built with</span>
        <div class="flex flex-wrap gap-x-2 gap-y-1 items-end">
          {tags.filter((t: string) => t !== "Self-hosted").map((tag: string) => {
            const entry = TAG_SLUGS[tag];
            return entry ? (
              <div class="flex flex-col items-center gap-[2px]">
                <Icon
                  slug={entry.slug}
                  color={entry.color}
                  size={12}
                  label={tag}
                  class="fhd:!w-4 fhd:!h-4 qhd:!w-5 qhd:!h-5"
                />
                <span
                  class="text-[0.32rem] fhd:text-[0.38rem] tracking-[0.08em] uppercase font-bold leading-none"
                  style="opacity: 0.35;"
                >{tag}</span>
              </div>
            ) : (
              <span
                class="text-[0.38rem] fhd:text-[0.48rem] tracking-[0.1em] px-1.5 py-0.5 uppercase font-bold"
                style="border: 1px solid var(--border-color); opacity: 0.4;"
              >{tag}</span>
            );
          })}
        </div>
      </div>
    )}
  </div>
</div>
)}
