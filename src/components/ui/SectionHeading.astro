---
/* Encabezado de sección: etiqueta tiny-caps + línea divisora con tono del acento. */

export interface Props {
  label: string;
}

const { label } = Astro.props;
---

<div class="flex items-center gap-3">
  <h2 class="cat-label shrink-0" style="color: var(--primary);">
    {label}
  </h2>
  <div class="flex-1 h-px opacity-30" style="background: var(--gradient-border);" />
</div>