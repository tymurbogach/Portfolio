---
interface Props {
  downloadHref: string;
}

const { downloadHref } = Astro.props;
---

<div id="cv-modal" class="cv-modal">
  <div class="cv-modal-inner">

    <div class="cv-modal-toolbar">
      <a
        id="cv-download-btn"
        href={downloadHref}
        download="Tymur_Bogach_CV.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center px-5 py-2
               text-[0.6rem] tracking-[0.3em] uppercase font-bold
               border border-[var(--accent-color)] text-[var(--accent-color)] bg-transparent
               transition-all duration-200
               hover:bg-[var(--accent-color)] hover:text-[#0a0a0a]"
      >
        Download PDF
      </a>
      <button
        id="cv-close-btn"
        class="inline-flex items-center px-5 py-2
               text-[0.6rem] tracking-[0.3em] uppercase font-bold
               border border-[rgba(255,255,255,0.2)] text-[rgba(255,255,255,0.8)] bg-transparent
               transition-all duration-200
               hover:border-[rgba(255,255,255,0.8)] hover:text-[#ffffff]"
      >
        ✕ Close
      </button>
    </div>

    <iframe
      id="cv-iframe"
      src=""
      class="cv-modal-iframe"
      allow="autoplay"
    />

  </div>
</div>

<style>
  .cv-modal {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 200;
    background: rgba(0, 0, 0, 0.95);
    backdrop-filter: blur(6px);
  }
  .cv-modal-inner {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
  }
  .cv-modal-toolbar {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 12px;
    padding: 16px 24px;
    flex-shrink: 0;
  }
  .cv-modal-iframe {
    flex: 1;
    border: none;
    width: 100%;
  }
  @keyframes modal-in {
    from { opacity: 0; transform: scale(0.97); }
    to   { opacity: 1; transform: scale(1);    }
  }
  #cv-modal[data-open="true"] {
    animation: modal-in 180ms ease-out both;
  }
</style>