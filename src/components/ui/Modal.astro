---
import DownloadIcon from "./DownloadIcon.astro";

/** CV modal: lazy-loads the PDF into an iframe on first open (cvModal.ts). */
interface Props {
  id?:        string;
  titleLabel: string;
}

const { id = "cv-modal", titleLabel } = Astro.props;
---

<script>
  import "../../scripts/cvModal";
</script>

<div
  id={id}
  data-open="false"
  class="fixed inset-0 z-50 flex items-center justify-center p-4"
  style="pointer-events: none;"
  role="dialog"
  aria-modal="true"
  aria-label={titleLabel}
  aria-hidden="true"
>
  <!-- Backdrop -->
  <div
    id="cv-modal-backdrop"
    class="absolute inset-0 transition-opacity duration-300"
    style="background: var(--overlay); backdrop-filter: blur(4px); opacity: 0;"
  />

  <!-- Panel -->
  <div
    class="relative flex flex-col w-full max-w-4xl fhd:max-w-6xl
           border border-[var(--border)]
           bg-[var(--card)]
           transition-all duration-300 overflow-hidden"
    style="
      height: min(90vh, 72rem);
      transform: scale(0.95);
      opacity: 0;
    "
    id="cv-modal-panel"
  >

    <!-- Header -->
    <div class="flex items-center justify-between px-4 py-2 shrink-0 border-b border-[var(--border)]">
      <span class="text-[0.5rem] laptop:text-[0.6rem] fhd:text-xs tracking-[0.35em] uppercase font-bold opacity-40">
        &gt; {titleLabel}
      </span>
      <div class="flex items-center gap-3">
        <a
          id="cv-modal-download"
          href="#"
          download
          class="flex items-center gap-1.5
                 text-[0.48rem] laptop:text-[0.55rem] fhd:text-xs tracking-[0.25em] uppercase font-bold
                 text-[var(--accent)] opacity-70
                 can-hover:hover:opacity-100 active:opacity-100 transition-opacity duration-200"
        >
          <DownloadIcon />
          Download
        </a>
        <button
          id="cv-modal-close"
          class="text-[0.9rem] fhd:text-base leading-none opacity-40 can-hover:hover:opacity-100 active:opacity-100 transition-opacity duration-200 cursor-pointer"
          aria-label="Close modal"
        >
          ×
        </button>
      </div>
    </div>

    <!-- Iframe -->
    <iframe
      id="cv-modal-iframe"
      src=""
      data-src=""
      class="flex-1 w-full border-none"
      title={titleLabel}
    />
  </div>
</div>
