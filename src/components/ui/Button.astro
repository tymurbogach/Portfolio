---
import { VariableStatement } from 'typescript';

export interface Props {
  variant?: VariableStatement;
  href?: string;
  type?: "submit" | "button";
  class?: string;
}

const {
  variant = "primary",
  href,
  type = "button",
  class: extraClass = "",
} = Astro.props;

// Clase base
const baseClasses =
  "inline-flex items-center gap-1.5 px-6 py-2.5 text-[0.65rem] tracking-[0.3em] uppercase font-bold text-decoration-none transition-all duration-200";

// Variantes
const variantClasses = {
  primary:
    "border border-[var(--accent-color)] text-[var(--accent-color)] hover:bg-[var(--accent-color)] hover:text-[var(--accent-text)]",
  ghost:
    "border border-[var(--border-color)] text-[var(--letter-color)] opacity-65 hover:opacity-100 hover:bg-[var(--hover-bg)] hover:text-[var(--hover-text)] hover:border-[var(--hover-bg)]",
  accent:
    "border border-[var(--accent-color)] text-[var(--accent-color)] hover:bg-[var(--accent-color)] hover:text-[#0a0a0a]",
};

const buttonClasses = `${baseClasses} ${variantClasses[variant as "primary" | "ghost" | "accent"]} ${extraClass}`;
const Element = href ? "a" : "button";
---

<Element href={href} type={href ? undefined : type} class={buttonClasses}>
  <slot />
</Element>
