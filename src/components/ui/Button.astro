---
export type Variant = "primary" | "ghost" | "accent";

export interface Props {
  variant?: Variant;
  href?:    string;
  type?:    "submit" | "button";
  id?:      string;
  class?:   string;
}

const {
  variant,
  href,
  type = "button",
  id,
  class: extraClass = "",
} = Astro.props;

const baseClasses =
  "inline-flex items-center gap-1.5 px-6 py-2.5 text-[0.65rem] fhd:text-xs qhd:text-sm uhd:text-base tracking-[0.3em] uppercase font-bold text-decoration-none transition-all duration-200";

const variantClasses: { [K in Variant]: string } = {
  primary: "border border-[var(--accent-color)] text-[var(--accent-color)] can-hover:hover:bg-[var(--accent-color)] can-hover:hover:text-[var(--accent-text)]",
  ghost:   "border border-[var(--border-color)] text-[var(--letter-color)] opacity-65 can-hover:hover:opacity-100 can-hover:hover:bg-[var(--hover-bg)] can-hover:hover:text-[var(--hover-text)] can-hover:hover:border-[var(--hover-bg)]",
  accent:  "border border-[var(--accent-color)] text-[var(--accent-color)] can-hover:hover:bg-[var(--accent-color)] can-hover:hover:text-[#0a0a0a]",
};

const resolvedVariant: Variant = variant ?? "primary";
const buttonClasses = `${baseClasses} ${variantClasses[resolvedVariant]} ${extraClass}`;
const Element = href ? "a" : "button";
---

<Element href={href} type={href ? undefined : type} id={id} class={buttonClasses}>
  <slot />
</Element>