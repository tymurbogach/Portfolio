---
export type Variant = "primary" | "ghost" | "accent";

export interface Props {
  variant?: Variant;
  href?:    string;
  type?:    "submit" | "button";
  id?:      string;
  class?:   string;
}

const {
  variant,
  href,
  type = "button",
  id,
  class: extraClass = "",
} = Astro.props;

// btn-base: display, cursor, text-decoration, transition (desktop only)
// btn-primary / btn-ghost: border, color, bg, :active fill, :hover fill
// tapFeedback.ts detects these class names and skips JS animation for them
const baseClasses =
  "btn-base font-hud gap-1.5 px-6 py-2.5 text-[0.68rem] fhd:text-xs qhd:text-sm uhd:text-base tracking-[0.24em] uppercase font-bold";

const variantClasses: { [K in Variant]: string } = {
  primary: "btn-primary",
  ghost:   "btn-ghost opacity-65",
  accent:  "btn-accent",
};

const resolvedVariant: Variant = variant ?? "primary";
const buttonClasses = `${baseClasses} ${variantClasses[resolvedVariant]} ${extraClass}`;
const Element = href ? "a" : "button";
---

<Element href={href} type={href ? undefined : type} id={id} class={buttonClasses}>
  <slot />
</Element>
