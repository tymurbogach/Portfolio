---
import * as si from "simple-icons";

/* Estas marcas no están disponibles en simple-icons. Los paths proceden de
 * los SVG oficiales que usa el plugin Omarchy Agents. */
const CUSTOM_PATHS: Record<string, string> = {
  codex: `<path fill-rule="evenodd" clip-rule="evenodd" d="M8.086.457a6.105 6.105 0 013.046-.415c1.333.153 2.521.72 3.564 1.7a.117.117 0 00.107.029c1.408-.346 2.762-.224 4.061.366l.063.03.154.076c1.357.703 2.33 1.77 2.918 3.198.278.679.418 1.388.421 2.126a5.655 5.655 0 01-.18 1.631.167.167 0 00.04.155 5.982 5.982 0 011.578 2.891c.385 1.901-.01 3.615-1.183 5.14l-.182.22a6.063 6.063 0 01-2.934 1.851.162.162 0 00-.108.102c-.255.736-.511 1.364-.987 1.992-1.199 1.582-2.962 2.462-4.948 2.451-1.583-.008-2.986-.587-4.21-1.736a.145.145 0 00-.14-.032c-.518.167-1.04.191-1.604.185a5.924 5.924 0 01-2.595-.622 6.058 6.058 0 01-2.146-1.781c-.203-.269-.404-.522-.551-.821a7.74 7.74 0 01-.495-1.283 6.11 6.11 0 01-.017-3.064.166.166 0 00.008-.074.115.115 0 00-.037-.064 5.958 5.958 0 01-1.38-2.202 5.196 5.196 0 01-.333-1.589 6.915 6.915 0 01.188-2.132c.45-1.484 1.309-2.648 2.577-3.493.282-.188.55-.334.802-.438.286-.12.573-.22.861-.304a.129.129 0 00.087-.087A6.016 6.016 0 015.635 2.31C6.315 1.464 7.132.846 8.086.457zm-.804 7.85a.848.848 0 00-1.473.842l1.694 2.965-1.688 2.848a.849.849 0 001.46.864l1.94-3.272a.849.849 0 00.007-.854l-1.94-3.393zm5.446 6.24a.849.849 0 000 1.695h4.848a.849.849 0 000-1.696h-4.848z"/>`,
  kimi: `<path d="M21.72.94a2.23 2.23 0 100 4.46h-1.97a.26.26 0 01-.26-.26V3.17a2.23 2.23 0 012.23-2.23Z"/><path d="M9.39 13.95 17.82 5.59c.16-.16.07-.47-.14-.47h-4.54a.27.27 0 00-.14.06l-9.08 9.01a.22.22 0 01-.35-.21V5.39a.27.27 0 00-.22-.27H.22a.22.22 0 00-.22.27v18.53c0 .15.1.27.22.27h3.13c.12 0 .22-.12.22-.27v-3.78c0-.08.03-.16.08-.21l2.82-2.79a.2.2 0 01.24-.03l7.53 5.54c1.23.83 2.61 1.34 4.01 1.49.12.01.23-.11.23-.27v-3.56c0-.14-.09-.26-.19-.26a7.28 7.28 0 01-2.07-.94l-6.52-4.72a.31.31 0 01-.01-.44Z"/>`,
  opencode: `<path fill-rule="evenodd" d="M14.4 4.8H4.8v14.4h9.6V4.8ZM19.2 24H0V0h19.2v24Z"/><path d="M14.4 19.2H4.8V9.6h9.6v9.6Z" fill="var(--card)"/>`,
  prompt: `<path fill-rule="evenodd" d="M3 3h18v18H3V3Zm2 2v14h14V5H5Zm2.1 3.1 3.4 3.4-3.4 3.4 1.4 1.4 4.8-4.8-4.8-4.8-1.4 1.4Zm5.9 6.4h4v2h-4v-2Z"/>`,
};

interface Props {
  slug: string;
  color?: string;
  size?: number;
  label: string;
  /** "mono" pinta el icono con --accent y guarda el color de marca en
   *  --icon-brand, que .skill-chip revela en hover. */
  tone?: "brand" | "mono";
  class?: string;
}

const {
  slug,
  color,
  size = 20,
  label,
  tone = "brand",
  class: extraClass = "",
} = Astro.props;

const key = `si${slug.charAt(0).toUpperCase()}${slug.slice(1)}`;
const icon = (si as { [key: string]: { path: string; hex: string } })[key];
const customPath = CUSTOM_PATHS[slug];

const fillColor = color ?? (icon ? `#${icon.hex}` : "currentColor");
const path = icon?.path ?? "";
const hasIcon = !!icon;

const iconStyle =
  tone === "mono"
    ? `--icon-brand: ${fillColor}; fill: var(--accent);`
    : `fill: ${fillColor};`;
---

{customPath ? (
  <svg
    role="img"
    viewBox="0 0 24 24"
    width={size}
    height={size}
    aria-label={label}
    xmlns="http://www.w3.org/2000/svg"
    class:list={["shrink-0", extraClass]}
    style={iconStyle}
    set:html={customPath}
  />
) : hasIcon ? (
  <svg
    role="img"
    viewBox="0 0 24 24"
    width={size}
    height={size}
    aria-label={label}
    xmlns="http://www.w3.org/2000/svg"
    class:list={["shrink-0", extraClass]}
    style={iconStyle}
  >
    <path d={path} />
  </svg>
) : (
  <span
    role="img"
    aria-label={label}
    class={extraClass}
    style={`display:inline-block; width:${size}px; height:${size}px; flex-shrink:0;
            background:${tone === "mono" ? "var(--accent)" : (color ?? "currentColor")};
            clip-path: polygon(50% 0%, 100% 50%, 50% 100%, 0% 50%);`}
  />
)}
