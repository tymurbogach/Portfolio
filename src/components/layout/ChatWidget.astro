---
import { CHAT_STARTERS as starters } from "../../lib/chatConfig";
---

<script>
  import "../../scripts/chat";
</script>

<!--
  Widget panel — positioned above the chat toggle (ChatToggle).
  data-open drives visibility/transform; all panel styles live in the
  CHAT WIDGET section of global.css (state machine + JS-created classes).
-->
<div
  id="chat-widget"
  data-open="false"
  class="font-hud flex flex-col"
  aria-label="Chat with Tymur's AI"
  aria-hidden="true"
>
  <!-- Header -->
  <div class="flex items-center justify-between shrink-0 px-4 py-2.5 border-b border-[var(--border)] bg-[var(--card)]">
    <span class="font-display tracking-[0.06em] text-base text-[var(--accent)]">
      &gt;_ CHAT.SYS
    </span>
    <button
      id="chat-close-btn"
      class="text-[0.7rem] tracking-[0.2em] uppercase px-2 py-0.5 [font-family:inherit]
             border border-[var(--border)] can-hover:hover:border-[var(--accent)]
             can-hover:hover:text-[var(--accent)] transition-colors duration-150 cursor-pointer"
      aria-label="Close chat"
    >×</button>
  </div>

  <!-- Messages -->
  <div
    id="chat-messages"
    class="flex-1 overflow-y-auto px-4 py-3 flex flex-col gap-3 min-h-0 text-[0.78rem] leading-[1.7]"
  >
    <!-- Welcome message -->
    <div class="chat-msg chat-msg--bot">
      Hey — I'm TymurBot. Ask me anything about Tymur, his stack, or just say hi.
    </div>

    <!-- Starter suggestions -->
    <div class="chat-starters flex flex-wrap gap-1.5 mt-1">
      {starters.map(s => (
        <button
          class="chat-starter text-[0.66rem] tracking-[0.12em] uppercase px-2.5 py-1
                 [font-family:inherit] bg-transparent text-inherit opacity-60
                 border border-[var(--border)] can-hover:hover:border-[var(--accent)]
                 can-hover:hover:text-[var(--accent)] transition-colors duration-150 cursor-pointer"
          data-q={s.q}
        >[ {s.label} ]</button>
      ))}
    </div>
  </div>

  <!-- Input -->
  <div class="shrink-0 flex gap-0 border-t border-[var(--border)]">
    <input
      id="chat-input"
      type="text"
      placeholder="> type your message..."
      autocomplete="off"
      class="flex-1 px-4 py-3 text-[0.7rem] bg-[var(--card)] border-none outline-none
             text-[var(--foreground)] [font-family:inherit]"
    />
    <button
      id="chat-send-btn"
      class="px-4 py-3 text-[0.65rem] tracking-[0.2em] uppercase font-bold min-w-16
             bg-[var(--accent)] text-[var(--accent-foreground)] border-none [font-family:inherit]
             transition-colors duration-150 cursor-pointer disabled:opacity-30"
    >→</button>
  </div>
</div>
