---
import { getHomeData, getContactData } from '../../lib/content';

const home    = await getHomeData();
const contact = await getContactData();

const { hero, stats } = home;
const { cv_link, cv_preview } = contact;
---
<section class="flex flex-col justify-between w-full h-full min-h-0 gap-4">

  <!-- Main content — stacks vertically on laptop sidebar, 2-col on fhd+ (index page) -->
  <main class="flex-1 min-h-0 flex flex-col fhd:flex-row items-center fhd:items-start
               gap-6 fhd:gap-10 justify-center fhd:justify-center fhd:py-4">

    <!-- Column 1: photo + identity -->
    <div class="flex flex-col items-center gap-4 fhd:gap-5 fhd:flex-1 fhd:justify-center">
      <img
        id="theme-toggle"
        src="/img/gopnik.png"
        alt="Hero Image — click para cambiar tema"
        class="w-full h-auto object-contain pointer-events-auto
         max-w-[7rem] mobile:max-w-[9rem]
         laptop:max-w-[8rem] fhd:max-w-[14rem] qhd:max-w-[18rem] uhd:max-w-[22rem]"
      />

      <p class="text-[0.65rem] mobile:text-xs laptop:text-[0.65rem] fhd:text-sm qhd:text-base
                text-center opacity-70 leading-relaxed max-w-[22rem] laptop:max-w-[16rem] fhd:max-w-[24rem]">
        {hero.subtitle1}<br />
        {hero.subtitle2}
      </p>
    </div>

    <!-- Column 2: CV + stats -->
    <div class="flex flex-col items-center fhd:items-start gap-4 fhd:gap-5 fhd:flex-1 fhd:justify-center">

      <!-- Stats row -->
      <div class="grid grid-cols-2 gap-2 w-full max-w-[18rem] laptop:max-w-[14rem] fhd:max-w-[22rem]">
        {stats.map(({ n, label }: any) => (
          <div class="flex flex-col px-3 py-2 border border-[var(--border-subtle)] bg-[var(--surface-raised)]">
            <span class="text-base fhd:text-xl qhd:text-2xl font-bold leading-none"
                  style="color: var(--accent-color)">{n}</span>
            <span class="text-[0.52rem] fhd:text-[0.55rem] tracking-[0.2em] uppercase opacity-45 mt-0.5">{label}</span>
          </div>
        ))}
      </div>

      <!-- CV button -->
      <button
        id="cv-view-btn"
        class="flex items-center gap-2 px-4 py-2
               text-[0.52rem] fhd:text-xs tracking-[0.35em] uppercase font-bold
               border border-[var(--border-color)]
               hover:bg-[var(--hover-bg)] hover:text-[var(--hover-text)] hover:border-[var(--hover-bg)]
               transition-all duration-200 cursor-pointer"
      >
        <svg viewBox="0 0 16 16" width="10" height="10" fill="currentColor" style="color: var(--accent-color); flex-shrink:0">
          <path d="M10.5 8a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0z"/>
          <path d="M0 8s3-5.5 8-5.5S16 8 16 8s-3 5.5-8 5.5S0 8 0 8zm8 3.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7z"/>
        </svg>
        <span>View CV</span>
      </button>
    </div>
  </main>

</section>

<!-- CV Preview Modal -->
<div id="cv-modal"
     style="display:none; position:fixed; inset:0; z-index:200;
            background: rgba(0,0,0,0.95); backdrop-filter: blur(6px);">
  <div style="position:absolute; inset:0; display:flex; flex-direction:column;">
    <div style="display:flex; justify-content:flex-end; align-items:center; gap:12px; padding:16px 24px; flex-shrink:0;">
      <a id="cv-download-btn"
         href={cv_link}
         target="_blank"
         rel="noopener noreferrer"
         class="cv-modal-action cv-modal-accent">
        Download PDF
      </a>
      <button id="cv-close-btn" class="cv-modal-action">
        ✕ Close
      </button>
    </div>
    <iframe
      id="cv-iframe"
      src=""
      data-src={cv_preview}
      style="flex:1; border:none; width:100%;"
      allow="autoplay">
    </iframe>
  </div>
</div>

<style>
  .cv-modal-action {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 1.2rem;
    font-size: 0.6rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    font-weight: 700;
    border: 1px solid rgba(255,255,255,0.2);
    color: rgba(255,255,255,0.8);
    background: transparent;
    cursor: pointer;
    text-decoration: none;
    transition: border-color 0.2s, color 0.2s;
    font-family: "Poiret One", cursive;
  }
  .cv-modal-action:hover { border-color: white; color: white; }
  .cv-modal-accent { border-color: var(--accent-color) !important; color: var(--accent-color) !important; }
  .cv-modal-accent:hover { background: var(--accent-color) !important; color: #000 !important; }

  @keyframes cv-modal-in {
    from { opacity: 0; transform: scale(0.97); }
    to   { opacity: 1; transform: scale(1); }
  }
  #cv-modal[data-open="true"] {
    animation: cv-modal-in 180ms ease-out both;
  }
</style>

<script>
  function initCvModal() {
    const btn      = document.getElementById('cv-view-btn');
    const modal    = document.getElementById('cv-modal') as HTMLElement | null;
    const closeBtn = document.getElementById('cv-close-btn');
    const dlBtn    = document.getElementById('cv-download-btn');
    const iframe   = document.getElementById('cv-iframe') as HTMLIFrameElement | null;

    if (!btn || !modal || !closeBtn || !iframe) return;

    function openModal() {
      if (!iframe.src || iframe.src === window.location.href) {
        iframe.src = iframe.dataset.src ?? '';
      }
      modal.style.display = 'block';
      modal.dataset.open = 'true';
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      modal.style.display = 'none';
      delete modal.dataset.open;
      document.body.style.overflow = '';
    }

    const ac = new AbortController();
    btn.addEventListener('click', openModal, { signal: ac.signal });
    closeBtn.addEventListener('click', closeModal, { signal: ac.signal });
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    }, { signal: ac.signal });

    document.addEventListener('keydown', (e) => {
      if (modal.style.display === 'none') return;
      if (e.key === 'Escape') closeModal();
      if (e.key === 'd' || e.key === 'D') dlBtn?.click();
    }, { signal: ac.signal });

    document.addEventListener('astro:before-preparation', () => {
      closeModal();
      ac.abort();
    }, { once: true });
  }

  document.addEventListener('astro:page-load', initCvModal);
</script>
