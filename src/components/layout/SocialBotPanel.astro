<div
  class="w-full h-[2.5rem]
         mobile:w-[4.5rem] mobile:h-[4.5rem]
         tablet:w-[4.5rem] tablet:h-[4.5rem]
         laptop:w-[5rem] laptop:h-[5rem]
         fhd:w-[5.5rem]   fhd:h-[5.5rem]
         qhd:w-[6rem]   qhd:h-[6rem]
         uhd:w-[6.5rem]   uhd:h-[6.5rem]"
>
  <div
    class="flex flex-row items-center justify-center text-center w-full h-full
           bg-[var(--component-background)] border border-[var(--border-color)]
           shadow-none rounded-none my-0 mx-0
           mobile:shadow-md tablet:shadow-lg"
  >
    

    <!-- Bot toggle button -->
    <button
      id="chat-toggle-btn"
      aria-label="Open AI chat"
      class="group flex flex-col items-center justify-center h-full flex-1 gap-0.5
             text-[var(--letter-color)] p-[0.75rem] cursor-pointer
             transition-all duration-250 ease-in-out
             hover:bg-[var(--accent-color)]"
      style="border: none; background: transparent;"
    >
      <span
        class="font-display text-sm laptop:text-base"
        style="color: var(--accent-color); line-height: 1; transition: color 0.25s;"
      >&gt;_</span>
      <span
        class="text-[0.42rem] tracking-[0.2em] uppercase font-bold"
        style="opacity: 0.45; transition: opacity 0.25s;"
      >bot</span>
    </button>
  </div>
</div>

<style>
  #chat-toggle-btn:hover span {
    color: var(--accent-text) !important;
    opacity: 1 !important;
  }
</style>
