---
interface Props {
  nameDisplay: string;
  role:        string;
}

const { nameDisplay, role } = Astro.props;
---

<div
  class="nav-panel w-full h-[3rem] cursor-pointer
         mobile:w-[20rem]  mobile:h-[4.5rem]
         tablet:w-[20rem]  tablet:h-[4.5rem]
         laptop:w-[25rem]  laptop:h-[5rem]
         fhd:w-[30rem]     fhd:h-[5.5rem]
         qhd:w-[35rem]     qhd:h-[6rem]
         uhd:w-[40rem]     uhd:h-[6.5rem]"
>
  <a
    href="/"
    class="nav-cell nav-link group no-underline w-full h-full
           flex flex-col items-center justify-center text-center gap-1 mobile:gap-1.5"
    aria-label="Inicio"
  >
    <h1
      class="font-bold font-signature m-0
             tracking-[0.9rem] laptop:tracking-[0.7rem] fhd:tracking-[0.8rem] qhd:tracking-[0.9rem] uhd:tracking-[1.1rem]
             text-xl mobile:text-xl tablet:text-2xl laptop:text-3xl
             fhd:text-4xl qhd:text-5xl uhd:text-6xl"
    >
      {nameDisplay}
    </h1>
    <div class="flex items-center w-full px-3 mobile:px-4 gap-2">
      <span
        class="flex-1 h-px"
        style="background: linear-gradient(to right, transparent, color-mix(in srgb, var(--accent) 55%, transparent));"
        aria-hidden="true"
      ></span>
      <p
        class="text-[0.42rem] mobile:text-[0.5rem] laptop:text-[0.55rem] fhd:text-xs
               tracking-[0.35em] uppercase m-0 opacity-50 whitespace-nowrap flex-shrink-0"
      >
        {role}
      </p>
      <span
        class="flex-1 h-px"
        style="background: linear-gradient(to left, transparent, color-mix(in srgb, var(--accent) 55%, transparent));"
        aria-hidden="true"
      ></span>
    </div>
  </a>
</div>
