---
interface Props {
  nameDisplay: string;
  role: string;
}

const { nameDisplay, role } = Astro.props;
---

<div
  class="nav-panel cursor-pointer"
  style="width: var(--nav-width); height: var(--nav-height);"
>
  <a
    href="/"
    class="nav-cell nav-link group no-underline w-full h-full
           flex flex-col items-center justify-center text-center gap-1 mobile:gap-1.5"
    aria-label="Home"
  >
    <h1
      class="font-bold font-signature m-0 whitespace-nowrap
               tracking-[0.6rem] laptop:tracking-[clamp(0.7rem,0.7vw,1rem)]
               text-xl mobile:text-xl tablet:text-2xl laptop-scaled:text-[1.65rem] laptop-scaled:tracking-[0.48rem] laptop:text-3xl
             laptop:text-[clamp(1.875rem,1.4vw,3rem)]"
    >
      {nameDisplay}
    </h1>
    <div class="flex items-center w-full px-3 mobile:px-4 gap-2">
      <span
        class="flex-1 h-px bg-[linear-gradient(to_right,transparent,color-mix(in_srgb,var(--accent)_55%,transparent))]"
        aria-hidden="true"
      ></span>
      <p
        class="font-hud text-[0.62rem] mobile:text-[0.65rem] laptop:text-[var(--type-meta)]
               tracking-[0.22em] uppercase m-0 text-[var(--foreground-faint)] whitespace-nowrap flex-shrink-0"
      >
        {role}
      </p>
      <span
        class="flex-1 h-px bg-[linear-gradient(to_left,transparent,color-mix(in_srgb,var(--accent)_55%,transparent))]"
        aria-hidden="true"
      ></span>
    </div>
  </a>
</div>
