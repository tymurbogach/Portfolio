---
import type { NavPage } from "../../lib/content";

interface Props {
  pages: NavPage[];
}

const { pages }     = Astro.props;
const currentPath   = Astro.url.pathname.replace(/\/$/, "");
---

<script>
  import "../../scripts/navIndicator";
</script>

<div
  class="relative"
  style="width: var(--nav-width); height: var(--nav-height);"
>
  <nav
    class="relative flex flex-row items-center justify-center text-center w-full h-full
           bg-[var(--component-background)] border border-[var(--border-color)]
           shadow-none rounded-none my-0 mx-0
           mobile:shadow-md tablet:shadow-lg"
  >
    {pages.map((page: NavPage, i: number) => (
      <a
        href={page.path}
        data-active={currentPath === page.path ? "true" : "false"}
        class:list={[
          "group nav-link flex flex-col items-center justify-center text-center h-full flex-1 min-w-0 overflow-hidden",
          "text-[var(--letter-color)] data-[active=true]:bg-[var(--accent-subtle)] data-[active=true]:text-[var(--accent-color)]",
          i < pages.length - 1 ? "border-r border-[var(--border-color)]" : "",
          "font-light tracking-wide laptop:tracking-widest laptop-scaled:tracking-widest",
          "text-xs mobile:text-sm tablet:text-base laptop:text-lg laptop-scaled:text-lg fhd:text-xl qhd:text-2xl uhd:text-3xl",
          "gap-0.5 p-2 mobile:p-3 tablet:p-4 transition-colors duration-200",
          "can-hover:hover:scale-105 can-hover:hover:shadow-md can-hover:hover:z-10 can-hover:hover:bg-[var(--hover-bg)] can-hover:hover:text-[var(--hover-text)]",
        ]}
      >
        <span
          class="inline-block transition-all duration-200 can-hover:group-hover:scale-125
                 bg-[var(--letter-color)] can-hover:group-hover:bg-[var(--hover-text)]
                 group-data-[active=true]:bg-[var(--accent-color)]
                 opacity-65 can-hover:group-hover:opacity-100 group-data-[active=true]:opacity-100"
          style={`width: var(--nav-icon-size); height: var(--nav-icon-size);
                  -webkit-mask-image:url('${page.icon}'); mask-image:url('${page.icon}');
                  -webkit-mask-size:contain;     mask-size:contain;
                  -webkit-mask-repeat:no-repeat; mask-repeat:no-repeat;
                  -webkit-mask-position:center;  mask-position:center;`}
          aria-hidden="true"
        />
        <span class="font-display text-[0.9em] laptop:text-[1em]">{page.label}</span>
      </a>
    ))}
  </nav>

  <!-- Indicador de página activa — fuera del nav para que overflow:hidden no lo corte -->
  <div
    id="nav-indicator"
    style="position:absolute; bottom:0; height:2px; background:var(--accent-color);
           transition: left 0.25s ease, width 0.25s ease;
           pointer-events:none; left:0; width:0;"
    aria-hidden="true"
  />
</div>

<style>
  /* Active state always wins over hover */
  .nav-link[data-active="true"] {
    background-color: var(--accent-subtle) !important;
    color: var(--accent-color) !important;
  }

  @keyframes nav-tap {
    0%, 50% { background-color: var(--hover-bg); color: var(--hover-text); }
    100%    { background-color: transparent;      color: var(--letter-color); }
  }
  .nav-tap-pressed {
    animation: nav-tap 1s ease-out !important;
  }

</style>

