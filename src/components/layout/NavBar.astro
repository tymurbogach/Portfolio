---
import type { NavPage } from "../../lib/content";

interface Props {
  pages: NavPage[];
}

const { pages }     = Astro.props;
const currentPath   = Astro.url.pathname.replace(/\/$/, "");
---

<script>
  import "../../scripts/navIndicator";
</script>

<div
  class="relative"
  style="width: var(--nav-width); height: var(--nav-height);"
>
  <nav
    class="nav-panel relative flex flex-row items-center justify-center text-center w-full h-full overflow-visible"
  >
    {pages.map((page: NavPage, i: number) => (
      <a
        href={page.path}
        data-active={currentPath === page.path ? "true" : "false"}
        class:list={[
          "nav-cell group nav-link flex flex-col items-center justify-center text-center h-full flex-1 min-w-0",
          "data-[active=true]:bg-[var(--accent-subtle)] data-[active=true]:text-[var(--accent)]",
          "",
          "font-light tracking-wide laptop:tracking-widest laptop-scaled:tracking-widest",
          "text-xs mobile:text-sm tablet:text-base laptop:text-lg laptop-scaled:text-lg fhd:text-xl qhd:text-2xl uhd:text-3xl",
          "gap-0.5 p-2 mobile:p-3 tablet:p-4",
        ]}
      >
        <span
          class="inline-block transition-all duration-200 can-hover:group-hover:scale-125
                 bg-[var(--foreground)] can-hover:group-hover:bg-[var(--secondary-foreground)]
                 group-data-[active=true]:bg-[var(--accent)]
                 opacity-65 can-hover:group-hover:opacity-100 group-data-[active=true]:opacity-100"
          style={`width: var(--nav-icon-size); height: var(--nav-icon-size);
                  -webkit-mask-image:url('${page.icon}'); mask-image:url('${page.icon}');
                  -webkit-mask-size:contain;     mask-size:contain;
                  -webkit-mask-repeat:no-repeat; mask-repeat:no-repeat;
                  -webkit-mask-position:center;  mask-position:center;`}
          aria-hidden="true"
        />
        <span class="font-display text-[0.9em] laptop:text-[1em]">{page.label}</span>
      </a>
    ))}
  </nav>

  <div
    id="nav-indicator"
    style="position:absolute; bottom:0; height:2px; background:var(--gradient-border);
           transition: left 0.25s ease, width 0.25s ease;
           pointer-events:none; left:0; width:0;"
    aria-hidden="true"
  />
</div>

<style>
  .nav-link[data-active="true"] {
    background-color: var(--accent-subtle) !important;
    color: var(--accent) !important;
  }

  @media (hover: hover) and (pointer: fine) {
    .nav-link[data-active="true"]:hover {
      background-color: var(--secondary) !important;
      color: var(--secondary-foreground) !important;
    }
    .nav-link[data-active="true"]:hover > span:first-child {
      background-color: var(--secondary-foreground) !important;
      opacity: 1 !important;
    }
  }
</style>
