---
import NameCard from "./NameCard.astro";
import NavBar from "./NavBar.astro";
import type { ProfileData, SiteData } from "../../lib/content";

interface Props {
  site: SiteData;
  profile: ProfileData;
}

const { site, profile } = Astro.props;
---

<header class="w-full h-auto flex flex-col items-center justify-center mobile:flex-row mobile:justify-between gap-0 m-0">
  <NameCard nameDisplay={profile.nameDisplay} role={profile.role} />
  <NavBar pages={site.pages} />
</header>
