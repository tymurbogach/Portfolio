---
const { title, description, link, image, type = 'source', tags = [] } = Astro.props;
const isDemo = type === 'demo';
---

<a
  href={link}
  target="_blank"
  rel="noopener noreferrer"
  class="group flex flex-col h-full overflow-hidden border border-[var(--border-color)]
         transition-all duration-300 hover:-translate-y-[3px] hover:shadow-xl"
>
  <!-- Imagen / cabecera visual -->
  <div class="relative bg-[var(--page-background)] overflow-hidden"
       style="aspect-ratio: 16 / 9;">

    <!-- Badge tipo -->
    <span class={`absolute top-2 left-2 z-20 text-[0.5rem] tracking-[0.2em] px-2 py-0.5 font-bold uppercase
                  ${isDemo
                    ? 'bg-[var(--letter-color)] text-[var(--page-background)]'
                    : 'bg-[var(--total-background)] text-[var(--letter-color)] opacity-70'}`}>
      {isDemo ? '● live' : '⌥ src'}
    </span>

    <!-- Esquinas decorativas -->
    <span class="absolute top-0 left-0 w-5 h-5 border-t-2 border-l-2 border-[var(--border-color)] opacity-50 z-10 pointer-events-none"></span>
    <span class="absolute top-0 right-0 w-5 h-5 border-t-2 border-r-2 border-[var(--border-color)] opacity-50 z-10 pointer-events-none"></span>
    <span class="absolute bottom-0 left-0 w-5 h-5 border-b-2 border-l-2 border-[var(--border-color)] opacity-50
                 transition-all duration-300 group-hover:w-full group-hover:opacity-20 z-10 pointer-events-none"></span>
    <span class="absolute bottom-0 right-0 w-5 h-5 border-b-2 border-r-2 border-[var(--border-color)] opacity-50 z-10 pointer-events-none"></span>

    {image ? (
      <img
        src={image}
        alt={title}
        loading="lazy"
        class="w-full h-full object-cover opacity-85 group-hover:opacity-100 group-hover:scale-105
               transition-all duration-500"
      />
    ) : (
      <div class="flex items-center justify-center w-full h-full px-6">
        <h3 class="text-base mobile:text-lg laptop:text-xl fhd:text-2xl font-bold
                   tracking-[0.2em] uppercase text-center leading-tight z-10">
          {title}
        </h3>
      </div>
    )}
  </div>

  <!-- Contenido -->
  <div class="flex flex-col flex-1 gap-2 p-4 laptop:p-5 bg-[var(--total-background)]">

    <h3 class="text-xs mobile:text-sm laptop:text-base font-bold tracking-[0.15em] uppercase
               text-[var(--letter-color)] leading-snug">
      {title}
    </h3>

    <p class="text-xs mobile:text-sm opacity-70 leading-relaxed flex-1 line-clamp-3">
      {description}
    </p>

    <!-- Tags -->
    {tags.length > 0 && (
      <div class="flex flex-wrap gap-1 mt-1">
        {tags.map((tag: string) => (
          <span class="text-[0.5rem] tracking-[0.15em] px-1.5 py-0.5 uppercase
                       border border-[var(--border-color)] opacity-40">
            {tag}
          </span>
        ))}
      </div>
    )}

    <div class="flex items-center gap-2 text-[0.65rem] tracking-[0.2em] uppercase
                opacity-40 group-hover:opacity-90 transition-opacity duration-300 mt-auto pt-1">
      <span>{isDemo ? 'Ver demo' : 'Ver código'}</span>
      <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
    </div>
  </div>

  <!-- Línea inferior animada -->
  <div class="h-[2px] w-0 bg-[var(--letter-color)] transition-all duration-500 group-hover:w-full shrink-0"></div>
</a>
