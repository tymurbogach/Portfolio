---
const { title, description, link } = Astro.props;
---

<a
  href={link}
  class="group flex flex-col overflow-hidden border border-[var(--border-color)] transition-all duration-300 hover:-translate-y-[3px] hover:shadow-xl"
>
  <!-- Header: diseño con colores del tema, sin imagen -->
  <div class="relative bg-[var(--page-background)] flex items-center justify-center px-6 py-10 laptop:py-12 overflow-hidden">
    <!-- Esquinas decorativas -->
    <span class="absolute top-0 left-0 w-5 h-5 border-t-2 border-l-2 border-[var(--border-color)] opacity-60"></span>
    <span class="absolute top-0 right-0 w-5 h-5 border-t-2 border-r-2 border-[var(--border-color)] opacity-60"></span>
    <span class="absolute bottom-0 left-0 w-5 h-5 border-b-2 border-l-2 border-[var(--border-color)] opacity-60 transition-all duration-300 group-hover:w-full group-hover:opacity-30"></span>
    <span class="absolute bottom-0 right-0 w-5 h-5 border-b-2 border-r-2 border-[var(--border-color)] opacity-60"></span>
    <!-- Título grande como elemento visual -->
    <h3 class="text-base mobile:text-lg laptop:text-xl fhd:text-2xl font-bold tracking-[0.2em] uppercase text-center leading-tight relative z-10">
      {title}
    </h3>
  </div>

  <!-- Descripción -->
  <div class="flex flex-col gap-3 p-4 laptop:p-5 fhd:p-6 bg-[var(--total-background)]">
    <p class="text-xs mobile:text-sm laptop:text-base fhd:text-lg opacity-65 leading-relaxed line-clamp-2">
      {description}
    </p>
    <div class="flex items-center gap-2 text-xs tracking-[0.2em] uppercase opacity-40 group-hover:opacity-80 transition-opacity duration-300">
      <span>View project</span>
      <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
    </div>
  </div>

  <!-- Línea inferior animada -->
  <div class="h-[2px] w-0 bg-[var(--letter-color)] transition-all duration-500 group-hover:w-full"></div>
</a>
