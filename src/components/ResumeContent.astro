<section class="flex flex-col w-full gap-8 laptop:gap-10">

  <div class="grid grid-cols-1 mobile:grid-cols-2 laptop:grid-cols-3 gap-8 laptop:gap-10 w-full">

    <div class="flex flex-col gap-4">
      <h2 class="text-sm laptop:text-base fhd:text-xl font-semibold tracking-widest uppercase border-b border-[var(--border-color)] pb-2 opacity-80">Programming</h2>
      <ul class="flex flex-col gap-[0.6rem]">
        <li class="flex items-center gap-3 text-sm mobile:text-base laptop:text-lg fhd:text-xl"><i class="fab fa-html5 text-orange-500 w-4 shrink-0 text-center"></i>HTML</li>
        <li class="flex items-center gap-3 text-sm mobile:text-base laptop:text-lg fhd:text-xl"><i class="fab fa-css3-alt text-blue-500 w-4 shrink-0 text-center"></i>CSS</li>
        <li class="flex items-center gap-3 text-sm mobile:text-base laptop:text-lg fhd:text-xl"><i class="fab fa-sass text-pink-500 w-4 shrink-0 text-center"></i>SCSS</li>
        <li class="flex items-center gap-3 text-sm mobile:text-base laptop:text-lg fhd:text-xl"><i class="fab fa-java text-red-500 w-4 shrink-0 text-center"></i>Java</li>
        <li class="flex items-center gap-3 text-sm mobile:text-base laptop:text-lg fhd:text-xl"><i class="fab fa-js text-yellow-500 w-4 shrink-0 text-center"></i>JavaScript</li>
        <li class="flex items-center gap-3 text-sm mobile:text-base laptop:text-lg fhd:text-xl"><i class="fab fa-js-square text-yellow-400 w-4 shrink-0 text-center"></i>TypeScript</li>
        <li class="flex items-center gap-3 text-sm mobile:text-base laptop:text-lg fhd:text-xl"><i class="fas fa-database text-gray-500 w-4 shrink-0 text-center"></i>MySQL</li>
        <li class="flex items-center gap-3 text-sm mobile:text-base laptop:text-lg fhd:text-xl"><i class="fab fa-php text-indigo-400 w-4 shrink-0 text-center"></i>PHP</li>
      </ul>
    </div>

    <div class="flex flex-col gap-4">
      <h2 class="text-sm laptop:text-base fhd:text-xl font-semibold tracking-widest uppercase border-b border-[var(--border-color)] pb-2 opacity-80">Frameworks</h2>
      <ul class="flex flex-col gap-[0.6rem]">
        <li class="flex items-center gap-3 text-sm mobile:text-base laptop:text-lg fhd:text-xl"><i class="fas fa-code-branch text-green-500 w-4 shrink-0 text-center"></i>Git</li>
        <li class="flex items-center gap-3 text-sm mobile:text-base laptop:text-lg fhd:text-xl"><i class="fab fa-laravel text-red-600 w-4 shrink-0 text-center"></i>Laravel</li>
        <li class="flex items-center gap-3 text-sm mobile:text-base laptop:text-lg fhd:text-xl"><i class="fab fa-angular text-red-700 w-4 shrink-0 text-center"></i>Angular</li>
        <li class="flex items-center gap-3 text-sm mobile:text-base laptop:text-lg fhd:text-xl"><i class="fas fa-pencil-ruler text-blue-500 w-4 shrink-0 text-center"></i>Tailwind</li>
        <li class="flex items-center gap-3 text-sm mobile:text-base laptop:text-lg fhd:text-xl"><i class="fab fa-galactic-republic text-purple-500 w-4 shrink-0 text-center"></i>Astro</li>
        <li class="flex items-center gap-3 text-sm mobile:text-base laptop:text-lg fhd:text-xl"><i class="fas fa-server text-gray-500 w-4 shrink-0 text-center"></i>VM</li>
        <li class="flex items-center gap-3 text-sm mobile:text-base laptop:text-lg fhd:text-xl"><i class="fab fa-windows text-blue-600 w-4 shrink-0 text-center"></i>Windows</li>
        <li class="flex items-center gap-3 text-sm mobile:text-base laptop:text-lg fhd:text-xl"><i class="fab fa-linux text-orange-500 w-4 shrink-0 text-center"></i>Linux</li>
      </ul>
    </div>

    <div class="flex flex-col gap-4">
      <h2 class="text-sm laptop:text-base fhd:text-xl font-semibold tracking-widest uppercase border-b border-[var(--border-color)] pb-2 opacity-80">Languages</h2>
      <ul class="flex flex-col gap-[0.6rem]">
        <li class="flex items-center gap-3 text-sm mobile:text-base laptop:text-lg fhd:text-xl">🇷🇺 Russian</li>
        <li class="flex items-center gap-3 text-sm mobile:text-base laptop:text-lg fhd:text-xl">🇺🇦 Ukrainian</li>
        <li class="flex items-center gap-3 text-sm mobile:text-base laptop:text-lg fhd:text-xl">🇪🇸 Spanish</li>
        <li class="flex items-center gap-3 text-sm mobile:text-base laptop:text-lg fhd:text-xl">🇬🇧 English</li>
      </ul>
    </div>

  </div>

  <div class="flex flex-col gap-4">
    <h2 class="text-sm laptop:text-base fhd:text-xl font-semibold tracking-widest uppercase border-b border-[var(--border-color)] pb-2 opacity-80">Homelab & DevOps</h2>
    <div class="flex flex-wrap gap-2 mobile:gap-3">
      {[
        { icon: "fab fa-docker text-blue-500", label: "Docker" },
        { icon: "fas fa-network-wired text-green-600", label: "Nginx" },
        { icon: "fab fa-raspberry-pi text-red-500", label: "Raspberry Pi" },
        { icon: "fas fa-hdd text-gray-500", label: "TrueNAS" },
        { icon: "fas fa-shield-alt text-blue-400", label: "Tailscale" },
        { icon: "fas fa-cloud text-orange-400", label: "Cloudflare Tunnels" },
        { icon: "fas fa-tachometer-alt text-green-500", label: "Portainer" },
        { icon: "fas fa-filter text-red-400", label: "Pi-hole" },
        { icon: "fas fa-film text-purple-500", label: "Jellyfin" },
        { icon: "fas fa-images text-yellow-500", label: "Immich" },
        { icon: "fas fa-music text-pink-500", label: "Navidrome" },
        { icon: "fas fa-brain text-violet-500", label: "Ollama" },
        { icon: "fas fa-heartbeat text-red-400", label: "Uptime Kuma" },
        { icon: "fas fa-terminal text-gray-600", label: "SSH" },
      ].map(({ icon, label }) => (
        <span class="flex items-center gap-2 px-3 py-1 rounded-full border border-[var(--border-color)] text-xs mobile:text-sm laptop:text-base fhd:text-lg opacity-75 whitespace-nowrap">
          <i class={`${icon} text-sm`}></i>{label}
        </span>
      ))}
    </div>
  </div>

</section>
