---
import { getEntry } from 'astro:content';
import TechIcon from './TechIcon.astro';

const resumeData = await getEntry('site', 'resume');
const { frontend, backend, homelab, languages } = resumeData.data;
---

<section class="flex flex-col w-full gap-9 laptop:gap-12">

  <!-- Frontend + Backend side by side or stacked -->
  <div class="grid grid-cols-1 mobile:grid-cols-2 gap-8 laptop:gap-10">

    <!-- Frontend -->
    <div class="flex flex-col gap-4">
      <div class="flex items-center gap-3">
        <h2 class="text-[0.6rem] tracking-[0.5em] uppercase font-bold opacity-40">Frontend</h2>
        <div class="flex-1 h-px" style="background: var(--accent-color); opacity: 0.2;"></div>
      </div>
      <div class="chip-grid">
        {frontend.map(({ slug, color, label }: any) => (
          <div class="chip">
            <TechIcon slug={slug} color={color} label={label} size={18} />
            <span>{label}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Backend -->
    <div class="flex flex-col gap-4">
      <div class="flex items-center gap-3">
        <h2 class="text-[0.6rem] tracking-[0.5em] uppercase font-bold opacity-40">Backend</h2>
        <div class="flex-1 h-px" style="background: var(--accent-color); opacity: 0.2;"></div>
      </div>
      <div class="chip-grid">
        {backend.map(({ slug, color, label }: any) => (
          <div class="chip">
            <TechIcon slug={slug} color={color} label={label} size={18} />
            <span>{label}</span>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Homelab & DevOps -->
  <div class="flex flex-col gap-4">
    <div class="flex items-center gap-3">
      <h2 class="text-[0.6rem] tracking-[0.5em] uppercase font-bold opacity-40">Homelab & DevOps</h2>
      <div class="flex-1 h-px" style="background: var(--accent-color); opacity: 0.2;"></div>
    </div>
    <div class="chip-grid">
      {homelab.map(({ slug, color, label }: any) => (
        <div class="chip">
          <TechIcon slug={slug} color={color} label={label} size={18} />
          <span>{label}</span>
        </div>
      ))}
    </div>
  </div>

  <!-- Languages -->
  <div class="flex flex-col gap-4">
    <div class="flex items-center gap-3">
      <h2 class="text-[0.6rem] tracking-[0.5em] uppercase font-bold opacity-40">Languages</h2>
      <div class="flex-1 h-px" style="background: var(--accent-color); opacity: 0.2;"></div>
    </div>
    <div class="grid grid-cols-4 gap-2">
      {languages.map(({ flag, lang, level }: any) => (
        <div class="flex flex-col items-center gap-1 px-2 py-3
                    border border-[var(--border-subtle)] bg-[var(--surface-raised)] text-center">
          <span class="text-xl">{flag}</span>
          <span class="text-xs font-bold leading-snug">{lang}</span>
          <span class="text-[0.55rem] tracking-[0.3em] uppercase opacity-40">{level}</span>
        </div>
      ))}
    </div>
  </div>

</section>

<style>
  .chip-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(148px, 1fr));
    gap: 10px;
  }

  .chip {
    display: flex;
    align-items: center;
    gap: 10px;
    height: 44px;
    padding: 0 14px;
    border: 1px solid var(--border-subtle);
    background: var(--surface-raised);
    transition: border-color 0.2s ease, transform 0.2s ease;
    cursor: default;
    overflow: hidden;
  }

  .chip:hover {
    border-color: var(--accent-color);
    transform: translateY(-2px);
  }

  .chip span {
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 700;
    opacity: 0.8;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>
