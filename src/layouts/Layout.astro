---
import "../styles/global.css";
import Header         from "../components/layout/Header.astro";
import Footer         from "../components/layout/Footer.astro";
import NameCard        from "../components/layout/NameCard.astro";
import NavBar          from "../components/layout/NavBar.astro";
import SocialLinks     from "../components/ui/SocialLinks.astro";
import ChatToggle      from "../components/ui/ChatToggle.astro";
import ChatWidget      from "../components/layout/ChatWidget.astro";
import DualMain        from "../layouts/DualMain.astro";
import { ClientRouter } from "astro:transitions";
import { getImage } from "astro:assets";
import { getSite, getProfile } from "../lib/content";
import { THEMES, DEFAULT_THEME, DEFAULT_MODE, MODE_STORAGE_KEY, THEME_STORAGE_KEY } from "../lib/themes";
import ogSource from "../assets/gopnik.png";

/** Base HTML shell: SEO head, global scripts, fixed chrome (nav/social/chat) and main frame. */
interface Props {
  /** Page name for <title> / og tags */
  title: string;
  /** true = two-column layout (ProfilePanel sidebar + content) via DualMain */
  dual?: boolean;
  /** false = center content instead of scrolling it (passed to DualMain) */
  scrollable?: boolean;
  /** Optional heading rendered above the content panel */
  pageLabel?: string;
  /** Overrides the per-route description from site.pageDescriptions */
  description?: string;
}

const site    = await getSite();
const profile = await getProfile();

const pathKey = (Astro.url.pathname.replace(/^\/|\/$/g, "") ||
  "home") as keyof typeof site.pageDescriptions;

const defaultDescription = site.pageDescriptions[pathKey] ?? site.description;

const {
  title,
  dual = false,
  scrollable = true,
  pageLabel = "",
  description = defaultDescription,
} = Astro.props;

const pageTitle = `${title} — ${site.name}`;
// Optimized at build time — the 1 MB source PNG never ships.
const ogImage = await getImage({ src: ogSource, width: 800, format: "webp" });
const ogImageUrl = new URL(ogImage.src, site.url).href;
const canonicalUrl = new URL(Astro.url.pathname, site.url).href;

// Default first-paint background: bladerunner theme, dark mode (see global.css)
const THEME_COLOR = "rgb(18, 11, 6)";

---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="UTF-8" />

    <!-- Anti-flash: applies mode + theme BEFORE first paint. Constants come from
         src/lib/themes.ts via define:vars (is:inline scripts cannot import).
         Cyberpunk owns :root (dark default); .dark is its LIGHT override.
         Every other theme uses the normal convention (.dark = dark mode). -->
    <script
      is:inline
      define:vars={{
        themes: THEMES,
        defaultTheme: DEFAULT_THEME,
        defaultMode: DEFAULT_MODE,
        modeKey: MODE_STORAGE_KEY,
        themeKey: THEME_STORAGE_KEY,
      }}
    >
      history.scrollRestoration = "manual";
      (function () {
        var mode  = localStorage.getItem(modeKey) || defaultMode;
        var saved = localStorage.getItem(themeKey);
        var theme = themes.indexOf(saved) !== -1 ? saved : defaultTheme;
        var needsDark = (theme === "cyberpunk") ? (mode === "light") : (mode === "dark");
        document.documentElement.classList.toggle("dark", needsDark);
        if (theme !== "cyberpunk") document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>

    <!-- SEO -->
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta name="theme-color" content={THEME_COLOR} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph -->
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <ClientRouter />

    <!-- Assets -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poiret+One&family=Bebas+Neue&family=JetBrains+Mono:wght@300;400;500;700&family=Outfit:wght@300;400;500;600;700&family=Fira+Code:wght@300;400;500;700&family=Oxanium:wght@300;400;500;600;700&family=Source+Code+Pro:wght@300;400;500;700&family=Poppins:wght@300;400;500;600;700&family=Lora:wght@400;500;600;700&family=Rajdhani:wght@400;500;600;700&family=Share+Tech+Mono&display=swap"
      rel="stylesheet"
    />

    <!-- Scripts globales -->
    <script>
      import "../scripts/darkMode";
      import "../scripts/sectionNav";
      import "../scripts/tapFeedback";
    </script>

    <script defer src="https://analytics.nastymur.com/script.js" data-website-id="2e2eb1bc-fab1-4307-95c4-042ff442884c"></script>
  </head>

  <!-- position:fixed en body evita el scroll nativo del documento;
       el scroll real ocurre solo dentro del panel de contenido -->
  <body class="fixed inset-0 bg-[var(--background)] text-[var(--foreground)]">
    <!-- MOBILE — fixed header/footer -->
    <header
      class="block laptop:hidden laptop-scaled:hidden fixed top-0 left-0 w-full z-30
             shadow-[0_2px_24px_color-mix(in_srgb,var(--accent)_8%,transparent)]"
    >
      <Header />
    </header>

    <footer
      class="block laptop:hidden laptop-scaled:hidden fixed bottom-0 left-0 w-full z-30
             shadow-[0_-2px_24px_color-mix(in_srgb,var(--accent)_8%,transparent)]"
    >
      <Footer />
    </footer>

    <!-- DESKTOP — fixed corner elements -->
    <div class="hidden laptop:flex laptop-scaled:flex fixed z-40"
         style="top: var(--fixed-offset); left: var(--fixed-offset);">
      <NameCard nameDisplay={profile.nameDisplay} role={profile.role} />
    </div>

    <div class="hidden laptop:flex laptop-scaled:flex fixed z-40"
         style="top: var(--fixed-offset); right: var(--fixed-offset);">
      <NavBar pages={site.pages} />
    </div>

    <div class="hidden laptop:flex laptop-scaled:flex fixed z-40"
         style="bottom: var(--fixed-offset); left: var(--fixed-offset);">
      <SocialLinks />
    </div>

    <div class="hidden laptop:flex laptop-scaled:flex fixed z-40"
         style="bottom: var(--fixed-offset); right: var(--fixed-offset);">
      <ChatToggle variant="panel" />
    </div>

    <!-- Mobile chat FAB — visible only below laptop breakpoint -->
    <ChatToggle variant="fab" />

    <ChatWidget />


    <!-- MAIN -->
    <main
      class="main-layout fixed inset-x-0 z-20
             top-[3rem] mobile:top-[4.5rem] tablet:top-[4.5rem]
             bottom-[2.5rem] mobile:bottom-[4.5rem] tablet:bottom-[4.5rem]
             laptop:inset-0 laptop-scaled:inset-0
             flex items-center justify-center"
    >
      <div
        class="w-full h-full relative
               bg-[var(--background)]
               border border-[var(--border)]
               flex items-center justify-center overflow-hidden"
      >
        {
          dual ? (
            <DualMain pageLabel={pageLabel} scrollable={scrollable}>
              <slot />
            </DualMain>
          ) : (
            <div
              class="w-full h-full flex flex-col overflow-y-auto overflow-x-hidden
                   p-[1.25rem] mobile:p-[1.5rem] tablet:p-[2rem]
                   laptop:p-[3.5rem] fhd:p-[5rem] qhd:p-[7rem] uhd:p-[9rem]"
            >
              <slot />
            </div>
          )
        }
      </div>
    </main>
  </body>
</html>
