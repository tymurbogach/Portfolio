---
import "../styles/global.css";
import Header         from "../components/layout/Header.astro";
import Footer         from "../components/layout/Footer.astro";
import NameCard        from "../components/layout/NameCard.astro";
import NavBar          from "../components/layout/NavBar.astro";
import SocialLinks     from "../components/ui/SocialLinks.astro";
import SocialBotPanel  from "../components/layout/SocialBotPanel.astro";
import ChatWidget      from "../components/layout/ChatWidget.astro";
import DualMain        from "../layouts/DualMain.astro";
import { ClientRouter } from "astro:transitions";
import { getSite, getProfile } from "../lib/content";

// ==========================================
// PROPS
// ==========================================
interface Props {
  title: string;
  dual?: boolean;
  scrollable?: boolean;
  pageLabel?: string;
  description?: string;
  ogImage?: string;
}

// ==========================================
// DATOS
// ==========================================
const site = await getSite();
const profile = await getProfile();

const pathKey = (Astro.url.pathname.replace(/^\/|\/$/g, "") ||
  "home") as keyof typeof site.pageDescriptions;

const defaultDescription = site.pageDescriptions[pathKey] ?? site.description;

const {
  title,
  dual = false,
  scrollable = true,
  pageLabel = "",
  description = defaultDescription,
  ogImage = site.ogImage,
} = Astro.props;

const pageTitle = `${title} — ${site.name}`;
const ogImageUrl = `${site.url}${ogImage}`;
---

<!doctype html>
<html lang={site.lang} class="theme-void">
  <head>
    <meta charset="UTF-8" />

    <!-- Anti-flash: aplica el tema guardado ANTES del primer paint -->
    <script is:inline>
      (function () {
        var t = localStorage.getItem("theme");
        var valid = [
          "theme-void",
          "theme-abyss",
          "theme-chalk",
          "theme-stone",
          "theme-ember",
          "theme-forest",
        ];
        if (t && valid.indexOf(t) !== -1) {
          document.documentElement.classList.remove("theme-void");
          document.documentElement.classList.add(t);
        }
      })();
    </script>

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>

    <!-- SEO -->
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />

    <!-- Open Graph -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:url" content={site.url} />
    <meta property="og:type" content="website" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <ClientRouter />

    <!-- Assets -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poiret+One&family=Bebas+Neue&family=JetBrains+Mono:wght@300;400;500;700&display=swap"
      rel="stylesheet"
    />

    <!-- Scripts globales -->
    <script src="@/scripts/themeToggle.ts"></script>
    <script src="@/scripts/contactForm.ts"></script>
    <script src="@/scripts/sectionNav.ts"></script>
  </head>

  <!-- position:fixed en body evita el scroll nativo del documento;
       el scroll real ocurre solo dentro del panel de contenido -->
  <body
    class="bg-[var(--total-background)] text-[var(--letter-color)]"
    style="position:fixed; inset:0;"
  >
    <!-- ═══════════════════════════════════
         MÓVIL — HEADER / FOOTER FIJOS
         ═══════════════════════════════════ -->
    <header class="block laptop:hidden fixed top-0 left-0 w-full z-30">
      <Header />
    </header>

    <footer class="block laptop:hidden fixed bottom-0 left-0 w-full z-30">
      <Footer />
    </footer>

    <!-- ═══════════════════════════════════
         DESKTOP — ELEMENTOS FIJOS
         ═══════════════════════════════════ -->
    <div class="hidden laptop:flex fixed top-[3rem] left-[3rem] z-40">
      <NameCard nameDisplay={profile.nameDisplay} role={profile.role} />
    </div>

    <div class="hidden laptop:flex fixed top-[3rem] right-[3rem] z-40">
      <NavBar pages={site.pages} />
    </div>

    <div class="hidden laptop:flex fixed bottom-[3rem] left-[3rem] z-40">
      <SocialLinks />
    </div>

    <div class="hidden laptop:flex fixed bottom-[3rem] right-[3rem] z-40">
      <SocialBotPanel />
    </div>

    <!-- Mobile chat FAB — visible only below laptop breakpoint -->
    <button
      class="chat-toggle block laptop:hidden fixed z-40 cursor-pointer
             flex items-center gap-1.5 px-3 py-2
             bottom-[3.25rem] mobile:bottom-[5.25rem] right-[0.75rem]
             transition-all duration-200 hover:opacity-100"
      style="
        background: color-mix(in srgb, var(--component-background) 75%, transparent);
        border: 1px solid color-mix(in srgb, var(--border-color) 65%, transparent);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        opacity: 0.7;
      "
      aria-label="Open AI chat"
    >
      <span style="color: var(--accent-color); font-family: 'JetBrains Mono', monospace; font-size: 0.8rem; line-height: 1;">&gt;_</span>
      <span style="font-size: 0.42rem; letter-spacing: 0.22em; text-transform: uppercase; opacity: 0.6; font-family: 'JetBrains Mono', monospace;">bot</span>
    </button>

    <ChatWidget />

    <!-- ═══════════════════════════════════
         MAIN
         ═══════════════════════════════════ -->
    <main
      class="fixed inset-x-0 z-20
             top-[3rem] mobile:top-[4.5rem] tablet:top-[4.5rem]
             bottom-[2.5rem] mobile:bottom-[4.5rem] tablet:bottom-[4.5rem]
             laptop:inset-0 laptop:p-[6rem]
             flex items-center justify-center"
    >
      <div
        class="w-full h-full
               bg-[var(--page-background)]
               border border-[var(--border-subtle)]
               flex items-center justify-center overflow-hidden"
      >
        {
          dual ? (
            <DualMain pageLabel={pageLabel} scrollable={scrollable}>
              <slot />
            </DualMain>
          ) : (
            <div
              class="w-full h-full flex flex-col overflow-y-auto overflow-x-hidden
                   p-[1.25rem] mobile:p-[1.5rem] tablet:p-[2rem]
                   laptop:p-[3.5rem] fhd:p-[5rem] qhd:p-[7rem] uhd:p-[9rem]"
            >
              <slot />
            </div>
          )
        }
      </div>
    </main>
  </body>
</html>
