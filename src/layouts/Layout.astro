---
import "../styles/global.css";
import GradualBlur    from "../components/ui/GradualBlur";
import Header         from "../components/layout/Header.astro";
import Footer         from "../components/layout/Footer.astro";
import NameCard        from "../components/layout/NameCard.astro";
import NavBar          from "../components/layout/NavBar.astro";
import SocialLinks     from "../components/ui/SocialLinks.astro";
import SocialBotPanel  from "../components/layout/SocialBotPanel.astro";
import ChatWidget      from "../components/layout/ChatWidget.astro";
import DualMain        from "../layouts/DualMain.astro";
import { ClientRouter } from "astro:transitions";
import { getSite, getProfile, getContactData } from "../lib/content";
// ==========================================
// PROPS
// ==========================================
interface Props {
  title: string;
  dual?: boolean;
  scrollable?: boolean;
  pageLabel?: string;
  description?: string;
  ogImage?: string;
}

// ==========================================
// DATOS
// ==========================================
const site    = await getSite();
const profile = await getProfile();
const contact = await getContactData();

const pathKey = (Astro.url.pathname.replace(/^\/|\/$/g, "") ||
  "home") as keyof typeof site.pageDescriptions;

const defaultDescription = site.pageDescriptions[pathKey] ?? site.description;

const {
  title,
  dual = false,
  scrollable = true,
  pageLabel = "",
  description = defaultDescription,
  ogImage = site.ogImage,
} = Astro.props;

const pageTitle = `${title} — ${site.name}`;
const ogImageUrl = `${site.url}${ogImage}`;

---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="UTF-8" />

    <!-- Anti-flash: aplica modo y tema ANTES del primer paint.
         Cyberpunk: :root = dark (default). .dark class = light mode.
         Otros temas: .dark class = dark mode (convención normal). -->
    <script is:inline>
      history.scrollRestoration = "manual";
      (function () {
        var mode  = localStorage.getItem("theme") || "dark";
        var theme = localStorage.getItem("color-theme") || "bladerunner";
        var needsDark = (theme === "cyberpunk") ? (mode === "light") : (mode === "dark");
        document.documentElement.classList.toggle("dark", needsDark);
        if (theme && theme !== "cyberpunk") document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>

    <!-- SEO -->
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />

    <!-- Open Graph -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:url" content={site.url} />
    <meta property="og:type" content="website" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <ClientRouter />

    <!-- Assets -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poiret+One&family=Bebas+Neue&family=JetBrains+Mono:wght@300;400;500;700&family=Outfit:wght@300;400;500;600;700&family=Fira+Code:wght@300;400;500;700&family=Oxanium:wght@300;400;500;600;700&family=Source+Code+Pro:wght@300;400;500;700&family=Poppins:wght@300;400;500;600;700&family=Lora:wght@400;500;600;700&family=Space+Mono:wght@400;700&family=IBM+Plex+Mono:wght@300;400;500;700&family=Roboto+Mono:wght@300;400;500;700&family=Rajdhani:wght@400;500;600;700&family=Share+Tech+Mono&display=swap"
      rel="stylesheet"
    />

    <!-- Scripts globales -->
    <script>
      import "../scripts/darkMode";
      import "../scripts/sectionNav";
      import "../scripts/tapFeedback";
    </script>

    <script defer src="https://analytics.nastymur.com/script.js" data-website-id="2e2eb1bc-fab1-4307-95c4-042ff442884c"></script>
  </head>

  <!-- position:fixed en body evita el scroll nativo del documento;
       el scroll real ocurre solo dentro del panel de contenido -->
  <body
    class="bg-[var(--background)] text-[var(--foreground)]"
    style="position:fixed; inset:0;"
  >
    <!-- ═══════════════════════════════════
         MÓVIL — HEADER / FOOTER FIJOS
         ═══════════════════════════════════ -->
    <header class="block laptop:hidden laptop-scaled:hidden fixed top-0 left-0 w-full z-30"
            style="box-shadow: 0 2px 24px color-mix(in srgb, var(--accent) 8%, transparent);">
      <Header />
      <div
        aria-hidden="true"
        style="width:100%; height:1px; background: var(--gradient-border); opacity:0.55; pointer-events:none;"
      ></div>
    </header>

    <footer class="block laptop:hidden laptop-scaled:hidden fixed bottom-0 left-0 w-full z-30"
            style="box-shadow: 0 -2px 24px color-mix(in srgb, var(--accent) 8%, transparent);">
      <div
        aria-hidden="true"
        style="width:100%; height:1px; background: var(--gradient-border); opacity:0.55; pointer-events:none;"
      ></div>
      <Footer />
    </footer>

    <!-- ═══════════════════════════════════
         DESKTOP — ELEMENTOS FIJOS
         ═══════════════════════════════════ -->
    <div class="hidden laptop:flex laptop-scaled:flex fixed z-40"
         style="top: var(--fixed-offset); left: var(--fixed-offset);">
      <NameCard nameDisplay={profile.nameDisplay} role={profile.role} />
    </div>

    <div class="hidden laptop:flex laptop-scaled:flex fixed z-40"
         style="top: var(--fixed-offset); right: var(--fixed-offset);">
      <NavBar pages={site.pages} />
    </div>

    <div class="hidden laptop:flex laptop-scaled:flex fixed z-40"
         style="bottom: var(--fixed-offset); left: var(--fixed-offset);">
      <SocialLinks />
    </div>

    <div class="hidden laptop:flex laptop-scaled:flex fixed z-40"
         style="bottom: var(--fixed-offset); right: var(--fixed-offset);">
      <SocialBotPanel />
    </div>

    <!-- Mobile chat FAB — visible only below laptop breakpoint -->
    <button
      class="chat-toggle block laptop:hidden laptop-scaled:hidden fixed z-40 cursor-pointer
             flex items-center gap-1.5 px-3 py-2
             bottom-[3.25rem] mobile:bottom-[5.25rem] right-[0.75rem]
             transition-all duration-200 can-hover:hover:opacity-100"
      style="
        background: color-mix(in srgb, var(--background) 75%, transparent);
        border: 1px solid color-mix(in srgb, var(--border) 65%, transparent);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        opacity: 0.7;
      "
      aria-label="Open AI chat"
    >
      <span
        style="display: inline-block; width: 1.1rem; height: 1.1rem; flex-shrink: 0;
               background-color: var(--foreground);
               -webkit-mask-image: url('/img/bot.png'); mask-image: url('/img/bot.png');
               -webkit-mask-size: contain; mask-size: contain;
               -webkit-mask-repeat: no-repeat; mask-repeat: no-repeat;
               -webkit-mask-position: center; mask-position: center;"
        aria-hidden="true"
      ></span>
      <span style="font-size: 0.42rem; letter-spacing: 0.3em; text-transform: uppercase; opacity: 0.6;">BOT</span>
    </button>

    <ChatWidget />


    <!-- ═══════════════════════════════════
         MAIN
         ═══════════════════════════════════ -->
    <main
      class="main-layout fixed inset-x-0 z-20
             top-[3rem] mobile:top-[4.5rem] tablet:top-[4.5rem]
             bottom-[2.5rem] mobile:bottom-[4.5rem] tablet:bottom-[4.5rem]
             laptop:inset-0 laptop-scaled:inset-0
             flex items-center justify-center"
    >
      <div
        class="w-full h-full relative
               bg-[var(--background)]
               flex items-center justify-center overflow-hidden"
      >
        {
          dual ? (
            <DualMain pageLabel={pageLabel} scrollable={scrollable}>
              <slot />
            </DualMain>
          ) : (
            <div
              class="w-full h-full flex flex-col overflow-y-auto overflow-x-hidden
                   p-[1.25rem] mobile:p-[1.5rem] tablet:p-[2rem]
                   laptop:p-[3.5rem] fhd:p-[5rem] qhd:p-[7rem] uhd:p-[9rem]"
            >
              <slot />
            </div>
          )
        }
      </div>
    </main>
  </body>
</html>
