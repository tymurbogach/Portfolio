---
import "../styles/global.css";
import Header         from "../components/layout/Header.astro";
import Footer         from "../components/layout/Footer.astro";
import NameCard        from "../components/layout/NameCard.astro";
import NavBar          from "../components/layout/NavBar.astro";
import SocialLinks     from "../components/ui/SocialLinks.astro";
import SocialBotPanel  from "../components/layout/SocialBotPanel.astro";
import ChatWidget      from "../components/layout/ChatWidget.astro";
import DualMain        from "../layouts/DualMain.astro";
import { ClientRouter } from "astro:transitions";
import { getSite, getProfile, getContactData } from "../lib/content";
import { THEMES } from "../lib/themes";

// ==========================================
// PROPS
// ==========================================
interface Props {
  title: string;
  dual?: boolean;
  scrollable?: boolean;
  pageLabel?: string;
  description?: string;
  ogImage?: string;
}

// ==========================================
// DATOS
// ==========================================
const site    = await getSite();
const profile = await getProfile();
const contact = await getContactData();

const pathKey = (Astro.url.pathname.replace(/^\/|\/$/g, "") ||
  "home") as keyof typeof site.pageDescriptions;

const defaultDescription = site.pageDescriptions[pathKey] ?? site.description;

const {
  title,
  dual = false,
  scrollable = true,
  pageLabel = "",
  description = defaultDescription,
  ogImage = site.ogImage,
} = Astro.props;

const pageTitle = `${title} — ${site.name}`;
const ogImageUrl = `${site.url}${ogImage}`;

const MARQUEE = site.marquee ?? "";
---

<!doctype html>
<html lang={site.lang} class="theme-void" data-themes={JSON.stringify(THEMES)}>
  <head>
    <meta charset="UTF-8" />

    <!-- Anti-flash: aplica el tema guardado ANTES del primer paint -->
    <script is:inline>
      history.scrollRestoration = "manual";
      (function () {
        var t = localStorage.getItem("theme");
        var valid = JSON.parse(document.documentElement.dataset.themes || "[]");
        var active = (t && valid.indexOf(t) !== -1) ? t : (valid[0] || "theme-void");
        document.documentElement.classList.remove("theme-void");
        document.documentElement.classList.add(active);
        document.addEventListener("DOMContentLoaded", function () {
          var badge = document.querySelector("[data-theme-label]");
          if (badge) badge.textContent = active.replace("theme-", "");
        });
      })();
    </script>

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>

    <!-- SEO -->
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />

    <!-- Open Graph -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:url" content={site.url} />
    <meta property="og:type" content="website" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <ClientRouter />

    <!-- Assets -->
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poiret+One&family=Bebas+Neue&family=JetBrains+Mono:wght@300;400;500;700&display=swap"
      rel="stylesheet"
    />

    <!-- Scripts globales -->
    <script>
      import "../scripts/themeToggle";
      import "../scripts/sectionNav";
      import "../scripts/tapFeedback";
    </script>
  </head>

  <!-- position:fixed en body evita el scroll nativo del documento;
       el scroll real ocurre solo dentro del panel de contenido -->
  <body
    class="bg-[var(--total-background)] text-[var(--letter-color)]"
    style="position:fixed; inset:0;"
  >
    <!-- ═══════════════════════════════════
         MÓVIL — HEADER / FOOTER FIJOS
         ═══════════════════════════════════ -->
    <header class="block laptop:hidden laptop-scaled:hidden fixed top-0 left-0 w-full z-30">
      <Header />
    </header>

    <footer class="block laptop:hidden laptop-scaled:hidden fixed bottom-0 left-0 w-full z-30">
      <Footer />
    </footer>

    <!-- ═══════════════════════════════════
         DESKTOP — ELEMENTOS FIJOS
         ═══════════════════════════════════ -->
    <div class="hidden laptop:flex laptop-scaled:flex fixed z-40"
         style="top: var(--fixed-offset); left: var(--fixed-offset);">
      <NameCard nameDisplay={profile.nameDisplay} role={profile.role} />
    </div>

    <div class="hidden laptop:flex laptop-scaled:flex fixed z-40"
         style="top: var(--fixed-offset); right: var(--fixed-offset);">
      <NavBar pages={site.pages} />
    </div>

    <div class="hidden laptop:flex laptop-scaled:flex fixed z-40"
         style="bottom: var(--fixed-offset); left: var(--fixed-offset);">
      <SocialLinks />
    </div>

    <div class="hidden laptop:flex laptop-scaled:flex fixed z-40"
         style="bottom: var(--fixed-offset); right: var(--fixed-offset);">
      <SocialBotPanel />
    </div>

    <!-- ═══════════════════════════════════
         MARQUEE STRIP — fixed bottom, desktop only
         ═══════════════════════════════════ -->
    <div
      class="hidden laptop:block laptop-scaled:block fixed bottom-0 left-0 right-0 z-[35] overflow-hidden"
      style="background: var(--total-background);"
      aria-hidden="true"
    >
      <div class="h-px" style="background: var(--border-color); opacity: 0.4;" />
      <div class="overflow-hidden py-[0.25rem]">
        <div
          class="marquee-track"
          style="font-size: clamp(0.42rem, 0.38vw, 0.65rem); letter-spacing: 0.45em;
                 text-transform: uppercase; font-weight: bold;
                 opacity: 0.22; font-family: inherit;
                 color: var(--letter-color);"
        >
          <span>{MARQUEE}</span>
          <span>{MARQUEE}</span>
        </div>
      </div>
    </div>

    <!-- Mobile chat FAB — visible only below laptop breakpoint -->
    <button
      class="chat-toggle block laptop:hidden laptop-scaled:hidden fixed z-40 cursor-pointer
             flex items-center gap-1.5 px-3 py-2
             bottom-[3.25rem] mobile:bottom-[5.25rem] right-[0.75rem]
             transition-all duration-200 can-hover:hover:opacity-100"
      style="
        background: color-mix(in srgb, var(--component-background) 75%, transparent);
        border: 1px solid color-mix(in srgb, var(--border-color) 65%, transparent);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        opacity: 0.7;
      "
      aria-label="Open AI chat"
    >
      <span style="color: var(--accent-color); font-family: 'JetBrains Mono', monospace; font-size: 0.8rem; line-height: 1;">&gt;_</span>
      <span style="font-size: 0.42rem; letter-spacing: 0.22em; text-transform: uppercase; opacity: 0.6; font-family: 'JetBrains Mono', monospace;">bot</span>
    </button>

    <ChatWidget />


    <!-- ═══════════════════════════════════
         MAIN
         ═══════════════════════════════════ -->
    <main
      class="main-layout fixed inset-x-0 z-20
             top-[3rem] mobile:top-[4.5rem] tablet:top-[4.5rem]
             bottom-[2.5rem] mobile:bottom-[4.5rem] tablet:bottom-[4.5rem]
             laptop:inset-0 laptop-scaled:inset-0
             flex items-center justify-center"
    >
      <div
        class="w-full h-full
               bg-[var(--page-background)]
               border border-[var(--border-subtle)]
               flex items-center justify-center overflow-hidden"
      >
        {
          dual ? (
            <DualMain pageLabel={pageLabel} scrollable={scrollable}>
              <slot />
            </DualMain>
          ) : (
            <div
              class="w-full h-full flex flex-col overflow-y-auto overflow-x-hidden
                   p-[1.25rem] mobile:p-[1.5rem] tablet:p-[2rem]
                   laptop:p-[3.5rem] fhd:p-[5rem] qhd:p-[7rem] uhd:p-[9rem]"
            >
              <slot />
            </div>
          )
        }
      </div>
    </main>
  </body>
</html>
