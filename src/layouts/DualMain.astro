---
import Sidebar from "../components/layout/Sidebar.astro";
import ContentPanel from "../components/layout/ContentPanel.astro";

/** Two-column grid: Sidebar cell (desktop only) + right content panel.
    >=60rem → var(--sidebar-w) + 1fr; below → single column. */
interface Props {
  /** Optional heading above the content panel */
  pageLabel?: string;
  /** false = center the content instead of making it scrollable */
  scrollable?: boolean;
}

const { pageLabel = "", scrollable = true } = Astro.props;
---

<div
  class="grid grid-cols-1 w-full h-full overflow-hidden
         laptop:grid-cols-[var(--sidebar-w)_minmax(0,1fr)]
         laptop-scaled:grid-cols-[var(--sidebar-w)_minmax(0,1fr)]"
>
  <Sidebar />
  <ContentPanel pageLabel={pageLabel} scrollable={scrollable}>
    <slot />
  </ContentPanel>
</div>
