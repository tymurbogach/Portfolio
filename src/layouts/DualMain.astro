---
import ProfilePanel from "../components/sections/ProfilePanel.astro";

/** Two-column layout: ProfilePanel sidebar (desktop only) + right content panel. */
interface Props {
  /** Optional heading above the content panel */
  pageLabel?: string;
  /** false = center the content instead of making it scrollable */
  scrollable?: boolean;
}

const { pageLabel = "", scrollable = true } = Astro.props;
---

<div class="flex flex-col laptop:flex-row laptop-scaled:flex-row w-full h-full overflow-hidden">
  <!-- Left sidebar (desktop only) -->
  <div
    class="hidden laptop:flex laptop-scaled:flex shrink-0 items-center justify-center
           laptop:p-[var(--frame-inset)] laptop-scaled:p-[var(--frame-inset)]"
    style="width: var(--sidebar-width);"
  >
    <ProfilePanel />
  </div>

  <!-- Right content panel -->
  <div class="flex-1 min-w-0 flex flex-col h-full relative overflow-hidden">
    <!-- Optional section heading -->
    {pageLabel && (
      <div
        class="shrink-0
               px-[1.25rem] mobile:px-[1.75rem] tablet:px-[2.5rem]
               laptop:px-[var(--content-inset)] laptop-scaled:px-[var(--content-inset)]
               pt-[1rem] laptop:pt-[var(--section-gap)] laptop-scaled:pt-[var(--section-gap)]
               pb-4 laptop:pb-7 laptop-scaled:pb-7"
      >
        <h2
          class="text-xs laptop:text-[var(--type-reading)] laptop-scaled:text-[var(--type-reading)]
                 tracking-[0.45em] uppercase font-bold m-0
                 text-[var(--foreground)] text-glow"
        >
          {pageLabel}
        </h2>
        <div class="text-gradient text-glow gradient-line mt-3 laptop:mt-4 laptop-scaled:mt-4" />
      </div>
    )}

    <!-- Scrollable or centered content -->
    {scrollable ? (
      <div
        id="content-scroll"
        class="flex-1 overflow-y-auto overflow-x-hidden
               px-[1.25rem] mobile:px-[1.75rem] tablet:px-[2.5rem]
               laptop:px-[var(--content-inset)] laptop-scaled:px-[var(--content-inset)]
               pb-[4rem] laptop:pb-[var(--content-block-gap)] laptop-scaled:pb-[var(--content-block-gap)]"
      >
        <slot />
      </div>
    ) : (
      <div
        class="flex-1 flex items-center justify-center
                  px-[1.25rem] laptop:px-[var(--content-inset)] laptop-scaled:px-[var(--content-inset)]"
      >
        <slot />
      </div>
    )}

    <!-- Bordes difuminados del panel (3rem arriba, 2rem abajo).
         Antes era un `mask-image` en este mismo contenedor, pero enmascarar al
         ancestro de un scroller obliga al navegador a rasterizar todo el contenido
         en una superficie aparte y volver a aplicarle la máscara en cada frame:
         medido en un móvil real, era la causa del scroll a trompicones. Dos
         degradados estáticos por encima dan el mismo resultado a coste cero —
         se pintan una vez y el scroll vuelve a ser puro compositor.
         Van al final para que pinten sobre el contenido sin depender de z-index. -->
    <div
      class="pointer-events-none absolute inset-x-0 top-0 h-12
             bg-linear-to-b from-[var(--background)] to-transparent"
      aria-hidden="true"
    />
    <div
      class="pointer-events-none absolute inset-x-0 bottom-0 h-8
             bg-linear-to-t from-[var(--background)] to-transparent"
      aria-hidden="true"
    />
  </div>
</div>
