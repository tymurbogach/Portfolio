{
  "extends": "astro/tsconfigs/base",
  "compilerOptions": {
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "src",
    ".astro/types.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "*.config.*"
  ]
}