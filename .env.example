# Ollama endpoint used by /api/chat (see src/lib/chatConfig.ts and compose.yml)
OLLAMA_URL=http://localhost:11434

# Umami analytics for /api/stats (see src/lib/umami.ts and compose.yml).
# Without these, /api/stats answers 503 and the visitor meter stays hidden.
UMAMI_URL=https://analytics.example.com
UMAMI_USERNAME=
UMAMI_PASSWORD=
UMAMI_WEBSITE_ID=
